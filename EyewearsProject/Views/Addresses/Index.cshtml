@model List<Address>

@{
    ViewData["Title"] = "My Addresses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Addresses</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add New Address</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't saved any addresses yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var address in Model)
        {
            <div class="col">
                <div class="card h-100 @(address.IsDefault ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title">@address.Label</h5>
                            @if (address.IsDefault)
                            {
                                <span class="badge bg-primary align-self-start">Default</span>
                            }
                        </div>
                        <p class="mb-1">@address.FullName &middot; @address.Phone</p>
                        <p class="mb-1">@address.AddressLine</p>
                        <p class="mb-0">@address.City, @address.PostalCode, @address.Country</p>
                    </div>
                    <div class="card-footer bg-white d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@address.Id">Edit</a>

                        @if (!address.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@address.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Set as Default</button>
                            </form>
                        }

                        <form asp-action="Delete" asp-route-id="@address.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this address?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}