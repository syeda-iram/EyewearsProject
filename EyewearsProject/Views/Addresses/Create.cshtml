@model Address

@{
    ViewData["Title"] = "Add Address";
}

<h1>Add New Address</h1>

<form asp-action="Create" method="post" style="max-width:600px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Label" class="form-label">Label (e.g. Home, Work)</label>
        <input asp-for="Label" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Recipient Name</label>
        <input asp-for="FullName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Phone</label>
        <input asp-for="Phone" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="AddressLine" class="form-label">Address</label>
        <input asp-for="AddressLine" class="form-control" placeholder="House #, Street, Area" required />
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="PostalCode" class="form-label">Postal Code</label>
            <input asp-for="PostalCode" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Country" class="form-label">Country</label>
            <input asp-for="Country" class="form-control" required />
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsDefault" class="form-check-input" />
        <label asp-for="IsDefault" class="form-check-label">Set as default address</label>
    </div>

    <button type="submit" class="btn btn-primary">Save Address</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>