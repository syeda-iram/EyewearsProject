@using EyewearsProject.Extensions
@model List<Order>

@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't placed any orders yet.
        <a asp-controller="Products" asp-action="Index">Start shopping</a>.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Payment</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                    <td>@order.Items.Count</td>
                    <td>@order.GrandTotal.ToPkr()</td>
                    <td>
                        <span class="badge bg-@(order.OrderStatus switch
                              {
                                  OrderStatus.Delivered => "success",
                                  OrderStatus.Cancelled => "danger",
                                  OrderStatus.Returned => "secondary",
                                  OrderStatus.Shipped => "info",
                                  OrderStatus.Processing => "primary",
                                  _ => "warning"
                              })">
                            @order.OrderStatus
                        </span>
                    </td>
                    <td>@order.PaymentStatus</td>
                    <td class="d-flex gap-1">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">
                            View Details
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Track" asp-route-id="@order.Id">
                            Track
                        </a>
                        <form asp-controller="Orders" asp-action="ReorderAll" method="post">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-sm btn-dark">Order Again</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}