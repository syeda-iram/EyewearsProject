@{
    ViewData["Title"] = ViewBag.CategoryName + " - Coming Soon";
}

<div class="text-center py-5">
    <i class="bi bi-hourglass-split" style="font-size:3.5rem; color:#adb5bd;"></i>

    <h2 class="mt-4 mb-2">@ViewBag.CategoryName — Coming Soon!</h2>

    <p class="text-muted mx-auto" style="max-width:480px;">
        We're working on bringing you a great selection of @(((string)ViewBag.CategoryName).ToLower()).
        Check back soon, or explore our current collection in the meantime.
    </p>

    <a asp-controller="Products" asp-action="Index" class="btn btn-dark mt-3">
        Browse Available Products
    </a>
</div>