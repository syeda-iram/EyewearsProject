@using EyewearsProject.Extensions
@using EyewearsProject.Models
@model EyewearsProject.Models.Product

@{
    ViewData["Title"] = Model.Name;

    var primaryImage = Model.Images.FirstOrDefault(i => i.IsPrimary)
                       ?? Model.Images.FirstOrDefault();
}

<div class="row">

    <!-- PRODUCT IMAGE -->
    <div class="col-md-5">
        <img src="@(primaryImage?.ImageUrl ?? "/images/placeholder.jpg")"
             class="img-fluid rounded shadow-sm"
             alt="@Model.Name">
    </div>

    <!-- PRODUCT INFORMATION -->
    <div class="col-md-7">

        <h1>@Model.Name</h1>

        <p class="text-muted">
            @Model.Brand?.Name &middot; @Model.Category?.Name
        </p>

        <!-- SKU -->
        @if (!string.IsNullOrWhiteSpace(Model.Sku))
        {
            <p class="small text-muted mb-2">
                SKU: @Model.Sku
            </p>
        }

        <!-- SHORT DESCRIPTION -->
        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <p class="lead">
                @Model.ShortDescription
            </p>
        }

        <!-- PRICE -->
        @if (Model.DiscountPrice.HasValue &&
             Model.DiscountPrice.Value < Model.Price)
        {
            <h3>
                <span class="text-decoration-line-through text-muted fs-5">
                    @Model.Price.ToPkr()
                </span>

                <span class="text-danger ms-2">
                    @Model.DiscountPrice.Value.ToPkr()
                </span>
            </h3>
        }
        else
        {
            <h3>@Model.Price.ToPkr()</h3>
        }

        <!-- PRODUCT DETAILS -->
        <div class="mt-4">

            <h5>Product Details</h5>

            <table class="table table-sm">

                @if (!string.IsNullOrWhiteSpace(Model.ProductType))
                {
                    <tr>
                        <th>Product Type</th>
                        <td>@Model.ProductType</td>
                    </tr>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Gender))
                {
                    <tr>
                        <th>Gender</th>
                        <td>@Model.Gender</td>
                    </tr>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Material))
                {
                    <tr>
                        <th>Material</th>
                        <td>@Model.Material</td>
                    </tr>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Shape))
                {
                    <tr>
                        <th>Shape</th>
                        <td>@Model.Shape</td>
                    </tr>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Color))
                {
                    <tr>
                        <th>Color</th>
                        <td>@Model.Color</td>
                    </tr>
                }

                @if (Model.Weight.HasValue)
                {
                    <tr>
                        <th>Weight</th>
                        <td>@Model.Weight.Value g</td>
                    </tr>
                }

            </table>

        </div>

        <!-- FULL DESCRIPTION -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mt-4">

                <h5>Description</h5>

                <p>
                    @Model.Description
                </p>

            </div>
        }

        <!-- PRODUCT TAGS -->
        @if (Model.ProductTags != null && Model.ProductTags.Any())
        {
            <div class="mt-4">

                <h5>Tags</h5>

                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.ProductTags.OrderBy(t => t.Name))
                    {
                        <span class="badge bg-light text-dark border px-3 py-2">
                            @tag.Name
                        </span>
                    }

                </div>

            </div>
        }

        <!-- ADD TO CART -->
        <form asp-controller="Cart"
              asp-action="Add"
              method="post"
              class="mt-4">

            <input type="hidden"
                   name="productId"
                   value="@Model.Id" />

            <!-- VARIANTS -->
            @if (Model.Variants.Any())
            {
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Color / Size
                    </label>

                    <select name="variantId"
                            class="form-select"
                            style="max-width:300px;">

                        @foreach (var variant in Model.Variants)
                        {
                            <option value="@variant.Id"
                                    disabled="@(variant.StockQuantity <= 0)">

                                @variant.Color

                                @(variant.Size != null
                                    ? $" - {variant.Size}"
                                    : "")

                                (@(variant.StockQuantity > 0
                                    ? "In stock"
                                    : "Out of stock"))

                            </option>
                        }

                    </select>

                </div>
            }

            <!-- QUANTITY -->
            <div class="mb-3">

                <label class="form-label fw-bold">
                    Quantity
                </label>

                <input type="number"
                       name="quantity"
                       value="1"
                       min="1"
                       class="form-control"
                       style="max-width:100px;" />

            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg mt-2">
                Add to Cart
            </button>

        </form>

        <!-- LENS CUSTOMIZATION -->
        <div class="mt-2">

            <a class="btn btn-outline-primary btn-lg"
               id="selectLensesBtn"
               href="#">
                Select Lenses
            </a>

        </div>

        <!-- VIRTUAL TRY ON -->
        <div class="mt-2">

            <a class="btn btn-outline-dark btn-lg"
               asp-controller="TryOn"
               asp-action="Index"
               asp-route-productId="@Model.Id">

                Virtual Try-On

            </a>

        </div>

        <!-- WISHLIST -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Wishlist"
                  asp-action="Add"
                  method="post"
                  class="mt-2">

                <input type="hidden"
                       name="productId"
                       value="@Model.Id" />

                <input type="hidden"
                       name="returnUrl"
                       value="@Context.Request.Path" />

                <button type="submit"
                        class="btn btn-outline-danger">

                    &hearts; Add to Wishlist

                </button>

            </form>
        }

        <!-- BACK -->
        <div class="mt-4">

            <a asp-controller="Products"
               asp-action="Index">

                &larr; Back to Shop

            </a>

        </div>

    </div>
</div>


<!-- SPECIFICATIONS -->
@if (Model.Specifications != null && Model.Specifications.Any())
{
    <hr class="my-5" />

    <div class="row">

        <div class="col-md-8">

            <h3>Specifications</h3>

            <table class="table table-bordered">

                <tbody>

                    @foreach (var spec in Model.Specifications
                        .OrderBy(s => s.SortOrder))
                    {
                        <tr>

                            <th style="width:35%;">
                                @spec.Name
                            </th>

                            <td>
                                @spec.Value
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


<!-- REVIEWS -->
<hr class="my-5" />

<div class="row">

    <div class="col-md-8">

        <h3>

            Reviews

            @if (ViewBag.AverageRating != null)
            {
                <span class="text-muted fs-6">
                    (@(((double)ViewBag.AverageRating).ToString("0.0")) / 5 average)
                </span>
            }

        </h3>

        <!-- REVIEW SUBMISSION MESSAGE -->
        @if (TempData["ReviewSubmitted"] != null)
        {
            <div class="alert alert-success">
                @TempData["ReviewSubmitted"]
            </div>
        }

        @{
            var reviews = ViewBag.ApprovedReviews as List<Review>
                          ?? new List<Review>();
        }

        <!-- APPROVED REVIEWS -->
        @if (!reviews.Any())
        {
            <p class="text-muted">
                No reviews yet. Be the first to review this product.
            </p>
        }
        else
        {
            foreach (var review in reviews)
            {
                var filledStars = new string('*', review.Rating);
                var emptyStars = new string('-', 5 - review.Rating);

                <div class="border-bottom pb-3 mb-3">

                    <strong>
                        @review.User.FullName
                    </strong>

                    <span class="text-warning ms-2">
                        @(filledStars)@(emptyStars)
                    </span>

                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mb-0 mt-1">
                            @review.Comment
                        </p>
                    }

                    <small class="text-muted">
                        @review.CreatedAt.ToString("dd MMM yyyy")
                    </small>

                </div>
            }
        }

        <!-- WRITE REVIEW -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (ViewBag.UserAlreadyReviewed == true)
            {
                <p class="text-muted mt-4">
                    You've already reviewed this product.
                </p>
            }
            else
            {
                <h5 class="mt-4">
                    Write a Review
                </h5>

                <form asp-controller="Products"
                      asp-action="SubmitReview"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <!-- RATING -->
                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Rating
                        </label>

                        <select name="rating"
                                class="form-select"
                                style="max-width:150px;"
                                required>

                            <option value="5">
                                5 - Excellent
                            </option>

                            <option value="4">
                                4 - Good
                            </option>

                            <option value="3">
                                3 - Average
                            </option>

                            <option value="2">
                                2 - Poor
                            </option>

                            <option value="1">
                                1 - Terrible
                            </option>

                        </select>

                    </div>

                    <!-- COMMENT -->
                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Comment
                        </label>

                        <textarea name="comment"
                                  class="form-control"
                                  rows="3"
                                  maxlength="1000"></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">

                        Submit Review

                    </button>

                </form>
            }
        }
        else
        {
            <p class="text-muted mt-4">

                <a asp-controller="Account"
                   asp-action="Login">
                    Log in
                </a>

                to leave a review.

            </p>
        }

    </div>

</div>


@section Scripts {

    <script>

        const selectLensesBtn =
            document.getElementById('selectLensesBtn');

        if (selectLensesBtn) {

            selectLensesBtn.addEventListener('click', function (e) {

                e.preventDefault();

                const variantSelect =
                    document.querySelector('select[name="variantId"]');

                const variantId =
                    variantSelect
                        ? variantSelect.value
                        : '@(Model.Variants.FirstOrDefault()?.Id ?? 0)';

                window.location.href =
                    '@Url.Action("Customize", "Lens")' +
                    '?productId=@Model.Id&variantId=' +
                    variantId;

            });

        }

    </script>

}