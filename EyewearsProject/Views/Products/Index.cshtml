@using EyewearsProject.Extensions
@model IEnumerable<EyewearsProject.Models.Product>

@{
    ViewData["Title"] = "Shop";
}

<h1 class="mb-4">Shop Eyewear</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary) ?? product.Images.FirstOrDefault();

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(primaryImage?.ImageUrl ?? "/images/placeholder.jpg")"
                     class="card-img-top" alt="@product.Name" style="height:220px; object-fit:cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="text-muted mb-1">@product.Brand.Name &middot; @product.Category.Name</p>

                    <div class="mt-auto">
                        @if (product.DiscountPrice.HasValue)
                        {
                            <p class="mb-2">
                                <span class="text-decoration-line-through text-muted">@product.Price.ToPkr()</span>
                                <span class="fw-bold text-danger ms-2">@product.DiscountPrice.Value.ToPkr()</span>
                            </p>
                        }
                        else
                        {
                            <p class="fw-bold mb-2">@product.Price.ToPkr()</p>
                        }

                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                           class="btn btn-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No products available right now.</p>
}