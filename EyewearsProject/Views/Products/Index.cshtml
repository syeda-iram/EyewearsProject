@using EyewearsProject.Extensions
@using EyewearsProject.Models
@model IEnumerable<EyewearsProject.Models.Product>

@{
    ViewData["Title"] = "Shop";

    var brands = ViewBag.AllBrands as List<Brand> ?? new List<Brand>();
    var colors = ViewBag.AllColors as List<string> ?? new List<string>();
    var productTypes = ViewBag.AllProductTypes as List<string> ?? new List<string>();
    var genders = ViewBag.AllGenders as List<string> ?? new List<string>();
    var materials = ViewBag.AllMaterials as List<string> ?? new List<string>();
    var shapes = ViewBag.AllShapes as List<string> ?? new List<string>();
    var specs = ViewBag.AllSpecs;
}

<h1 class="mb-4">Shop Eyewear</h1>

<div class="row">

    <!-- FILTERS -->
    <div class="col-md-3">

        <div class="filter-panel">

            <h6 class="filter-title">Filters</h6>

            <form asp-controller="Products"
                  asp-action="Index"
                  method="get">

                <!-- Preserve Category -->
                @if (!string.IsNullOrEmpty((string)ViewBag.SelectedCategory))
                {
                    <input type="hidden"
                           name="category"
                           value="@ViewBag.SelectedCategory" />
                }

                <!-- BRAND -->
                <div class="filter-group mb-3">

                    <label class="filter-label">
                        Brand
                    </label>

                    <select name="brandId"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="">
                            All Brands
                        </option>

                        @foreach (var brand in brands)
                        {
                            <option value="@brand.Id"
                                    selected="@(ViewBag.SelectedBrandId == brand.Id ? "selected" : null)">
                                @brand.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- PRODUCT TYPE -->
                @if (productTypes.Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Product Type
                        </label>

                        <select name="productType"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Types
                            </option>

                            @foreach (var type in productTypes)
                            {
                                <option value="@type"
                                        selected="@(((string)ViewBag.SelectedProductType) == type ? "selected" : null)">
                                    @type
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- GENDER -->
                @if (genders.Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Gender
                        </label>

                        <select name="gender"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All
                            </option>

                            @foreach (var gender in genders)
                            {
                                <option value="@gender"
                                        selected="@(((string)ViewBag.SelectedGender) == gender ? "selected" : null)">
                                    @gender
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- COLOR -->
                @if (colors.Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Color
                        </label>

                        <select name="color"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Colors
                            </option>

                            @foreach (var color in colors)
                            {
                                <option value="@color"
                                        selected="@(((string)ViewBag.SelectedColor) == color ? "selected" : null)">
                                    @color
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- MATERIAL -->
                @if (materials.Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Material
                        </label>

                        <select name="material"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Materials
                            </option>

                            @foreach (var material in materials)
                            {
                                <option value="@material"
                                        selected="@(((string)ViewBag.SelectedMaterial) == material ? "selected" : null)">
                                    @material
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- SHAPE -->
                @if (shapes.Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Shape
                        </label>

                        <select name="shape"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Shapes
                            </option>

                            @foreach (var shape in shapes)
                            {
                                <option value="@shape"
                                        selected="@(((string)ViewBag.SelectedShape) == shape ? "selected" : null)">
                                    @shape
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- PRICE -->
                <div class="filter-group mb-3">

                    <label class="filter-label">
                        Price Range (Rs)
                    </label>

                    <div class="d-flex gap-2">

                        <input type="number"
                               name="minPrice"
                               placeholder="Min"
                               class="form-control form-control-sm"
                               value="@ViewBag.SelectedMinPrice" />

                        <input type="number"
                               name="maxPrice"
                               placeholder="Max"
                               class="form-control form-control-sm"
                               value="@ViewBag.SelectedMaxPrice" />

                    </div>

                </div>


                <!-- SPECIFICATIONS -->
                @if (specs != null &&
                     ((IEnumerable<dynamic>)specs).Any())
                {
                    <div class="filter-group mb-3">

                        <label class="filter-label">
                            Specifications
                        </label>

                        <select name="spec"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                Any
                            </option>

                            @foreach (var spec in specs)
                            {
                                string value =
                                    spec.Name + ":" + spec.Value;

                                <option value="@value"
                                        selected="@(((string)ViewBag.SelectedSpec) == value ? "selected" : null)">
                                    @spec.Name: @spec.Value
                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- APPLY -->
                <button type="submit"
                        class="btn btn-primary btn-sm w-100 mt-2">

                    Apply Filters

                </button>


                <!-- CLEAR -->
                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-category="@ViewBag.SelectedCategory"
                   class="btn btn-outline-secondary btn-sm w-100 mt-2">

                    Clear Filters

                </a>

            </form>

        </div>

    </div>


    <!-- PRODUCTS -->
    <div class="col-md-9">

        <!-- CATEGORY -->
        @if (!string.IsNullOrEmpty((string)ViewBag.SelectedCategory))
        {
            <p class="text-muted">

                Showing:
                <strong>
                    @ViewBag.SelectedCategory
                </strong>

            </p>
        }


        <!-- PRODUCT GRID -->
        <div class="row row-cols-1 row-cols-md-3 g-4">

            @foreach (var product in Model)
            {
                var primaryImage =
                    product.Images.FirstOrDefault(i => i.IsPrimary)
                    ?? product.Images.FirstOrDefault();

                <div class="col">

                    <div class="card h-100 shadow-sm">

                        <!-- IMAGE -->
                        <div class="position-relative">

                            <img src="@(primaryImage?.ImageUrl ?? "/images/placeholder.jpg")"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height:220px; object-fit:cover;" />


                            <!-- FEATURED -->
                            @if (product.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                    Featured
                                </span>
                            }


                            <!-- SALE -->
                            @if (product.DiscountPrice.HasValue &&
                                 product.DiscountPrice.Value < product.Price)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                    Sale
                                </span>
                            }

                        </div>


                        <!-- DETAILS -->
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @product.Name
                            </h5>


                            <!-- BRAND + CATEGORY -->
                            <p class="text-muted mb-1">

                                @product.Brand?.Name
                                &middot;
                                @product.Category?.Name

                            </p>


                            <!-- SHORT DESCRIPTION -->
                            @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                            {
                                <p class="small text-muted mb-2">
                                    @product.ShortDescription
                                </p>
                            }


                            <!-- PRODUCT TYPE -->
                            @if (!string.IsNullOrWhiteSpace(product.ProductType))
                            {
                                <span class="badge bg-light text-dark border me-1 mb-2">
                                    @product.ProductType
                                </span>
                            }


                            <!-- GENDER -->
                            @if (!string.IsNullOrWhiteSpace(product.Gender))
                            {
                                <span class="badge bg-light text-dark border me-1 mb-2">
                                    @product.Gender
                                </span>
                            }


                            <!-- TAGS -->
                            @if (product.ProductTags != null &&
                                 product.ProductTags.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">

                                    @foreach (var tag in product.ProductTags
                                        .OrderBy(t => t.Name)
                                        .Take(3))
                                    {
                                        <span class="badge bg-secondary">
                                            @tag.Name
                                        </span>
                                    }

                                </div>
                            }


                            <div class="mt-auto">

                                <!-- PRICE -->
                                @if (product.DiscountPrice.HasValue &&
                                     product.DiscountPrice.Value < product.Price)
                                {
                                    <p class="mb-2">

                                        <span class="text-decoration-line-through text-muted">
                                            @product.Price.ToPkr()
                                        </span>

                                        <span class="fw-bold text-danger ms-2">
                                            @product.DiscountPrice.Value.ToPkr()
                                        </span>

                                    </p>
                                }
                                else
                                {
                                    <p class="fw-bold mb-2">
                                        @product.Price.ToPkr()
                                    </p>
                                }


                                <!-- VIEW DETAILS -->
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-primary w-100">

                                    View Details

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- EMPTY STATE -->
        @if (!Model.Any())
        {
            <div class="alert alert-light border mt-4">

                <p class="text-muted mb-0">
                    No products match these filters.
                </p>

            </div>
        }

    </div>

</div>