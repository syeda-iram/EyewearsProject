@using EyewearsProject.Extensions
@using EyewearsProject.Models
@model IEnumerable<EyewearsProject.Models.Product>

@{
    ViewData["Title"] = "Shop";

    var brands = ViewBag.AllBrands as List<Brand> ?? new List<Brand>();
    var colors = ViewBag.AllColors as List<string> ?? new List<string>();
    var subCategories = ViewBag.AllSubCategories as List<Category> ?? new List<Category>();
    var genders = ViewBag.AllGenders as List<string> ?? new List<string>();
    var materials = ViewBag.AllMaterials as List<string> ?? new List<string>();
    var shapes = ViewBag.AllShapes as List<string> ?? new List<string>();
    var specs = ViewBag.AllSpecs;
}

<style>

    /* =========================================================
       SHOP PAGE
    ========================================================= */

    .shop-title {
        color: #071b49;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 22px;
    }


    /* =========================================================
       FILTER PANEL
    ========================================================= */

    .filter-panel {
        background: #ffffff;
        border: 1px solid #dfe5ee;
        border-radius: 20px;
        padding: 20px 17px;
        box-shadow: 0 4px 15px rgba(20, 40, 80, 0.06);
    }

    .filter-title {
        color: #071b49;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .filter-group {
        margin-bottom: 18px !important;
    }

    .filter-label {
        display: block;
        color: #4d6288;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .filter-panel .form-select,
    .filter-panel .form-control {
        border-color: #d7dfeb;
        border-radius: 10px;
        font-size: 13px;
        color: #263b61;
    }

    .filter-panel .form-select:focus,
    .filter-panel .form-control:focus {
        border-color: #172c5f;
        box-shadow: 0 0 0 0.15rem rgba(23, 44, 95, 0.10);
    }


    /* =========================================================
       PRODUCTS HEADER
    ========================================================= */

    .products-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .products-count {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .products-count strong {
        color: #071b49;
    }


    /* =========================================================
       PRODUCT GRID
    ========================================================= */

    .products-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }


    /* =========================================================
       PRODUCT CARD
    ========================================================= */

    .product-card {
        background: #ffffff;
        border: 1px solid #dce3ed;
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease;
        height: auto;
    }

    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 9px 22px rgba(20, 40, 80, 0.10);
    }


    /* =========================================================
       PRODUCT IMAGE
    ========================================================= */

    .product-image-wrapper {
        position: relative;
        height: 175px;
        margin: 12px 12px 0;
        border-radius: 16px;
        overflow: hidden;
        background: #f8f6ef;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }


    /* =========================================================
       FEATURED / SALE BADGES
    ========================================================= */

    .featured-badge {
        position: absolute;
        top: 9px;
        left: 9px;
        background: #ffffff;
        color: #172c5f;
        border: 1px solid #d8dfeb;
        border-radius: 20px;
        padding: 4px 8px;
        font-size: 10px;
        font-weight: 600;
    }

    .sale-badge {
        position: absolute;
        top: 9px;
        right: 9px;
        background: #ffffff;
        color: #d93025;
        border: 1px solid #f0d1cf;
        border-radius: 20px;
        padding: 4px 8px;
        font-size: 10px;
        font-weight: 600;
    }


    /* =========================================================
       WISHLIST BUTTON
    ========================================================= */

    .wishlist-btn {
        position: absolute;
        top: 8px;
        right: 8px;

        width: 32px;
        height: 32px;

        border: none;
        border-radius: 50%;

        background: rgba(255, 255, 255, 0.95);

        color: #172c5f;
        font-size: 20px;
        line-height: 1;

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;

        transition: transform 0.15s ease,
                    background 0.15s ease;
    }

    .wishlist-btn:hover {
        background: #ffffff;
        transform: scale(1.06);
    }


    /* =========================================================
       PRODUCT INFORMATION
    ========================================================= */

    .product-info {
        padding: 11px 13px 14px;
    }

    .product-brand {
        color: #6b7c9d;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.3px;

        margin-bottom: 3px;
    }

    .product-name {
        display: block;

        color: #071b49;
        font-size: 15px;
        font-weight: 600;

        text-decoration: none;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;

        margin-bottom: 5px;
    }

    .product-name:hover {
        color: #172c5f;
    }


    /* =========================================================
       CATEGORY
    ========================================================= */

    .product-category {
        color: #7a879d;
        font-size: 11px;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;

        margin-bottom: 6px;
    }


    /* =========================================================
       GENDER
    ========================================================= */

    .product-gender {
        display: inline-block;

        background: #f7f8fa;
        border: 1px solid #e1e6ee;
        border-radius: 12px;

        color: #5c6c87;

        font-size: 10px;
        padding: 3px 7px;

        margin-bottom: 6px;
    }


    /* =========================================================
       TAGS
    ========================================================= */

    .product-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;

        margin-bottom: 7px;
    }

    .product-tag {
        background: #f5f7fa;
        color: #61718c;

        border: 1px solid #e0e5ec;
        border-radius: 10px;

        font-size: 9px;
        padding: 3px 6px;
    }


    /* =========================================================
       PRICE
    ========================================================= */

    .product-price-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;

        margin-top: 5px;
    }

    .product-current-price {
        color: #071b49;
        font-size: 17px;
        font-weight: 700;
    }

    .product-old-price {
        color: #7d8797;
        font-size: 10px;
        text-decoration: line-through;
    }

    .product-discount {
        color: #e53935;
        font-size: 10px;
        font-weight: 600;
    }


    /* =========================================================
       VIEW DETAILS
    ========================================================= */

    .product-details-btn {
        width: 100%;

        border: 1px solid #172c5f;
        border-radius: 9px;

        background: #172c5f;
        color: #ffffff;

        font-size: 12px;
        font-weight: 600;

        padding: 7px 10px;

        margin-top: 10px;

        text-decoration: none;
        display: block;
        text-align: center;

        transition: background 0.2s ease;
    }

    .product-details-btn:hover {
        background: #071b49;
        color: #ffffff;
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .empty-products {
        border: 1px solid #dfe5ee;
        border-radius: 16px;
        padding: 35px;
        text-align: center;
        color: #6b778c;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1100px) {

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

    @@media (max-width: 767px) {

        .shop-title {
            font-size: 27px;
        }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .product-image-wrapper {
            height: 150px;
            margin: 9px 9px 0;
        }

        .product-info {
            padding: 9px 10px 11px;
        }

        .product-current-price {
            font-size: 15px;
        }

        .product-name {
            font-size: 13px;
        }

        .product-details-btn {
            font-size: 11px;
        }

    }

    @@media (max-width: 480px) {

        .products-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


<h1 class="shop-title">
    All Frames
</h1>


<div class="row">

    <!-- =========================================================
         FILTERS
    ========================================================= -->

    <div class="col-md-3 mb-4">

        <div class="filter-panel">

            <h6 class="filter-title">
                Filters
            </h6>

            <form asp-controller="Products"
                  asp-action="Index"
                  method="get">


                <!-- Preserve Category -->

                @if (!string.IsNullOrEmpty((string)ViewBag.SelectedCategory))
                {
                    <input type="hidden"
                           name="category"
                           value="@ViewBag.SelectedCategory" />
                }


                <!-- =================================================
                     SUBCATEGORY
                ================================================= -->

                @if (subCategories.Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Subcategory
                        </label>

                        <select name="subCategoryId"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Subcategories
                            </option>

                            @foreach (var subCategory in subCategories)
                            {
                                <option value="@subCategory.Id"
                                        selected="@(ViewBag.SelectedSubCategoryId == subCategory.Id ? "selected" : null)">

                                    @subCategory.Name

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     BRAND
                ================================================= -->

                <div class="filter-group">

                    <label class="filter-label">
                        Brand
                    </label>

                    <select name="brandId"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="">
                            All Brands
                        </option>

                        @foreach (var brand in brands)
                        {
                            <option value="@brand.Id"
                                    selected="@(ViewBag.SelectedBrandId == brand.Id ? "selected" : null)">

                                @brand.Name

                            </option>
                        }

                    </select>

                </div>


                <!-- =================================================
                     GENDER
                ================================================= -->

                @if (genders.Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Gender
                        </label>

                        <select name="gender"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All
                            </option>

                            @foreach (var gender in genders)
                            {
                                <option value="@gender"
                                        selected="@(((string)ViewBag.SelectedGender) == gender ? "selected" : null)">

                                    @gender

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     COLOR
                ================================================= -->

                @if (colors.Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Color
                        </label>

                        <select name="color"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Colors
                            </option>

                            @foreach (var color in colors)
                            {
                                <option value="@color"
                                        selected="@(((string)ViewBag.SelectedColor) == color ? "selected" : null)">

                                    @color

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     MATERIAL
                ================================================= -->

                @if (materials.Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Material
                        </label>

                        <select name="material"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Materials
                            </option>

                            @foreach (var material in materials)
                            {
                                <option value="@material"
                                        selected="@(((string)ViewBag.SelectedMaterial) == material ? "selected" : null)">

                                    @material

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     SHAPE
                ================================================= -->

                @if (shapes.Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Shape
                        </label>

                        <select name="shape"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                All Shapes
                            </option>

                            @foreach (var shape in shapes)
                            {
                                <option value="@shape"
                                        selected="@(((string)ViewBag.SelectedShape) == shape ? "selected" : null)">

                                    @shape

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     PRICE
                ================================================= -->

                <div class="filter-group">

                    <label class="filter-label">
                        Price Range (Rs)
                    </label>

                    <div class="d-flex gap-2">

                        <input type="number"
                               name="minPrice"
                               placeholder="Min"
                               class="form-control form-control-sm"
                               value="@ViewBag.SelectedMinPrice" />

                        <input type="number"
                               name="maxPrice"
                               placeholder="Max"
                               class="form-control form-control-sm"
                               value="@ViewBag.SelectedMaxPrice" />

                    </div>

                </div>


                <!-- =================================================
                     SPECIFICATIONS
                ================================================= -->

                @if (specs != null &&
                     ((IEnumerable<dynamic>)specs).Any())
                {
                    <div class="filter-group">

                        <label class="filter-label">
                            Specifications
                        </label>

                        <select name="spec"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="">
                                Any
                            </option>

                            @foreach (var spec in specs)
                            {
                                string value =
                                    spec.Name + ":" + spec.Value;

                                <option value="@value"
                                        selected="@(((string)ViewBag.SelectedSpec) == value ? "selected" : null)">

                                    @spec.Name: @spec.Value

                                </option>
                            }

                        </select>

                    </div>
                }


                <!-- =================================================
                     APPLY
                ================================================= -->

                <button type="submit"
                        class="btn btn-primary btn-sm w-100 mt-2">

                    Apply Filters

                </button>


                <!-- =================================================
                     CLEAR
                ================================================= -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-category="@ViewBag.SelectedCategory"
                   class="btn btn-outline-secondary btn-sm w-100 mt-2">

                    Clear Filters

                </a>

            </form>

        </div>

    </div>


    <!-- =========================================================
         PRODUCTS
    ========================================================= -->

    <div class="col-md-9">


        <!-- CATEGORY -->

        @if (!string.IsNullOrEmpty((string)ViewBag.SelectedCategory))
        {
            <div class="mb-3">

                <span class="products-count">

                    Showing:
                    <strong>
                        @ViewBag.SelectedCategory
                    </strong>

                </span>

            </div>
        }


        <!-- PRODUCT COUNT -->

        <div class="products-header">

            <p class="products-count">

                <strong>@Model.Count()</strong>
                @(Model.Count() == 1 ? "frame" : "frames")

            </p>

        </div>


        <!-- =====================================================
             PRODUCT GRID
        ===================================================== -->

        @if (Model.Any())
        {
            <div class="products-grid">

                @foreach (var product in Model)
                {
                    var primaryImage =
                        product.Images.FirstOrDefault(i => i.IsPrimary)
                        ?? product.Images.FirstOrDefault();


                    <div class="product-card">


                        <!-- =========================================
                             IMAGE
                        ========================================== -->

                        <div class="product-image-wrapper">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id">

                                <img src="@(primaryImage?.ImageUrl ?? "/images/placeholder.jpg")"
                                     class="product-image"
                                     alt="@product.Name" />

                            </a>


                            <!-- FEATURED -->

                            @if (product.IsFeatured)
                            {
                                <span class="featured-badge">
                                    Featured
                                </span>
                            }


                            <!-- SALE -->

                            @if (product.DiscountPrice.HasValue &&
                                 product.DiscountPrice.Value < product.Price)
                            {
                                <span class="sale-badge">
                                    Sale
                                </span>
                            }


                            <!-- WISHLIST -->

                            <button type="button"
                                    class="wishlist-btn"
                                    title="Add to wishlist">

                                ♡

                            </button>

                        </div>


                        <!-- =========================================
                             PRODUCT INFO
                        ========================================== -->

                        <div class="product-info">


                            <!-- BRAND -->

                            <div class="product-brand">

                                @(product.Brand?.Name ?? "Unbranded")

                            </div>


                            <!-- PRODUCT NAME -->

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-name">

                                @product.Name

                            </a>


                            <!-- CATEGORY -->

                            <div class="product-category">

                                @product.Category?.Name

                                @if (product.SubCategory != null)
                                {
                                    <span>
                                        · @product.SubCategory.Name
                                    </span>
                                }

                            </div>


                            <!-- GENDER -->

                            @if (!string.IsNullOrWhiteSpace(product.Gender))
                            {
                                <span class="product-gender">

                                    @product.Gender

                                </span>
                            }


                        

                            <!-- =====================================
                                 PRICE
                            ====================================== -->

                            <div class="product-price-row">

                                @if (product.DiscountPrice.HasValue &&
                                     product.DiscountPrice.Value < product.Price)
                                {
                                    var discountPercentage = (int)Math.Round(
                                        ((product.Price - product.DiscountPrice.Value)
                                        / product.Price) * 100
                                    );

                                    <span class="product-current-price">
                                        @product.DiscountPrice.Value.ToPkr()
                                    </span>

                                    <span class="product-old-price">
                                        @product.Price.ToPkr()
                                    </span>

                                    <span class="product-discount">
                                        @discountPercentage% off
                                    </span>
                                }
                                else
                                {
                                    <span class="product-current-price">
                                        @product.Price.ToPkr()
                                    </span>
                                }

                            </div>


                            <!-- =====================================
                                 DETAILS BUTTON
                            ====================================== -->

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-details-btn">

                                View Details

                            </a>

                        </div>

                    </div>

                }

            </div>
        }


        <!-- =====================================================
             EMPTY STATE
        ===================================================== -->

        else
        {
            <div class="empty-products">

                <p class="mb-2">
                    No products match these filters.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-category="@ViewBag.SelectedCategory"
                   class="btn btn-outline-primary btn-sm">

                    Clear Filters

                </a>

            </div>
        }

    </div>

</div>