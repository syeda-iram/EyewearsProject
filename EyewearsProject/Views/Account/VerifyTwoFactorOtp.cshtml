@model EyewearsProject.ViewModels.VerifyTwoFactorOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-sm">

                <div class="card-body p-4 text-center">

                    <h2 class="mb-3">
                        Verify OTP
                    </h2>

                    @if (Model.Method == "Email")
                    {
                        <p class="text-muted">
                            We sent a 6-digit verification code to your
                            email address.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            We sent a 6-digit verification code to your
                            phone number.
                        </p>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger text-start mb-3">
                    </div>

                    <form asp-controller="Account"
                          asp-action="VerifyTwoFactorOtp"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Method" />

                        <div class="mb-3">

                            <label asp-for="Otp"
                                   class="form-label fw-semibold">
                                Enter OTP
                            </label>

                            <input asp-for="Otp"
                                   class="form-control text-center"
                                   style="
                            font-size:24px;
                            letter-spacing:8px;
                            max-width:250px;
                            margin:auto;"
                                   maxlength="6"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   autofocus />

                            <span asp-validation-for="Otp"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- TIMER -->
                        <div class="mb-3">

                            <span class="text-muted">
                                Code expires in
                            </span>

                            <strong id="otpTimer">
                                05:00
                            </strong>

                        </div>

                        <button type="submit"
                                id="verifyButton"
                                class="btn btn-dark w-100">
                            Verify OTP
                        </button>

                    </form>

                    <div class="mt-3">

                        <a asp-controller="Account"
                           asp-action="TwoFactorAuthentication">
                            Request a new OTP
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
    ```

</div>

@section Scripts {

    ```
    <partial name="_ValidationScriptsPartial" />

    <script>

        let remainingSeconds = @Model.RemainingSeconds;

        const timerElement =
            document.getElementById("otpTimer");

        const verifyButton =
            document.getElementById("verifyButton");

        function updateTimer() {

            if (remainingSeconds <= 0) {

                timerElement.textContent = "Expired";

                verifyButton.disabled = true;

                return;
            }

            const minutes =
                Math.floor(remainingSeconds / 60);

            const seconds =
                remainingSeconds % 60;

            timerElement.textContent =
                String(minutes).padStart(2, "0") +
                ":" +
                String(seconds).padStart(2, "0");

            remainingSeconds--;
        }

        updateTimer();

        const timer =
            setInterval(function() {

                updateTimer();

                if (remainingSeconds <= 0) {
                    clearInterval(timer);
                }

            }, 1000);

    </script>

}