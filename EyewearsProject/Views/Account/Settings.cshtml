@using EyewearsProject.Models
@model ApplicationUser

@{
    ViewData["Title"] = "Account Settings";
}

<style>
    /* =========================================================
           ACCOUNT SETTINGS PAGE
           ========================================================= */

    .settings-page {
        background: #f8fafc;
        min-height: calc(100vh - 180px);
        padding: 42px 0 70px;
    }

    .settings-container {
        width: 100%;
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 24px;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .settings-header {
        margin-bottom: 30px;
    }

        .settings-header h1 {
            margin: 0 0 8px;
            color: #14213D;
            font-size: 34px;
            font-weight: 700;
            letter-spacing: -0.6px;
        }

        .settings-header p {
            margin: 0;
            color: #667085;
            font-size: 15px;
            line-height: 1.5;
        }


    /* =========================================================
           MAIN CONTENT
           ========================================================= */

    .settings-content {
        width: 100%;
    }


    /* =========================================================
           SECTION HEADING
           ========================================================= */

    .content-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 14px;
        margin-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .content-heading-icon {
        width: 22px;
        height: 22px;
        color: #14213D;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .content-heading-icon svg {
            width: 21px;
            height: 21px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .content-heading h2 {
        margin: 0;
        color: #14213D;
        font-size: 21px;
        font-weight: 650;
    }


    /* =========================================================
           SETTINGS CARD
           ========================================================= */

    .settings-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e9ef;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(20, 33, 61, 0.055);
        padding: 26px;
        margin-bottom: 18px;
    }

    .settings-card-title {
        margin: 0 0 6px;
        color: #14213D;
        font-size: 17px;
        font-weight: 650;
    }

    .settings-card-description {
        margin: 0 0 20px;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.55;
    }


    /* =========================================================
           PROFILE
           ========================================================= */

    .profile-intro {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .profile-avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: #f1f3f6;
        border: 1px solid #dfe3e8;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #14213D;
        font-size: 25px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .profile-intro-text {
        flex: 1;
        min-width: 0;
    }

        .profile-intro-text p {
            margin: 0 0 13px;
            color: #596579;
            font-size: 14px;
            line-height: 1.55;
            max-width: 650px;
        }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .settings-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 39px;
        padding: 8px 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .settings-btn-primary {
        background: #14213D;
        color: #ffffff;
        border: 1px solid #14213D;
    }

        .settings-btn-primary:hover {
            background: #1d2e52;
            border-color: #1d2e52;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .settings-btn-outline {
        background: #ffffff;
        color: #14213D;
        border: 1px solid #d9dee7;
    }

        .settings-btn-outline:hover {
            background: #f7f8fa;
            color: #14213D;
            border-color: #bfc6d1;
        }

    .settings-btn-danger {
        background: #ffffff;
        color: #b3413a;
        border: 1px solid #e2b4b0;
    }

        .settings-btn-danger:hover {
            background: #fff5f4;
            color: #a03832;
            border-color: #d99a95;
        }


    /* =========================================================
           PROFILE INFO GRID
           ========================================================= */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .info-field {
        border: 1px solid #e4e7ec;
        border-radius: 9px;
        padding: 13px 14px;
        background: #ffffff;
    }

    .info-label {
        display: block;
        margin-bottom: 5px;
        color: #7a8494;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .info-value {
        color: #26334a;
        font-size: 14px;
        word-break: break-word;
    }


    /* =========================================================
           SETTING ROW
           ========================================================= */

    .setting-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 17px 0;
        border-top: 1px solid #edf0f3;
    }

        .setting-row:first-of-type {
            border-top: 0;
            padding-top: 0;
        }

        .setting-row:last-of-type {
            padding-bottom: 0;
        }

    .setting-row-content {
        min-width: 0;
        flex: 1;
    }

    .setting-row-title {
        margin-bottom: 4px;
        color: #26334a;
        font-size: 14px;
        font-weight: 650;
    }

    .setting-row-text {
        color: #737d8c;
        font-size: 13px;
        line-height: 1.45;
    }


    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        margin-bottom: 7px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 650;
    }

    .status-enabled {
        color: #286747;
        background: #eaf6ef;
    }

    .status-disabled {
        color: #667085;
        background: #f1f3f5;
    }


    /* =========================================================
           LOGOUT
           ========================================================= */

    .logout-card {
        background: #fafbfc;
    }


    /* =========================================================
           DANGER ZONE
           ========================================================= */

    .danger-card {
        border-color: #ead0cd;
        background: #fffdfd;
    }

        .danger-card .settings-card-title {
            color: #b3413a;
        }

        .danger-card .settings-card-description {
            margin-bottom: 17px;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 700px) {

        .settings-page {
            padding: 30px 0 50px;
        }

        .settings-container {
            padding: 0 18px;
        }

        .settings-header h1 {
            font-size: 29px;
        }

        .settings-card {
            padding: 20px;
        }

        .profile-intro {
            align-items: flex-start;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .setting-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 13px;
        }

            .setting-row .settings-btn {
                width: auto;
            }
    }


    @@media (max-width: 480px) {

        .settings-container {
            padding: 0 14px;
        }

        .settings-header h1 {
            font-size: 26px;
        }

        .settings-card {
            padding: 18px;
            border-radius: 12px;
        }

        .profile-intro {
            gap: 14px;
        }

        .profile-avatar {
            width: 62px;
            height: 62px;
            font-size: 21px;
        }

        .profile-intro-text p {
            font-size: 13px;
        }

        .settings-btn {
            width: 100%;
        }

        .setting-row .settings-btn {
            width: 100%;
        }
    }
</style>


<div class="settings-page">

    <div class="settings-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="settings-header">

            <h1>
                Account Settings
            </h1>

            <p>
                Manage your personal information, security preferences,
                and account details.
            </p>

        </div>


        <main class="settings-content">


            <!-- =================================================
                 PROFILE INFORMATION
                 ================================================= -->

            <div class="content-heading">

                <span class="content-heading-icon">

                    <svg viewBox="0 0 24 24">

                        <circle cx="12"
                                cy="8"
                                r="3">
                        </circle>

                        <path d="M5 20c.8-3.3 3.1-5 7-5s6.2 1.7 7 5">
                        </path>

                    </svg>

                </span>

                <h2>
                    Profile Information
                </h2>

            </div>


            <div class="settings-card">

                <div class="profile-intro">

                    <div class="profile-avatar">

                        @(
                            string.IsNullOrWhiteSpace(Model?.UserName)
                                ? "E"
                                : Model.UserName.Substring(0, 1).ToUpper()
                        )

                    </div>


                    <div class="profile-intro-text">

                        <p>
                            Keep your personal information up to date
                            to make your EyeCraft experience easier.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="settings-btn settings-btn-primary">

                            Manage Profile

                        </a>

                    </div>

                </div>


                <div class="info-grid">

                    <!-- USERNAME -->

                    <div class="info-field">

                        <span class="info-label">
                            Username
                        </span>

                        <div class="info-value">
                            @(Model?.UserName ?? "Not provided")
                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="info-field">

                        <span class="info-label">
                            Email Address
                        </span>

                        <div class="info-value">
                            @(Model?.Email ?? "Not provided")
                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 SECURITY
                 ================================================= -->

            <div class="settings-card">

                <h3 class="settings-card-title">
                    Security
                </h3>

                <p class="settings-card-description">
                    Protect your EyeCraft account and manage your
                    sign-in security.
                </p>


                <!-- PASSWORD -->

                <div class="setting-row">

                    <div class="setting-row-content">

                        <div class="setting-row-title">
                            Password
                        </div>

                        <div class="setting-row-text">
                            Change your account password regularly
                            to keep your account secure.
                        </div>

                    </div>

                    <a asp-controller="Account"
                       asp-action="ChangePassword"
                       class="settings-btn settings-btn-outline">

                        Change Password

                    </a>

                </div>


                <!-- TWO FACTOR -->

                <div class="setting-row">

                    <div class="setting-row-content">

                        <div class="setting-row-title">
                            Two-Factor Authentication
                        </div>

                        @if (Model?.TwoFactorEnabled == true)
                        {
                            <span class="status-badge status-enabled">
                                Enabled
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-disabled">
                                Disabled
                            </span>
                        }

                        <div class="setting-row-text">
                            Add an extra layer of protection to
                            your EyeCraft account.
                        </div>

                    </div>

                    <a asp-controller="Account"
                       asp-action="TwoFactorAuthentication"
                       class="settings-btn settings-btn-outline">

                        Manage 2FA

                    </a>

                </div>

            </div>


            <!-- =================================================
                 SAVED ADDRESSES
                 ================================================= -->

            <div class="settings-card">

                <h3 class="settings-card-title">
                    Saved Addresses
                </h3>

                <p class="settings-card-description">
                    Manage your delivery and billing addresses
                    for faster checkout.
                </p>


                <div class="setting-row">

                    <div class="setting-row-content">

                        <div class="setting-row-title">
                            Delivery Addresses
                        </div>

                        <div class="setting-row-text">
                            Add, edit, or remove your saved
                            shipping addresses.
                        </div>

                    </div>

                    <a asp-controller="Addresses"
                       asp-action="Index"
                       class="settings-btn settings-btn-outline">

                        Manage Addresses

                    </a>

                </div>

            </div>


            <!-- =================================================
                 SIGN OUT
                 ================================================= -->

            <div class="settings-card logout-card">

                <h3 class="settings-card-title">
                    Sign Out
                </h3>

                <p class="settings-card-description">
                    Sign out of your EyeCraft account on this device.
                </p>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="settings-btn settings-btn-outline">

                        Sign Out

                    </button>

                </form>

            </div>


            <!-- =================================================
                 DELETE ACCOUNT
                 ================================================= -->

            <div class="settings-card danger-card">

                <h3 class="settings-card-title">
                    Delete Account
                </h3>

                <p class="settings-card-description">
                    Permanently delete your EyeCraft account and
                    associated account information. This action
                    cannot be undone.
                </p>

                <a asp-controller="Account"
                   asp-action="DeleteAccount"
                   class="settings-btn settings-btn-danger">

                    Delete Account

                </a>

            </div>


        </main>

    </div>

</div>