@{
    ViewData["Title"] = "Verification Failed";
}

<div class="container mt-5">
    <div class="text-center">

        <h2>Email Verification Failed</h2>

        <p class="mt-3">
            The verification link is invalid or has expired.
        </p>

        <a asp-action="Login"
           class="btn btn-dark mt-3">
            Back to Login
        </a>

    </div>
</div>