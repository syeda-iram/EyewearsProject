@model EyewearsProject.ViewModels.DeleteAccountViewModel

@{
    ViewData["Title"] = "Delete Account";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger mb-3">
                        Delete Account
                    </h2>

                    <div class="alert alert-danger">

                        <strong>Warning:</strong>

                        <p class="mb-0 mt-2">
                            You are about to delete your EyeCraft account.
                            Your account will be deactivated and you will
                            be signed out.
                        </p>

                    </div>

                    <p class="text-muted">
                        For your security, please enter your current password
                        to confirm that you want to delete your account.
                    </p>

                    <form asp-controller="Account"
                          asp-action="DeleteAccount"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter your current password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Account
                            </button>

                            <a asp-controller="Account"
                               asp-action="Settings"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
