@using EyewearsProject.Extensions
@using EyewearsProject.Models
@{
    var product = (Product)ViewBag.Product;
    var variant = (ProductVariant)ViewBag.Variant;
    var lensTypes = (Dictionary<string, decimal>)ViewBag.LensTypes;
    var coatings = (Dictionary<string, decimal>)ViewBag.Coatings;
    var savedPrescriptions = (List<Prescription>)ViewBag.SavedPrescriptions;
    var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary) ?? product.Images.FirstOrDefault();

    ViewData["Title"] = "Customize your lenses";
}

<h1>Customize your lenses</h1>
<p class="text-muted">For @product.Name — @variant.Color</p>

<form asp-controller="Lens" asp-action="AddToCart" method="post" id="lensForm">
    <input type="hidden" name="productId" value="@product.Id" />
    <input type="hidden" name="variantId" value="@variant.Id" />
    <input type="hidden" name="quantity" value="1" />

    <div class="row">
        <div class="col-md-7">
            <h5>1. Lens Type</h5>
            <div class="list-group mb-4">
                @{
                    bool firstLens = true;
                }
                @foreach (var lt in lensTypes)
                {
                    <label class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <input type="radio" name="lensType" value="@lt.Key" class="form-check-input me-2 lens-radio"
                                   data-price="@lt.Value" checked="@(firstLens ? "checked" : null)" />
                            @lt.Key
                        </span>
                        <span>@(lt.Value == 0 ? "Included" : "+" + lt.Value.ToPkr())</span>
                    </label>
                    firstLens = false;
                }
            </div>

            <h5>2. Coating</h5>
            <div class="list-group mb-4">
                @{
                    bool firstCoat = true;
                }
                @foreach (var ct in coatings)
                {
                    <label class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <input type="radio" name="coating" value="@ct.Key" class="form-check-input me-2 coating-radio"
                                   data-price="@ct.Value" checked="@(firstCoat ? "checked" : null)" />
                            @ct.Key
                        </span>
                        <span>@(ct.Value == 0 ? "None" : "+" + ct.Value.ToPkr())</span>
                    </label>
                    firstCoat = false;
                }
            </div>

            <<h5>3. Prescription</h5>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="text-muted"><a asp-controller="Account" asp-action="Login">Log in</a> to attach a prescription, or continue without one.</p>
                }
                else
                {
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-primary" id="addPrescriptionBtn">+ Add Prescription</button>
                        <span class="text-muted align-self-center" id="continueWithoutLabel">or continue without one</span>
                    </div>

                    <div id="prescriptionPanel" class="border rounded p-3 mb-4" style="display:none;">
                        @if (savedPrescriptions.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Use a saved prescription</label>
                                <select name="prescriptionId" id="savedRxSelect" class="form-select" style="max-width:400px;">
                                    <option value="">-- Select --</option>
                                    @foreach (var rx in savedPrescriptions)
                                    {
                                        <option value="@rx.Id">@rx.PatientName — @rx.CreatedAt.ToString("dd MMM yyyy")</option>
                                    }
                                </select>
                            </div>
                            <hr />
                            <p class="text-muted small">Or add a new one below:</p>
                        }

                        <div class="btn-group mb-3" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm rx-tab-btn active" data-tab="upload">Upload Photo/PDF</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rx-tab-btn" data-tab="manual">Enter Manually</button>
                        </div>

                        <div id="rx-tab-upload" class="rx-tab-content">
                            <input type="file" id="rxFileInput" accept=".jpg,.jpeg,.png,.pdf" class="form-control mb-2" style="max-width:400px;" />
                            <div id="rxUploadStatus" class="small text-muted"></div>
                            <input type="hidden" name="uploadedFileUrl" id="uploadedFileUrlField" />
                        </div>

                        <div id="rx-tab-manual" class="rx-tab-content" style="display:none;">
                            <div class="mb-2">
                                <input type="text" name="newPatientName" class="form-control form-control-sm" placeholder="Patient name" style="max-width:300px;" />
                            </div>
                            <p class="fw-bold mb-1 small">Right Eye (OD)</p>
                            <div class="row g-2 mb-2" style="max-width:600px;">
                                <div class="col"><input type="number" step="0.25" name="rSph" class="form-control form-control-sm" placeholder="SPH" /></div>
                                <div class="col"><input type="number" step="0.25" name="rCyl" class="form-control form-control-sm" placeholder="CYL" /></div>
                                <div class="col"><input type="number" name="rAxis" class="form-control form-control-sm" placeholder="Axis" /></div>
                                <div class="col"><input type="number" step="0.25" name="rAdd" class="form-control form-control-sm" placeholder="Add" /></div>
                                <div class="col"><input type="number" step="0.5" name="rPd" class="form-control form-control-sm" placeholder="PD" /></div>
                            </div>
                            <p class="fw-bold mb-1 small">Left Eye (OS)</p>
                            <div class="row g-2" style="max-width:600px;">
                                <div class="col"><input type="number" step="0.25" name="lSph" class="form-control form-control-sm" placeholder="SPH" /></div>
                                <div class="col"><input type="number" step="0.25" name="lCyl" class="form-control form-control-sm" placeholder="CYL" /></div>
                                <div class="col"><input type="number" name="lAxis" class="form-control form-control-sm" placeholder="Axis" /></div>
                                <div class="col"><input type="number" step="0.25" name="lAdd" class="form-control form-control-sm" placeholder="Add" /></div>
                                <div class="col"><input type="number" step="0.5" name="lPd" class="form-control form-control-sm" placeholder="PD" /></div>
                            </div>
                        </div>
                    </div>
                }
        </div>

        <div class="col-md-5">
            <div class="card p-3" >
                @if (primaryImage != null)
                {
                    <img src="@primaryImage.ImageUrl" class="img-fluid rounded mb-3" alt="@product.Name" />
                }
                <div class="d-flex justify-content-between">
                    <span>Frame</span>
                    <span>@((product.DiscountPrice ?? product.Price).ToPkr())</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Lenses</span>
                    <span id="lensAddOnDisplay">Rs 0</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span id="totalDisplay">@((product.DiscountPrice ?? product.Price)).ToPkr()</span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg mt-3">Add to Cart</button>
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary mt-2">Back to Product</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const basePrice = @((product.DiscountPrice ?? product.Price));

        function recalcTotal() {
            const lensRadio = document.querySelector('.lens-radio:checked');
            const coatingRadio = document.querySelector('.coating-radio:checked');

            const lensPrice = lensRadio ? parseFloat(lensRadio.dataset.price) : 0;
            const coatingPrice = coatingRadio ? parseFloat(coatingRadio.dataset.price) : 0;
            const addOn = lensPrice + coatingPrice;
            const total = basePrice + addOn;

            document.getElementById('lensAddOnDisplay').textContent = 'Rs ' + addOn.toLocaleString('en-PK', { maximumFractionDigits: 0 });
            document.getElementById('totalDisplay').textContent = 'Rs ' + total.toLocaleString('en-PK', { maximumFractionDigits: 0 });
        }

        document.querySelectorAll('.lens-radio, .coating-radio').forEach(el => {
            el.addEventListener('change', recalcTotal);
        });

        recalcTotal();
            const addBtn = document.getElementById('addPrescriptionBtn');
            const panel = document.getElementById('prescriptionPanel');
            if (addBtn) {
                addBtn.addEventListener('click', function() {
                    const isOpen = panel.style.display !== 'none';
                    panel.style.display = isOpen ? 'none' : 'block';
                    addBtn.textContent = isOpen ? '+ Add Prescription' : 'Hide Prescription Form';
                });
            }

            document.querySelectorAll('.rx-tab-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.rx-tab-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    document.querySelectorAll('.rx-tab-content').forEach(c => c.style.display = 'none');
                    document.getElementById('rx-tab-' + this.dataset.tab).style.display = 'block';
                });
            });

            const rxFileInput = document.getElementById('rxFileInput');
            if (rxFileInput) {
                rxFileInput.addEventListener('change', async function() {
                    const file = this.files[0];
                    if (!file) return;

                    const statusEl = document.getElementById('rxUploadStatus');
                    statusEl.textContent = 'Uploading...';

                    const formData = new FormData();
                    formData.append('file', file);

                    const response = await fetch('/Prescriptions/UploadFile', { method: 'POST', body: formData });
                    const data = await response.json();

                    if (data.success) {
                        document.getElementById('uploadedFileUrlField').value = data.url;
                        statusEl.textContent = 'Uploaded: ' + file.name;
                        statusEl.classList.add('text-success');
                    } else {
                        statusEl.textContent = data.message;
                        statusEl.classList.add('text-danger');
                    }
                });
            }
    </script>
}