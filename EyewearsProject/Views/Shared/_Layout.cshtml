@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EyewearsProject.Models
@using EyewearsProject.Extensions
@using EyewearsProject.Services

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject AppDbContext DbContext
@inject IHttpContextAccessor HttpContextAccessor
@inject ICartService CartService

@{
    var categories = await DbContext.Categories
    .Include(c => c.SubCategories)
    .Where(c => c.ParentCategoryId == null)
    .OrderBy(c => c.Name)
    .ToListAsync();

    ApplicationUser? currentUser = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }

    var cartItems = await CartService.GetCartAsync();

    var cartCount = cartItems.Sum(i => i.Quantity);

    int wishlistCount = 0;

    if (currentUser != null)
    {
        wishlistCount = await DbContext.WishlistItems
            .Where(wi => wi.Wishlist.UserId == currentUser.Id)
            .CountAsync();
    }

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EyeCraft</title>

    <script type="importmap"></script>

    <!-- Fonts: Fraunces (display/headings) + Inter (body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Main site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Project generated CSS -->
    <link rel="stylesheet"
          href="~/EyewearsProject.styles.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header>

        <nav class="navbar navbar-expand-sm site-topbar">

            <div class="container-fluid evw-header">


                <!-- =================================================
                     LOGO
                     ================================================= -->

                <button class="evw-logo-btn"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#siteSidebar"
                        aria-controls="siteSidebar">

                    <span class="evw-logo-icon">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="17"
                             height="17"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <circle cx="6"
                                    cy="12"
                                    r="4" />

                            <circle cx="18"
                                    cy="12"
                                    r="4" />

                            <path d="M10 12h4M2 12h0M22 12h0" />

                        </svg>

                    </span>


                    <div class="evw-brand">

                        <span class="evw-logo-text">
                            EyeCraft
                        </span>

                        <span class="evw-tagline">
                            Crafted for Your Vision
                        </span>

                    </div>

                </button>


                <!-- =================================================
                     SEARCH
                     ================================================= -->

                <form class="evw-search-form"
                      asp-controller="Products"
                      asp-action="Index"
                      method="get">

                    <div class="input-group">

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search frames, brands, lenses"
                               autocomplete="off" />


                        <button type="submit"
                                aria-label="Search">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="18"
                                 height="18"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <circle cx="11"
                                        cy="11"
                                        r="8" />

                                <line x1="21"
                                      y1="21"
                                      x2="16.65"
                                      y2="16.65" />

                            </svg>

                        </button>

                    </div>

                </form>


                <!-- =================================================
                     MOBILE TOGGLE
                     ================================================= -->

                <button class="navbar-toggler ms-auto d-sm-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".topbar-links"
                        aria-controls="topbarLinks"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- =================================================
                     DESKTOP NAVIGATION
                     ================================================= -->

                <div class="collapse navbar-collapse topbar-links flex-grow-0">

                    <ul class="navbar-nav align-items-center flex-row">


                        <!-- SHOP -->

                        <li class="nav-item">

                            <a class="evw-nav-link @(currentController == "Products" ? "active" : "")"
                               asp-controller="Products"
                               asp-action="Index">

                                Shop

                            </a>

                        </li>


                        <!-- TRY ON -->

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="TryOn" asp-action="Index" title="Virtual Try-On">Try-On</a>

                        </li>


                        <!-- PRESCRIPTION -->

                        <li class="nav-item">

                            <a class="evw-nav-link @(currentController == "Prescriptions" ? "active" : "")"
                               asp-controller="Prescriptions"
                               asp-action="Index">

                                Prescription

                            </a>

                        </li>


                        <!-- WISHLIST -->

                        <li class="nav-item">

                            <a class="evw-icon-btn"
                               asp-controller="Wishlist"
                               asp-action="Index"
                               title="Wishlist">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="19"
                                     height="19"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z">
                                    </path>

                                </svg>


                                @if (wishlistCount > 0)
                                {
                                    <span class="icon-badge">
                                        @wishlistCount
                                    </span>
                                }

                            </a>

                        </li>


                        <!-- CART -->

                        <li class="nav-item">

                            <a class="evw-icon-btn"
                               asp-controller="Cart"
                               asp-action="Index"
                               title="Cart">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="19"
                                     height="19"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <circle cx="9"
                                            cy="21"
                                            r="1">
                                    </circle>

                                    <circle cx="20"
                                            cy="21"
                                            r="1">
                                    </circle>

                                    <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6">
                                    </path>

                                </svg>


                                @if (cartCount > 0)
                                {
                                    <span class="icon-badge">
                                        @cartCount
                                    </span>
                                }

                            </a>

                        </li>


                        <!-- USER -->

                        <li class="nav-item dropdown">

                            @if (currentUser != null)
                            {
                                <a class="evw-icon-btn dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@currentUser.FullName">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item text-muted small"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            @currentUser.FullName
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <a class="evw-icon-btn dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Login / Register">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                                </ul>
                            }

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="siteSidebar"
         aria-labelledby="siteSidebarLabel">


        <!-- Sidebar Header -->

        <div class="offcanvas-header">

            <div>

                @if (currentUser != null)
                {
                    <div class="sidebar-username">
                        @currentUser.FullName
                    </div>

                    <div class="sidebar-usermail">
                        @currentUser.Email
                    </div>
                }
                else
                {
                    <div class="sidebar-username">
                        EyeCraft
                    </div>

                    <div class="sidebar-usermail">
                        Crafted for Your Vision
                    </div>
                }

            </div>


            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>


        <!-- Sidebar Body -->

        <div class="offcanvas-body">


            <!-- SHOP -->

            <div class="sidebar-section-label">
                Shop
            </div>


            <ul class="sidebar-nav">

                <li>
                    <a asp-controller="Products" asp-action="Index">All Products</a>
                </li>

                @foreach (var cat in categories)
                {
                    <li>
                        <a href="#cat-@cat.Id"
                           data-bs-toggle="collapse"
                           class="sidebar-cat-toggle"
                           role="button"
                           aria-expanded="false"
                           aria-controls="cat-@cat.Id">

                            @cat.Name

                            @if (cat.SubCategories.Any())
                            {
                                <i class="bi bi-chevron-down small"></i>
                            }
                        </a>

                        @if (cat.SubCategories.Any())
                        {
                            <div class="collapse sidebar-subnav" id="cat-@cat.Id">
                                <ul class="sidebar-nav">
                                    <li>
                                        <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Name">
                                            All @cat.Name
                                        </a>
                                    </li>
                                    @foreach (var sub in cat.SubCategories.OrderBy(s => s.Name))
                                    {
                                        <li>
                                            <a asp-controller="Products" asp-action="Index" asp-route-category="@sub.Name">
                                                @sub.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </li>
                }

            </ul>


            <hr />


            <!-- ACCOUNT / SHOP LINKS -->

            <ul class="sidebar-nav">

                <li>

                    <a asp-controller="Wishlist"
                       asp-action="Index">

                        Wishlist

                    </a>

                </li>


                <li>

                    <a asp-controller="Cart"
                       asp-action="Index">

                        Cart

                    </a>

                </li>


                @if (currentUser != null)
                {

                    <li>

                        <a asp-controller="Prescriptions"
                           asp-action="Index">

                            Prescriptions

                        </a>

                    </li>


                    <li>

                        <a asp-controller="Orders"
                           asp-action="Index">

                            My Orders

                        </a>

                    </li>


                    <li>

                        <a asp-controller="Account"
                           asp-action="Settings">
                            Settings
                        </a>

                    </li>
                }
                else
                {
                    <li>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Settings

                        </a>

                    </li>
                }

            </ul>


            <!-- AUTH BUTTONS -->
            @if (currentUser != null)
            {
                <hr />

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="btn btn-outline-secondary btn-sm w-100">

                        Logout

                    </button>

                </form>
            }
            else
            {
                <hr />

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary btn-sm w-100 mb-2">

                    Login

                </a>


                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-outline-primary btn-sm w-100">

                    Register

                </a>
            }

        </div>

    </div>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="evw-footer">

        <div class="container">

            <div class="row g-4">


                <!-- BRAND -->

                <div class="col-md-4">

                    <h6>
                        EyeCraft
                    </h6>

                    <p class="small mb-0"
                       style="color:#A69885;">

                        Crafted for Your Vision.
                        Quality eyewear, prescription-ready
                        lenses, and stylish frames delivered
                        to your door.

                    </p>

                </div>


                <!-- SHOP -->

                <div class="col-6 col-md-2">

                    <h6>
                        Shop
                    </h6>


                    <a asp-controller="Products"
                       asp-action="Index">

                        All Products

                    </a>


                    @foreach (var cat in categories.Take(4))
                    {
                        <a asp-controller="Products"
                           asp-action="Index"
                           asp-route-category="@cat.Name">

                            @cat.Name

                        </a>
                    }

                </div>


                <!-- ACCOUNT -->

                <div class="col-6 col-md-2">

                    <h6>
                        Account
                    </h6>


                    <a asp-controller="Orders"
                       asp-action="Index">

                        My Orders

                    </a>


                    <a asp-controller="Wishlist"
                       asp-action="Index">

                        Wishlist

                    </a>


                    <a asp-controller="Prescriptions"
                       asp-action="Index">

                        Prescriptions

                    </a>

                </div>


                <!-- HELP -->

                <div class="col-6 col-md-2">

                    <h6>
                        Help
                    </h6>


                    <a asp-controller="Home"
                       asp-action="Privacy">

                        Privacy Policy

                    </a>


                    <a href="#">
                        Returns &amp; Exchanges
                    </a>


                    <a href="#">
                        Contact Us
                    </a>

                </div>

            </div>


            <!-- FOOTER BOTTOM -->

            <div class="evw-footer-bottom">

                &copy; @DateTime.Now.Year
                EyeCraft. All rights reserved.

            </div>

        </div>

    </footer>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
