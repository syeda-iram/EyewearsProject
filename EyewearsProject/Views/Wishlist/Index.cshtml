@using EyewearsProject.Extensions
@model Wishlist

@{
    ViewData["Title"] = "My Wishlist";
}

<h1>My Wishlist</h1>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Your wishlist is empty.
        <a asp-controller="Products" asp-action="Index">Browse products</a> and tap the heart icon to save some here.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Items)
        {
            var thumb = item.Product.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                        ?? item.Product.Images.FirstOrDefault()?.ImageUrl;
            var price = item.Product.DiscountPrice ?? item.Product.Price;

            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(thumb))
                    {
                        <img src="@thumb" class="card-img-top" alt="@item.Product.Name" style="height:200px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Product.Name</h5>
                        @if (item.ProductVariant != null)
                        {
                            <p class="text-muted mb-1">Color: @item.ProductVariant.Color</p>
                        }
                        <p class="fw-bold">@price.ToPkr()</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between bg-white border-top-0">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                            View Product
                        </a>
                        <form asp-controller="Wishlist" asp-action="Remove" method="post">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}