@model Prescription

@{
    ViewData["Title"] = "Add Prescription";
}

<h1>Add New Prescription</h1>

<div class="mb-4 p-3 border rounded" style="max-width:700px;">
    <label class="form-label fw-bold">Have a prescription photo? Upload it to auto-fill the fields below</label>
    <input type="file" id="rxCreateFileInput" accept=".jpg,.jpeg,.png" class="form-control mb-2" />
    <div id="rxCreateOcrNotice" class="small" style="display:none;"></div>
</div>

<form asp-action="Create" method="post" style="max-width:700px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PatientName" class="form-label">Patient Name</label>
        <input asp-for="PatientName" class="form-control" required />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PrescribedBy" class="form-label">Prescribed By (Doctor / Clinic)</label>
            <input asp-for="PrescribedBy" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="IssuedDate" class="form-label">Issued Date</label>
            <input asp-for="IssuedDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
            <input asp-for="ExpiryDate" type="date" class="form-control" />
        </div>
    </div>

    <h5 class="mt-4">Right Eye (OD)</h5>
    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="RightSphere" class="form-label">SPH</label>
            <input asp-for="RightSphere" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="RightCylinder" class="form-label">CYL</label>
            <input asp-for="RightCylinder" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="RightAxis" class="form-label">Axis</label>
            <input asp-for="RightAxis" type="number" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="RightAdd" class="form-label">Add</label>
            <input asp-for="RightAdd" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="RightPd" class="form-label">PD</label>
            <input asp-for="RightPd" type="number" step="0.5" class="form-control" />
        </div>
    </div>

    <h5 class="mt-3">Left Eye (OS)</h5>
    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="LeftSphere" class="form-label">SPH</label>
            <input asp-for="LeftSphere" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="LeftCylinder" class="form-label">CYL</label>
            <input asp-for="LeftCylinder" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="LeftAxis" class="form-label">Axis</label>
            <input asp-for="LeftAxis" type="number" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="LeftAdd" class="form-label">Add</label>
            <input asp-for="LeftAdd" type="number" step="0.25" class="form-control" />
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="LeftPd" class="form-label">PD</label>
            <input asp-for="LeftPd" type="number" step="0.5" class="form-control" />
        </div>
    </div>

    <div class="mb-3 mt-3">
        <label asp-for="Notes" class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Prescription</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <script>
        function fixMissingDecimal(num) {
            if (Math.abs(num) > 20 && Math.abs(num) < 3000) {
                const shifted = num / 100;
                if (Math.abs(shifted) <= 20) return shifted;
            }
            return num;
        }

        function extractPrescriptionNumbers(text, labelPatterns) {
            const tokens = text.split(/\s+/).filter(Boolean);
            const numberRegex = /^[-+]?\d+(\.\d+)?$/;

            for (let i = 0; i < tokens.length; i++) {
                if (labelPatterns.some(p => p.test(tokens[i]))) {
                    const found = [];
                    for (let j = i + 1; j < tokens.length && found.length < 5 && j < i + 12; j++) {
                        if (numberRegex.test(tokens[j])) {
                            found.push(fixMissingDecimal(parseFloat(tokens[j])));
                        }
                    }
                    if (found.length >= 2) return found;
                }
            }
            return null;
        }

        function parsePrescriptionText(text) {
            const odNums = extractPrescriptionNumbers(text, [/^OD$/i, /right/i]);
            const osNums = extractPrescriptionNumbers(text, [/^OS$/i, /left/i]);
            const result = {};
            if (odNums && odNums.length >= 2) {
                result.RightSphere = odNums[0];
                result.RightCylinder = odNums[1];
                if (odNums[2] !== undefined) result.RightAxis = odNums[2];
                if (odNums[3] !== undefined) result.RightAdd = odNums[3];
                if (odNums[4] !== undefined) result.RightPd = odNums[4];
            }
            if (osNums && osNums.length >= 2) {
                result.LeftSphere = osNums[0];
                result.LeftCylinder = osNums[1];
                if (osNums[2] !== undefined) result.LeftAxis = osNums[2];
                if (osNums[3] !== undefined) result.LeftAdd = osNums[3];
                if (osNums[4] !== undefined) result.LeftPd = osNums[4];
            }
            return result;
        }

        function isPrescriptionDataUsable(data) {
            const hasRight = data.RightSphere !== undefined && data.RightCylinder !== undefined;
            const hasLeft = data.LeftSphere !== undefined && data.LeftCylinder !== undefined;
            return hasRight || hasLeft;
        }

        document.getElementById('rxCreateFileInput').addEventListener('change', async function() {
            const file = this.files[0];
            if (!file) return;

            const notice = document.getElementById('rxCreateOcrNotice');
            notice.style.display = 'block';
            notice.className = 'small text-muted';
            notice.textContent = 'Reading your prescription...';

            try {
                const result = await Tesseract.recognize(file, 'eng');
                const parsed = parsePrescriptionText(result.data.text);

                if (isPrescriptionDataUsable(parsed)) {
                    for (const [fieldName, value] of Object.entries(parsed)) {
                        const input = document.querySelector(`input[name="${fieldName}"]`);
                        if (input) input.value = value;
                    }
                    notice.className = 'small text-success';
                    notice.textContent = 'We filled in what we could read — please review and correct the values below before saving.';
                } else {
                    notice.className = 'small text-danger';
                    notice.textContent = "We couldn't clearly read prescription values from this photo. Please enter them manually below, or try a clearer, straight-on photo.";
                }
            } catch (err) {
                console.error('OCR failed:', err);
                notice.className = 'small text-danger';
                notice.textContent = "We couldn't read this photo automatically. Please enter your prescription values manually below.";
            }
        });
    </script>
}