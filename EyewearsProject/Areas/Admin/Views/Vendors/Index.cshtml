@model List<Vendor>
<div class="d-flex justify-content-between mb-3">
    <h4>Vendors</h4>
    <a asp-action="Create" class="btn btn-dark">+ New Vendor</a>
</div>

<table class="table table-bordered bg-white align-middle">
    <thead>
        <tr><th>Company</th><th>Contact</th><th>Type</th><th>Purchase Orders</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.CompanyName</td>
                <td>
                    <div>@v.ContactName</div>
                    <div class="text-muted small">@v.ContactEmail</div>
                </td>
                <td><span class="badge bg-secondary">@v.VendorType</span></td>
                <td>@v.PurchaseOrders.Count</td>
                <td>
                    @if (v.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-controller="PurchaseOrders" asp-action="Index" asp-route-vendorId="@v.Id" class="btn btn-sm btn-outline-secondary">Purchase Orders</a>
                    <form asp-action="ToggleActive" asp-route-id="@v.Id" method="post">
                        <button class="btn btn-sm btn-outline-warning">@(v.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No vendors yet.</p>
}