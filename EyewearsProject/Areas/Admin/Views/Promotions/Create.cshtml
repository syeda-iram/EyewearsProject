@model PromotionFormViewModel
<h4>@(Model.Id == 0 ? "Create" : "Edit") Promotion</h4>
<form asp-action="Create" method="post" style="max-width:520px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DiscountType" class="form-label"></label>
            <select asp-for="DiscountType" class="form-select"
                    asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DiscountValue" class="form-label"></label>
            <input asp-for="DiscountValue" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MinOrderAmount" class="form-label"></label>
            <input asp-for="MinOrderAmount" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MaxDiscountAmount" class="form-label"></label>
            <input asp-for="MaxDiscountAmount" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="UsageLimit" class="form-label">Usage Limit (blank = unlimited)</label>
        <input asp-for="UsageLimit" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button class="btn btn-dark">Save</button>
</form>