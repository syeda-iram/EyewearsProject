@using EyewearsProject.Extensions
@model DashboardViewModel

<div class="mb-4">
    <h3 class="mb-1">Dashboard</h3>
    <p class="text-muted mb-0">Welcome back, @User.Identity?.Name.</p>
</div>

@if (Model.PendingOrders > 0 || Model.LowStockCount > 0 || Model.TotalReturns > 0)
{
    <div class="alert alert-warning">
        <strong>Needs attention:</strong>
        @if (Model.PendingOrders > 0)
        {
            <span class="badge bg-dark me-1">@Model.PendingOrders pending order(s)</span>
        }
        @if (Model.LowStockCount > 0)
        {
            <span class="badge bg-warning text-dark me-1">@Model.LowStockCount low/out of stock item(s)</span>
        }
        @if (Model.TotalReturns > 0)
        {
            <span class="badge bg-info text-dark me-1">@Model.TotalReturns return(s)</span>
        }
    </div>
}

<h6 class="text-muted text-uppercase mb-2">Sales</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total Sales</small><h3>@Model.TotalSales.ToPkr()</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Today's Sales</small><h3>@Model.TodaySales.ToPkr()</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Monthly Sales</small><h3>@Model.MonthlySales.ToPkr()</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total Refunded</small><h3 class="text-danger">@Model.TotalRefunded.ToPkr()</h3></div></div>
</div>

<h6 class="text-muted text-uppercase mb-2">Orders</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total Orders</small><h3>@Model.TotalOrders</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Pending</small><h3 class="text-warning">@Model.PendingOrders</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Delivered</small><h3 class="text-success">@Model.DeliveredOrders</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Cancelled</small><h3 class="text-danger">@Model.CancelledOrders</h3></div></div>
</div>

<h6 class="text-muted text-uppercase mb-2">Customers &amp; Inventory</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total Customers</small><h3>@Model.TotalCustomers</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">New This Month</small><h3>@Model.NewCustomersThisMonth</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Low Stock Products</small><h3 class="text-warning">@Model.LowStockCount</h3></div></div>
    <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total Returns</small><h3>@Model.TotalReturns</h3></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <h6>Sales by Day (last 30 days)</h6>
            <canvas id="salesByDayChart" height="90"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <h6>Sales by Month (last 12 months)</h6>
            <canvas id="salesByMonthChart" height="90"></canvas>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Sales by Category</h6>
            <canvas id="salesByCategoryChart"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Sales by Brand</h6>
            <canvas id="salesByBrandChart"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Orders by Status</h6>
            <canvas id="ordersByStatusChart"></canvas>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <h6>Customer Growth (last 12 months)</h6>
    <canvas id="customerGrowthChart" height="80"></canvas>
</div>

<div class="row">
    <div class="col-md-6">
        <h6 class="text-muted text-uppercase mb-2">Top Products</h6>
        <table class="table table-bordered bg-white">
            <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
            <tbody>
                @if (Model.TopProducts.Any())
                {
                    @foreach (var p in Model.TopProducts)
                    {
                        <tr><td>@p.ProductName</td><td>@p.UnitsSold</td><td>@p.Revenue.ToPkr()</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-muted">No sales data yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h6 class="text-muted text-uppercase mb-2">Top Brands</h6>
        <table class="table table-bordered bg-white">
            <thead><tr><th>Brand</th><th>Units</th><th>Revenue</th></tr></thead>
            <tbody>
                @if (Model.TopBrands.Any())
                {
                    @foreach (var b in Model.TopBrands)
                    {
                        <tr><td>@b.BrandName</td><td>@b.UnitsSold</td><td>@b.Revenue.ToPkr()</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-muted">No sales data yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        const pkr = (v) => 'Rs ' + Number(v).toLocaleString('en-PK', { maximumFractionDigits: 0 });

        function lineChart(id, labels, data, label) {
            new Chart(document.getElementById(id), {
                type: 'line',
                data: { labels, datasets: [{ label, data, borderColor: '#212529', backgroundColor: 'rgba(33,37,41,0.08)', fill: true, tension: 0.3 }] },
                options: { plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => pkr(v) } } } }
            });
        }

        function barChart(id, labels, data, label) {
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: { labels, datasets: [{ label, data, backgroundColor: '#495057' }] },
                options: { plugins: { legend: { display: false } } }
            });
        }

        function pieChart(id, labels, data) {
            new Chart(document.getElementById(id), {
                type: 'doughnut',
                data: { labels, datasets: [{ data, backgroundColor: ['#212529', '#495057', '#6c757d', '#adb5bd', '#ced4da', '#dee2e6'] }] }
            });
        }

        lineChart('salesByDayChart',
                    @Html.Raw(Json.Serialize(Model.SalesByDay.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.SalesByDay.Select(x => x.Value))),
            'Sales');

        lineChart('salesByMonthChart',
                    @Html.Raw(Json.Serialize(Model.SalesByMonth.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.SalesByMonth.Select(x => x.Value))),
            'Sales');

        pieChart('salesByCategoryChart',
                    @Html.Raw(Json.Serialize(Model.SalesByCategory.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.SalesByCategory.Select(x => x.Value))));

        pieChart('salesByBrandChart',
                    @Html.Raw(Json.Serialize(Model.SalesByBrand.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.SalesByBrand.Select(x => x.Value))));

        pieChart('ordersByStatusChart',
                    @Html.Raw(Json.Serialize(Model.OrdersByStatus.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.OrdersByStatus.Select(x => x.Value))));

        barChart('customerGrowthChart',
                    @Html.Raw(Json.Serialize(Model.CustomerGrowth.Select(x => x.Label))),
                    @Html.Raw(Json.Serialize(Model.CustomerGrowth.Select(x => x.Value))),
            'Total Customers');
    </script>
}