@using EyewearsProject.Extensions
@model DashboardViewModel

@*
    ============================================================
    EyeCraft Admin Dashboard
    ============================================================

    DashboardViewModel properties preserved:
    - TotalSales
    - TodaySales
    - MonthlySales
    - TotalRefunded
    - TotalOrders
    - PendingOrders
    - DeliveredOrders
    - CancelledOrders
    - TotalCustomers
    - NewCustomersThisMonth
    - LowStockCount
    - TotalReturns
    - SalesByDay
    - SalesByMonth
    - SalesByCategory
    - SalesByBrand
    - OrdersByStatus
    - CustomerGrowth
    - TopProducts
    - TopBrands
*@


<div class="dashboard-page">


    <!-- ========================================================
         PAGE HEADER
         ======================================================== -->

    <div class="page-header">

        <div>

            <h1>Dashboard</h1>

            <p>
                Welcome back, @User.Identity?.Name.
                Here's what's happening with your store.
            </p>

        </div>

    </div>


    <!-- ========================================================
         ATTENTION ALERT
         ======================================================== -->
    @if (Model.PendingOrders > 0 ||
             Model.LowStockCount > 0 ||
             Model.TotalReturns > 0)
    {
        <div class="dashboard-attention">

            <div class="dashboard-attention-icon">

                <i class="bi bi-exclamation-triangle"></i>

            </div>

            <div class="dashboard-attention-content">

                <strong>Needs attention</strong>

                <div class="dashboard-attention-items">

                    @if (Model.PendingOrders > 0)
                    {
                        <span class="pill pill-gray">

                            <i class="bi bi-clock"></i>

                            @Model.PendingOrders pending order(s)

                        </span>
                    }

                    @if (Model.LowStockCount > 0)
                    {
                        <span class="pill pill-warning">

                            <i class="bi bi-box-seam"></i>

                            @Model.LowStockCount low/out of stock item(s)

                        </span>
                    }

                    @if (Model.TotalReturns > 0)
                    {
                        <span class="pill pill-blue">

                            <i class="bi bi-arrow-counterclockwise"></i>

                            @Model.TotalReturns return(s)

                        </span>
                    }

                </div>

            </div>

        </div>
    }


    <!-- ========================================================
         SALES
         ======================================================== -->

    <div class="dashboard-section-title">

        <span class="dashboard-section-icon">
            <i class="bi bi-cash-stack"></i>
        </span>

        <span>Sales</span>

    </div>


    <div class="row g-3">


        <!-- Total Sales -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-blue">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Overall
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Total Sales
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalSales.ToPkr()
                </div>

            </div>

        </div>


        <!-- Today's Sales -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-green">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-calendar-day"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Today
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Today's Sales
                </div>

                <div class="dashboard-stat-value">
                    @Model.TodaySales.ToPkr()
                </div>

            </div>

        </div>


        <!-- Monthly Sales -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-warning">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        This month
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Monthly Sales
                </div>

                <div class="dashboard-stat-value">
                    @Model.MonthlySales.ToPkr()
                </div>

            </div>

        </div>


        <!-- Total Refunded -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-danger">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Refunds
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Total Refunded
                </div>

                <div class="dashboard-stat-value text-danger">
                    @Model.TotalRefunded.ToPkr()
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================
         ORDERS
         ======================================================== -->

    <div class="dashboard-section-title">

        <span class="dashboard-section-icon">
            <i class="bi bi-box-seam"></i>
        </span>

        <span>Orders</span>

    </div>


    <div class="row g-3">


        <!-- Total Orders -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-dark">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        All time
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Total Orders
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalOrders
                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-warning">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Action needed
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Pending
                </div>

                <div class="dashboard-stat-value text-warning">
                    @Model.PendingOrders
                </div>

            </div>

        </div>


        <!-- Delivered -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-green">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Completed
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Delivered
                </div>

                <div class="dashboard-stat-value text-success">
                    @Model.DeliveredOrders
                </div>

            </div>

        </div>


        <!-- Cancelled -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-danger">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Cancelled
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Cancelled
                </div>

                <div class="dashboard-stat-value text-danger">
                    @Model.CancelledOrders
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================
         CUSTOMERS & INVENTORY
         ======================================================== -->

    <div class="dashboard-section-title">

        <span class="dashboard-section-icon">
            <i class="bi bi-people"></i>
        </span>

        <span>Customers &amp; Inventory</span>

    </div>


    <div class="row g-3">


        <!-- Total Customers -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-blue">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Customers
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Total Customers
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalCustomers
                </div>

            </div>

        </div>


        <!-- New Customers -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-green">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        This month
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    New This Month
                </div>

                <div class="dashboard-stat-value">
                    @Model.NewCustomersThisMonth
                </div>

            </div>

        </div>


        <!-- Low Stock -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-warning">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        Inventory
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Low Stock Products
                </div>

                <div class="dashboard-stat-value text-warning">
                    @Model.LowStockCount
                </div>

            </div>

        </div>


        <!-- Total Returns -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="dashboard-stat-card dashboard-stat-purple">

                <div class="dashboard-stat-top">

                    <div class="dashboard-stat-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <span class="dashboard-stat-mini-label">
                        All time
                    </span>

                </div>

                <div class="dashboard-stat-label">
                    Total Returns
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalReturns
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================
         TRENDS
         ======================================================== -->

    <div class="dashboard-section-title">

        <span class="dashboard-section-icon">
            <i class="bi bi-bar-chart-line"></i>
        </span>

        <span>Trends</span>

    </div>


    <div class="row g-3">


        <!-- Sales By Day -->

        <div class="col-12 col-xl-6">

            <div class="dashboard-chart-card">

                <div class="dashboard-card-header">

                    <div>

                        <div class="dashboard-card-title">
                            Sales by Day
                        </div>

                        <div class="dashboard-card-subtitle">
                            Last 30 days
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-blue">
                        <i class="bi bi-graph-up"></i>
                    </div>

                </div>

                <div class="dashboard-chart-wrap dashboard-line-chart">
                    <canvas id="salesByDayChart"></canvas>
                </div>

            </div>

        </div>


        <!-- Sales By Month -->

        <div class="col-12 col-xl-6">

            <div class="dashboard-chart-card">

                <div class="dashboard-card-header">

                    <div>

                        <div class="dashboard-card-title">
                            Sales by Month
                        </div>

                        <div class="dashboard-card-subtitle">
                            Last 12 months
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-green">
                        <i class="bi bi-calendar3"></i>
                    </div>

                </div>

                <div class="dashboard-chart-wrap dashboard-line-chart">
                    <canvas id="salesByMonthChart"></canvas>
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================
         DONUT CHARTS
         ======================================================== -->

    <div class="row g-3 dashboard-donut-row">


        <!-- Sales By Category -->

        <div class="col-12 col-lg-4">

            <div class="dashboard-chart-card dashboard-donut-card">

                <div class="dashboard-card-header">

                    <div>

                        <div class="dashboard-card-title">
                            Sales by Category
                        </div>

                        <div class="dashboard-card-subtitle">
                            Revenue distribution
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-blue">
                        <i class="bi bi-grid"></i>
                    </div>

                </div>


                <div class="dashboard-donut-wrap">

                    <canvas id="salesByCategoryChart"></canvas>

                </div>


                <div class="dashboard-donut-legend"
                     id="salesByCategoryLegend">
                </div>

            </div>

        </div>


        <!-- Sales By Brand -->

        <div class="col-12 col-lg-4">

            <div class="dashboard-chart-card dashboard-donut-card">

                <div class="dashboard-card-header">

                    <div>

                        <div class="dashboard-card-title">
                            Sales by Brand
                        </div>

                        <div class="dashboard-card-subtitle">
                            Revenue distribution
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-purple">
                        <i class="bi bi-tags"></i>
                    </div>

                </div>


                <div class="dashboard-donut-wrap">

                    <canvas id="salesByBrandChart"></canvas>

                </div>


                <div class="dashboard-donut-legend"
                     id="salesByBrandLegend">
                </div>

            </div>

        </div>


        <!-- Orders By Status -->

        <div class="col-12 col-lg-4">

            <div class="dashboard-chart-card dashboard-donut-card">

                <div class="dashboard-card-header">

                    <div>

                        <div class="dashboard-card-title">
                            Orders by Status
                        </div>

                        <div class="dashboard-card-subtitle">
                            Current order distribution
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-warning">
                        <i class="bi bi-pie-chart"></i>
                    </div>

                </div>


                <div class="dashboard-donut-wrap">

                    <canvas id="ordersByStatusChart"></canvas>

                </div>


                <div class="dashboard-donut-legend"
                     id="ordersByStatusLegend">
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================
         CUSTOMER GROWTH
         ======================================================== -->

    <div class="dashboard-chart-card dashboard-customer-growth">

        <div class="dashboard-card-header">

            <div>

                <div class="dashboard-card-title">
                    Customer Growth
                </div>

                <div class="dashboard-card-subtitle">
                    Total customers — last 12 months
                </div>

            </div>

            <div class="dashboard-card-icon dashboard-card-icon-green">
                <i class="bi bi-person-plus"></i>
            </div>

        </div>


        <div class="dashboard-growth-chart-wrap">

            <canvas id="customerGrowthChart"></canvas>

        </div>

    </div>


    <!-- ========================================================
         TOP PRODUCTS / TOP BRANDS
         ======================================================== -->

    <div class="row g-3 dashboard-top-tables">


        <!-- TOP PRODUCTS -->

        <div class="col-12 col-xl-6">

            <div class="dashboard-table-card">

                <div class="dashboard-table-header">

                    <div>

                        <div class="dashboard-card-title">
                            Top Products
                        </div>

                        <div class="dashboard-card-subtitle">
                            Best performing products
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-blue">
                        <i class="bi bi-award"></i>
                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table dashboard-data-table mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Product
                                </th>

                                <th class="text-end">
                                    Units
                                </th>

                                <th class="text-end">
                                    Revenue
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.TopProducts.Any())
                            {
                                foreach (var p in Model.TopProducts)
                                {
                                    <tr>

                                        <td>

                                            <div class="dashboard-product-name">

                                                <span class="dashboard-table-avatar">
                                                    <i class="bi bi-box"></i>
                                                </span>

                                                <span>
                                                    @p.ProductName
                                                </span>

                                            </div>

                                        </td>

                                        <td class="text-end font-mono">
                                            @p.UnitsSold
                                        </td>

                                        <td class="text-end font-mono dashboard-revenue">
                                            @p.Revenue.ToPkr()
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="3">

                                        <div class="dashboard-table-empty">

                                            <i class="bi bi-bar-chart"></i>

                                            <span>
                                                No sales data yet.
                                            </span>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- TOP BRANDS -->

        <div class="col-12 col-xl-6">

            <div class="dashboard-table-card">

                <div class="dashboard-table-header">

                    <div>

                        <div class="dashboard-card-title">
                            Top Brands
                        </div>

                        <div class="dashboard-card-subtitle">
                            Best performing brands
                        </div>

                    </div>

                    <div class="dashboard-card-icon dashboard-card-icon-purple">
                        <i class="bi bi-tags"></i>
                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table dashboard-data-table mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Brand
                                </th>

                                <th class="text-end">
                                    Units
                                </th>

                                <th class="text-end">
                                    Revenue
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.TopBrands.Any())
                            {
                                foreach (var b in Model.TopBrands)
                                {
                                    <tr>

                                        <td>

                                            <div class="dashboard-product-name">

                                                <span class="dashboard-table-avatar dashboard-table-avatar-purple">
                                                    <i class="bi bi-tag"></i>
                                                </span>

                                                <span>
                                                    @b.BrandName
                                                </span>

                                            </div>

                                        </td>

                                        <td class="text-end font-mono">
                                            @b.UnitsSold
                                        </td>

                                        <td class="text-end font-mono dashboard-revenue">
                                            @b.Revenue.ToPkr()
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="3">

                                        <div class="dashboard-table-empty">

                                            <i class="bi bi-tags"></i>

                                            <span>
                                                No sales data yet.
                                            </span>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>


</div>


<!-- ============================================================
     DASHBOARD-SPECIFIC STYLES
     ============================================================ -->

<style>

    /* ========================================================
           DASHBOARD PAGE / GLOBAL SPACING
           ======================================================== */

    .dashboard-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
    }


        /*
           The dashboard itself should not introduce an
           additional top gap.
        */

        .dashboard-page > .page-header {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }


        /*
           Keep Bootstrap rows from creating unwanted
           additional top spacing.
        */

        .dashboard-page > .row {
            margin-top: 0;
        }


        .dashboard-page .row {
            --bs-gutter-y: 1rem;
        }


        /*
           Compact spacing between major dashboard sections.
        */

        .dashboard-page .dashboard-section-title {
            margin-top: 18px;
            margin-bottom: 10px;
        }


            /*
           First dashboard section should sit close to header.
        */

            .dashboard-page .dashboard-section-title:first-of-type {
                margin-top: 12px;
            }


        /*
           Chart/table cards should not stretch vertically
           because of inherited layout rules.
        */

        .dashboard-page .dashboard-chart-card,
        .dashboard-page .dashboard-table-card {
            min-height: 0;
        }


        /*
           Customer growth card should remain compact.
        */

        .dashboard-page .dashboard-customer-growth {
            min-height: 0;
            height: auto;
            margin-top: 16px;
        }


        /*
           Keep final tables from creating a huge bottom gap.
        */

        .dashboard-page .dashboard-top-tables {
            margin-top: 16px;
            margin-bottom: 16px;
        }


    /* ========================================================
           SECTION TITLES
           ======================================================== */

    .dashboard-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        margin-bottom: 10px;
        color: var(--admin-text-muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .55px;
    }


    .dashboard-section-icon {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: var(--admin-blue-soft);
        color: var(--admin-blue);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }


        .dashboard-section-icon i {
            font-size: 14px;
            line-height: 1;
        }


    /* ========================================================
           ATTENTION
           ======================================================== */

    .dashboard-attention {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 15px;
        margin-bottom: 16px;
        background: var(--admin-warning-soft);
        border: 1px solid #F0DDBD;
        border-radius: var(--admin-radius);
    }


    .dashboard-attention-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #fff;
        color: var(--admin-warning);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }


        .dashboard-attention-icon i {
            font-size: 15px;
        }


    .dashboard-attention-content {
        min-width: 0;
        flex: 1;
    }


        .dashboard-attention-content > strong {
            display: block;
            font-size: 13px;
            color: var(--admin-text);
            margin-bottom: 7px;
        }


    .dashboard-attention-items {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }


        .dashboard-attention-items .pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }


            .dashboard-attention-items .pill i {
                font-size: 11px;
            }


    /* ========================================================
           STAT CARDS
           ======================================================== */

    .dashboard-stat-card {
        position: relative;
        height: 100%;
        min-height: 132px;
        padding: 15px 16px;
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: var(--admin-radius);
        overflow: hidden;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }


        .dashboard-stat-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: var(--stat-color, var(--admin-blue));
        }


        .dashboard-stat-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(20, 24, 29, .055);
        }


    .dashboard-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 13px;
    }


    .dashboard-stat-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--stat-soft);
        color: var(--stat-color);
    }


        .dashboard-stat-icon i {
            font-size: 15px;
            line-height: 1;
        }


    .dashboard-stat-mini-label {
        color: var(--admin-text-muted);
        font-size: 10.5px;
        font-weight: 600;
