</style>


@section Scripts {

    <!-- ========================================================
         CHART.JS
         ======================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>


    <script>

        /* =====================================================
           DASHBOARD CHART CONFIG
           ===================================================== */

        const dashboardPkr = (value) => {

            return 'Rs ' + Number(value || 0).toLocaleString('en-PK', {
                maximumFractionDigits: 0
            });

        };


        const dashboardPalette = [
            '#2F6FED',
            '#1F9D55',
            '#C08A2E',
            '#E23D3D',
            '#7C5CDB',
            '#6F7781',
            '#14A3A5',
            '#D96C75'
        ];


        const dashboardGridColor = '#ECEEF1';
        const dashboardMutedColor = '#8A9099';
        const dashboardTextColor = '#14181D';


        /* =====================================================
           CHART DEFAULTS
           ===================================================== */

        Chart.defaults.font.family =
            '"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';

        Chart.defaults.font.size = 11;

        Chart.defaults.color = dashboardMutedColor;

        Chart.defaults.animation.duration = 500;


        /* =====================================================
           LINE CHART
           ===================================================== */

        function dashboardLineChart(
            id,
            labels,
            data,
            label
        ) {

            const canvas =
                document.getElementById(id);

            if (!canvas) {
                return;
            }


            new Chart(canvas, {

                type: 'line',

                data: {

                    labels: labels || [],

                    datasets: [

                        {

                            label: label,

                            data: data || [],

                            borderColor: '#2F6FED',

                            backgroundColor:
                                'rgba(47,111,237,0.07)',

                            fill: true,

                            tension: 0.35,

                            borderWidth: 2,

                            pointRadius: 0,

                            pointHoverRadius: 4,

                            pointHoverBackgroundColor: '#2F6FED',

                            pointHoverBorderColor: '#FFFFFF',

                            pointHoverBorderWidth: 2

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    interaction: {

                        intersect: false,

                        mode: 'index'

                    },

                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

                            backgroundColor: '#14181D',

                            titleColor: '#FFFFFF',

                            bodyColor: '#FFFFFF',

                            padding: 10,

                            cornerRadius: 8,

                            displayColors: false,

                            callbacks: {

                                label: function(context) {

                                    return ' ' +
                                        dashboardPkr(context.parsed.y);

                                }

                            }

                        }

                    },

                    scales: {

                        x: {

                            border: {
                                display: false
                            },

                            grid: {

                                display: false

                            },

                            ticks: {

                                color: dashboardMutedColor,

                                maxRotation: 0,

                                autoSkip: true,

                                maxTicksLimit: 8,

                                font: {

                                    size: 10

                                }

                            }

                        },

                        y: {

                            beginAtZero: true,

                            border: {

                                display: false

                            },

                            grid: {

                                color: dashboardGridColor,

                                drawTicks: false

                            },

                            ticks: {

                                color: dashboardMutedColor,

                                padding: 8,

                                font: {

                                    size: 10

                                },

                                callback: function(value) {

                                    return dashboardPkr(value);

                                }

                            }

                        }

                    }

                }

            });

        }


        /* =====================================================
           BAR CHART
           ===================================================== */

        function dashboardBarChart(
            id,
            labels,
            data,
            label
        ) {

            const canvas =
                document.getElementById(id);

            if (!canvas) {
                return;
            }


            new Chart(canvas, {

                type: 'bar',

                data: {

                    labels: labels || [],

                    datasets: [

                        {

                            label: label,

                            data: data || [],

                            backgroundColor: '#2F6FED',

                            borderColor: '#2F6FED',

                            borderWidth: 0,

                            borderRadius: 5,

                            borderSkipped: false,

                            maxBarThickness: 34

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

                            backgroundColor: '#14181D',

                            titleColor: '#FFFFFF',

                            bodyColor: '#FFFFFF',

                            padding: 10,

                            cornerRadius: 8,

                            displayColors: false,

                            callbacks: {

                                label: function(context) {

                                    return ' ' +
                                        Number(
                                            context.parsed.y || 0
                                        ).toLocaleString('en-PK');

                                }

                            }

                        }

                    },

                    scales: {

                        x: {

                            border: {

                                display: false

                            },

                            grid: {

                                display: false

                            },

                            ticks: {

                                color: dashboardMutedColor,

                                maxRotation: 0,

                                autoSkip: true,

                                maxTicksLimit: 12,

                                font: {

                                    size: 10

                                }

                            }

                        },

                        y: {

                            beginAtZero: true,

                            border: {

                                display: false

                            },

                            grid: {

                                color: dashboardGridColor,

                                drawTicks: false

                            },

                            ticks: {

                                color: dashboardMutedColor,

                                padding: 8,

                                font: {

                                    size: 10

                                }

                            }

                        }

                    }

                }

            });

        }


        /* =====================================================
           DOUGHNUT CHART
           ===================================================== */

        function dashboardDonutChart(
            id,
            labels,
            data,
            legendElementId
        ) {

            const canvas =
                document.getElementById(id);

            if (!canvas) {
                return;
            }


            const safeLabels =
                labels || [];


            const safeData =
                (data || []).map(
                    value => Number(value || 0)
                );


            new Chart(canvas, {

                type: 'doughnut',

                data: {

                    labels: safeLabels,

                    datasets: [

                        {

                            data: safeData,

                            backgroundColor:
                                dashboardPalette,

                            borderWidth: 2,

                            borderColor: '#FFFFFF',

                            hoverOffset: 4

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: '72%',

                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

                            backgroundColor: '#14181D',

                            titleColor: '#FFFFFF',

                            bodyColor: '#FFFFFF',

                            padding: 9,

                            cornerRadius: 8,

                            callbacks: {

                                label: function(context) {

                                    const total =
                                        safeData.reduce(
                                            (sum, value) =>
                                                sum + value,
                                            0
                                        ) || 1;


                                    const value =
                                        Number(
                                            context.raw || 0
                                        );


                                    const percentage =
                                        Math.round(
                                            (value / total) * 100
                                        );


                                    return ' ' +
                                        context.label +
                                        ': ' +
                                        percentage +
                                        '%';

                                }

                            }

                        }

                    }

                }

            });


            const legendElement =
                document.getElementById(legendElementId);

            if (!legendElement) {
                return;
            }


            const total =
                safeData.reduce(
                    (sum, value) =>
                        sum + value,
                    0
                ) || 1;


            if (!safeLabels.length) {

                legendElement.innerHTML = `
                            <div class="dashboard-table-empty">
                                <i class="bi bi-bar-chart"></i>
                                <span>No data available.</span>
                            </div>
                        `;

                return;

            }


            legendElement.innerHTML =
                safeLabels.map(
                    (labelText, index) => {

                        const percentage =
                            Math.round(
                                (
                                    safeData[index] /
                                    total
                                ) * 100
                            );


                        return `

                                    <div class="dashboard-donut-legend-row">

                                        <div class="dashboard-donut-legend-label">

                                            <span
                                                class="dashboard-donut-legend-dot"
                                                style="
                                                    background:
                                                    ${dashboardPalette[
                            index %
                            dashboardPalette.length
                            ]};
                                                ">
                                            </span>

                                            <span
                                                class="dashboard-donut-legend-label-text">
                                                ${labelText}
                                            </span>

                                        </div>

                                        <span class="dashboard-donut-legend-value">
                                            ${percentage}%
                                        </span>

                                    </div>

                                `;

                    }
                ).join('');

        }


        /* =====================================================
           CHART DATA
           ===================================================== */

        const salesByDayLabels =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByDay.Select(x => x.Label)
    ));


        const salesByDayData =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByDay.Select(x => x.Value)
    ));


        const salesByMonthLabels =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByMonth.Select(x => x.Label)
    ));


        const salesByMonthData =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByMonth.Select(x => x.Value)
    ));


        const salesByCategoryLabels =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByCategory.Select(x => x.Label)
    ));


        const salesByCategoryData =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByCategory.Select(x => x.Value)
    ));


        const salesByBrandLabels =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByBrand.Select(x => x.Label)
    ));


        const salesByBrandData =
                    @Html.Raw(Json.Serialize(
                            Model.SalesByBrand.Select(x => x.Value)
    ));


        const ordersByStatusLabels =
                    @Html.Raw(Json.Serialize(
                            Model.OrdersByStatus.Select(x => x.Label)
    ));


        const ordersByStatusData =
                    @Html.Raw(Json.Serialize(
                            Model.OrdersByStatus.Select(x => x.Value)
    ));


        const customerGrowthLabels =
                    @Html.Raw(Json.Serialize(
                            Model.CustomerGrowth.Select(x => x.Label)
    ));


        const customerGrowthData =
                    @Html.Raw(Json.Serialize(
                            Model.CustomerGrowth.Select(x => x.Value)
    ));


        /* =====================================================
           INITIALIZE CHARTS
           ===================================================== */

        dashboardLineChart(
            'salesByDayChart',
            salesByDayLabels,
            salesByDayData,
            'Sales'
        );


        dashboardLineChart(
            'salesByMonthChart',
            salesByMonthLabels,
            salesByMonthData,
            'Sales'
        );


        dashboardDonutChart(
            'salesByCategoryChart',
            salesByCategoryLabels,
            salesByCategoryData,
            'salesByCategoryLegend'
        );


        dashboardDonutChart(
            'salesByBrandChart',
            salesByBrandLabels,
            salesByBrandData,
            'salesByBrandLegend'
        );


        dashboardDonutChart(
            'ordersByStatusChart',
            ordersByStatusLabels,
            ordersByStatusData,
            'ordersByStatusLegend'
        );


        dashboardBarChart(
            'customerGrowthChart',
            customerGrowthLabels,
            customerGrowthData,
            'Total Customers'
        );

    </script>
}