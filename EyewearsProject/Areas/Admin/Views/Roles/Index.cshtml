@model List<EyewearsProject.Models.ApplicationRole>
@using EyewearsProject.Areas.Admin

@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Roles</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Role</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td class="text-muted">@(role.Description ?? "—")</td>
                <td class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary">Edit</a>

                    @if (role.Name != AdminRoles.SuperAdmin && role.Name != AdminRoles.Admin)
                    {
                        <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                              onsubmit="return confirm('Delete role @role.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small align-self-center">Protected</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>