@model List<InventoryItemViewModel>

<div class="mb-4">
    <h3 class="mb-1">Inventory</h3>
    <p class="text-muted mb-0">Stock levels across all product variants. On-hand, reserved (held by unconfirmed orders), and available (what's actually sellable).</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card p-3">
            <small class="text-muted text-uppercase">Out of Stock</small>
            <h2 class="mb-0 text-danger">@ViewBag.TotalOutOfStock</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <small class="text-muted text-uppercase">Low Stock (&le; reorder level)</small>
            <h2 class="mb-0 text-warning">@ViewBag.TotalLowStock</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <form method="get" class="row g-2 align-items-center h-100">
                <div class="col-md-6">
                    <input type="text" name="search" class="form-control" placeholder="Search product or SKU..." value="@ViewBag.CurrentSearch" />
                </div>
                <div class="col-md-4">
                    <select name="stockFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Stock</option>
                        <option value="low" selected="@("low" == (string)ViewBag.CurrentFilter)">Low Stock</option>
                        <option value="out" selected="@("out" == (string)ViewBag.CurrentFilter)">Out of Stock</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100">Go</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table class="table table-bordered bg-white align-middle">
    <thead>
        <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Color</th>
            <th>Size</th>
            <th>On Hand</th>
            <th>Reserved</th>
            <th>Available</th>
            <th style="width:260px;">Adjust</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.ProductName</td>
                <td>@v.Sku</td>
                <td>@v.Color</td>
                <td>@(v.Size ?? "-")</td>
                <td>@v.QuantityOnHand</td>
                <td>@v.ReservedQuantity</td>
                <td>
                    @if (v.AvailableQuantity <= 0)
                    {
                        <span class="badge bg-danger">Out of stock</span>
                    }
                    else if (v.AvailableQuantity <= v.ReorderLevel)
                    {
                        <span class="badge bg-warning text-dark">@v.AvailableQuantity left</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@v.AvailableQuantity available</span>
                    }
                </td>
                <td>
                    <form asp-action="AdjustStock" method="post" class="d-flex gap-1">
                        <input type="hidden" name="variantId" value="@v.VariantId" />
                        <input type="hidden" name="stockFilter" value="@ViewBag.CurrentFilter" />
                        <input type="hidden" name="search" value="@ViewBag.CurrentSearch" />
                        <input type="number" name="newQuantityOnHand" value="@v.QuantityOnHand" min="0" class="form-control form-control-sm" style="width:80px;" />
                        <input type="text" name="reason" placeholder="reason" class="form-control form-control-sm" style="width:100px;" />
                        <button class="btn btn-sm btn-outline-primary">Update</button>
                    </form>
                </td>
                <td>
                    <a asp-action="History" asp-route-variantId="@v.VariantId" class="btn btn-sm btn-outline-secondary">History</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No variants match this filter.</p>
}