<script>
    document.addEventListener("DOMContentLoaded", function () {

        const tagsContainer =
            document.getElementById("tagsContainer");

        const tagInput =
            document.getElementById("tagInput");


        tagInput.addEventListener("keydown", function (e) {

            if (e.key !== "Enter")
                return;

            e.preventDefault();

            const tag =
                tagInput.value.trim();

            if (!tag)
                return;


            // Prevent duplicate tags
            const existingTags =
                Array.from(
                    tagsContainer.querySelectorAll(
                        'input[name="Tags"]'
                    )
                ).map(input =>
                    input.value.toLowerCase()
                );

            if (existingTags.includes(tag.toLowerCase())) {

                tagInput.value = "";

                return;
            }


            const tagItem =
                document.createElement("div");

            tagItem.className =
                "tag-item";


            tagItem.innerHTML = `

                <input type="hidden"
                       name="Tags"
                       value="${escapeHtml(tag)}" />

                <span class="badge rounded-pill bg-light text-dark border">

                    ${escapeHtml(tag)}

                    <button type="button"
                            class="btn-close ms-1 remove-tag"
                            aria-label="Remove tag"
                            style="font-size: 8px;">
                    </button>

                </span>
            `;


            tagsContainer.insertBefore(
                tagItem,
                tagInput
            );


            tagInput.value = "";

            tagInput.focus();
        });


        tagsContainer.addEventListener("click", function (e) {

            const removeButton =
                e.target.closest(".remove-tag");

            if (!removeButton)
                return;

            const tagItem =
                removeButton.closest(".tag-item");

            if (tagItem)
                tagItem.remove();

        });


        function escapeHtml(value) {

            const div =
                document.createElement("div");

            div.textContent = value;

            return div.innerHTML;
        }

    });
</script>

