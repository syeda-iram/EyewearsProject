@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <form id="tryOnAntiforgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <script>

        const tryOnFileInput =
            document.getElementById('tryOnFileInput');

        const tryOnUrlInput =
            document.getElementById('TryOnOverlayImageUrl');

        const tryOnPreview =
            document.getElementById('tryOnPreview');

        const tryOnToken =
            document.querySelector(
                '#tryOnAntiforgeryForm input[name="__RequestVerificationToken"]'
            )?.value;


        /*
         * Keep the existing image upload functionality.
         */

        if (tryOnFileInput) {

            tryOnFileInput.addEventListener(
                'change',
                function () {

                    if (!this.files ||
                        this.files.length === 0) {
                        return;
                    }

                    /*
                     * Existing project upload helper.
                     * This keeps your current upload workflow.
                     */

                    if (typeof wireImageUpload === 'function') {

                        wireImageUpload(
                            'tryOnFileInput',
                            'TryOnOverlayImageUrl',
                            'tryOnPreview',
                            '@Url.Action("Image", "Upload", new { area = "Admin" })',
                            tryOnToken
                        );

                    }

                }
            );

        }


        /*
         * Preview when URL is manually changed.
         */

        if (tryOnUrlInput) {

            tryOnUrlInput.addEventListener(
                'change',
                function () {

                    const url = this.value.trim();

                    if (!url) {

                        tryOnPreview.classList.add('d-none');
                        tryOnPreview.removeAttribute('src');

                        return;
                    }

                    tryOnPreview.src = url;
                    tryOnPreview.classList.remove('d-none');

                }
            );

        }

    </script>

    <script>

    document.addEventListener("DOMContentLoaded", function () {

        const variantsBody =
            document.getElementById("variantsBody");

        const addVariantBtn =
            document.getElementById("addVariantBtn");


        // =====================================================
        // EDIT VARIANT
        // =====================================================

        variantsBody.addEventListener("click", function (event) {

            const editButton =
                event.target.closest(".variant-edit-btn");

            if (!editButton)
                return;

            const row =
                editButton.closest(".variant-row");

            const fields =
                row.querySelectorAll(".variant-edit-field");

            const isEditing =
                row.classList.contains("editing");

            if (!isEditing) {

                fields.forEach(function (field) {
                    field.disabled = false;
                });

                row.classList.add("editing");

                editButton.innerHTML =
                    '<i class="bi bi-check-lg"></i>';

                editButton.title =
                    "Done";

            }
            else {

                fields.forEach(function (field) {
                    field.disabled = true;
                });

                row.classList.remove("editing");

                editButton.innerHTML =
                    '<i class="bi bi-pencil"></i>';

                editButton.title =
                    "Edit Variant";
            }

        });


        // =====================================================
        // DELETE VARIANT
        // =====================================================

        variantsBody.addEventListener("click", function (event) {

            const deleteButton =
                event.target.closest(".variant-delete-btn");

            if (!deleteButton)
                return;

            const row =
                deleteButton.closest(".variant-row");

            if (!row)
                return;

            const variantIdInput =
                row.querySelector(
                    'input[name$=".Id"]'
                );

            const variantId =
                variantIdInput
                    ? parseInt(variantIdInput.value || "0")
                    : 0;


            // Existing variant
            if (variantId > 0) {

                const confirmed =
                    confirm(
                        "Are you sure you want to remove this variant?"
                    );

                if (!confirmed)
                    return;
            }


            row.remove();

            reindexVariants();

        });


        // =====================================================
        // ADD VARIANT
        // =====================================================

        addVariantBtn.addEventListener("click", function () {

            const row =
                document.createElement("tr");

            row.className =
                "variant-row editing";

            row.innerHTML = `

                <input type="hidden"
                       name="Variants[0].Id"
                       value="0" />

                <td>
                    <input type="text"
                           class="form-control variant-edit-field"
                           name="Variants[0].Color"
                           placeholder="e.g. Black" />
                </td>

                <td>
                    <select class="form-select variant-edit-field"
                            name="Variants[0].Size">

                        <option value="">
                            -- Select --
                        </option>

                        <option value="Small">
                            Small
                        </option>

                        <option value="Medium">
                            Medium
                        </option>

                        <option value="Large">
                            Large
                        </option>

                        <option value="XL">
                            XL
                        </option>

                    </select>
                </td>

                <td>
                    <input type="text"
                           class="form-control variant-edit-field"
                           name="Variants[0].Sku"
                           placeholder="Variant SKU" />
                </td>

                <td>
                    <input type="number"
                           class="form-control"
                           name="Variants[0].StockQuantity"
                           value="0"
                           min="0" />
                </td>

                <td>
                    <div class="d-flex justify-content-center gap-2">

                        <button type="button"
                                class="btn btn-sm btn-outline-primary variant-edit-btn"
                                title="Done">

                            <i class="bi bi-check-lg"></i>

                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger variant-delete-btn"
                                title="Delete Variant">

                            <i class="bi bi-trash"></i>

                        </button>

                    </div>
                </td>
            `;

            variantsBody.appendChild(row);

            reindexVariants();

            const firstInput =
                row.querySelector(
                    'input[name$=".Color"]'
                );

            if (firstInput)
                firstInput.focus();

        });


        // =====================================================
        // REINDEX VARIANT INPUTS
        // =====================================================

        function reindexVariants() {

            const rows =
                variantsBody.querySelectorAll(".variant-row");

            rows.forEach(function (row, index) {

                row.querySelectorAll(
                    "input, select"
                ).forEach(function (input) {

                    const name =
                        input.getAttribute("name");

                    if (!name)
                        return;

                    input.setAttribute(
                        "name",
                        name.replace(
                            /Variants\[\d+\]/,
                            `Variants[${index}]`
                        )
                    );

                });

            });

        }

    });

</script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const container =
            document.getElementById(
                "productImagesContainer"
            );

        const uploadBox =
            document.getElementById(
                "uploadMoreImages"
            );

        const fileInput =
            document.getElementById(
                "productImagesInput"
            );


        // =====================================================
        // UPLOAD MORE
        // =====================================================

        uploadBox.addEventListener(
            "click",
            function () {

                fileInput.click();

            }
        );


        fileInput.addEventListener(
            "change",
            async function () {

                const files =
                    Array.from(fileInput.files);

                if (!files.length)
                    return;


                for (const file of files) {

                    await uploadImage(file);

                }


                fileInput.value = "";

                updateImageIndexes();

            }
        );


        // =====================================================
        // UPLOAD IMAGE
        // =====================================================

        async function uploadImage(file) {

            const formData =
                new FormData();

            formData.append(
                "file",
                file
            );


            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;


            const response =
                await fetch(
                    '@Url.Action("Image", "Upload", new { area = "Admin" })',
                    {
                        method: "POST",

                        headers: {
                            "RequestVerificationToken":
                                token
                        },

                        body: formData
                    }
                );


            if (!response.ok) {

                alert(
                    "Image upload failed."
                );

                return;

            }


            const result =
                await response.json();


            if (!result.url) {

                alert(
                    "Image upload failed."
                );

                return;

            }


            addImageToList(
                result.url
            );

        }


        // =====================================================
        // ADD IMAGE TO UI
        // =====================================================

        function addImageToList(imageUrl) {

            const item =
                document.createElement(
                    "div"
                );

            item.className =
                "product-image-item";

            item.draggable = true;


            item.innerHTML = `

                <input type="hidden"
                       class="image-id"
                       value="0" />

                <input type="hidden"
                       class="image-url"
                       value="${escapeHtml(imageUrl)}" />

                <input type="hidden"
                       class="image-variant-id"
                       value="" />

                <input type="hidden"
                       class="image-sort-order"
                       value="0" />

                <input type="hidden"
                       class="image-primary"
                       value="false" />


                <div class="product-image-preview">

                    <img src="${escapeHtml(imageUrl)}"
                         alt="Product image" />

                    <button type="button"
                            class="image-remove-btn"
                            title="Remove image">

                        <i class="bi bi-x"></i>

                    </button>

                </div>
            `;


            container.insertBefore(
                item,
                uploadBox
            );


            updateImageIndexes();

        }


        // =====================================================
        // REMOVE IMAGE
        // =====================================================

        container.addEventListener(
            "click",
            function (event) {

                const removeButton =
                    event.target.closest(
                        ".image-remove-btn"
                    );

                if (!removeButton)
                    return;


                const item =
                    removeButton.closest(
                        ".product-image-item"
                    );

                if (!item)
                    return;


                item.remove();


                updateImageIndexes();

            }
        );


        // =====================================================
        // DRAG & DROP
        // =====================================================

        let draggedItem = null;


        container.addEventListener(
            "dragstart",
            function (event) {

                const item =
                    event.target.closest(
                        ".product-image-item"
                    );

                if (!item)
                    return;


                draggedItem = item;

                item.classList.add(
                    "dragging"
                );

            }
        );


        container.addEventListener(
            "dragend",
            function (event) {

                const item =
                    event.target.closest(
                        ".product-image-item"
                    );

                if (!item)
                    return;


                item.classList.remove(
                    "dragging"
                );

                draggedItem = null;

                updateImageIndexes();

            }
        );


        container.addEventListener(
            "dragover",
            function (event) {

                event.preventDefault();


                const target =
                    event.target.closest(
                        ".product-image-item"
                    );


                if (!target ||
                    !draggedItem ||
                    target === draggedItem)
                    return;


                const rect =
                    target.getBoundingClientRect();


                const middle =
                    rect.left +
                    rect.width / 2;


                if (event.clientX < middle) {

                    container.insertBefore(
                        draggedItem,
                        target
                    );

                }
                else {

                    container.insertBefore(
                        draggedItem,
                        target.nextSibling
                    );

                }

            }
        );


        // =====================================================
        // UPDATE INDEXES
        // FIRST IMAGE = PRIMARY
        // =====================================================

        function updateImageIndexes() {

            const items =
                container.querySelectorAll(
                    ".product-image-item"
                );


            items.forEach(
                function (item, index) {

                    const idInput =
                        item.querySelector(
                            ".image-id"
                        );

                    const urlInput =
                        item.querySelector(
                            ".image-url"
                        );

                    const variantInput =
                        item.querySelector(
                            ".image-variant-id"
                        );

                    const sortInput =
                        item.querySelector(
                            ".image-sort-order"
                        );

                    const primaryInput =
                        item.querySelector(
                            ".image-primary"
                        );


                    if (idInput) {

                        idInput.name =
                            `ExistingImages[${index}].Id`;

                    }


                    if (urlInput) {

                        urlInput.name =
                            `ExistingImages[${index}].ImageUrl`;

                    }


                    if (variantInput) {

                        variantInput.name =
                            `ExistingImages[${index}].ProductVariantId`;

                    }


                    if (sortInput) {

                        sortInput.name =
                            `ExistingImages[${index}].SortOrder`;

                        sortInput.value =
                            index;

                    }


                    if (primaryInput) {

                        primaryInput.name =
                            `ExistingImages[${index}].IsPrimary`;

                        primaryInput.value =
                            index === 0
                                ? "true"
                                : "false";

                    }


                    // Remove old badge

                    const oldBadge =
                        item.querySelector(
                            ".image-primary-badge"
                        );

                    if (oldBadge)
                        oldBadge.remove();


                    // First image = Primary

                    if (index === 0) {

                        const preview =
                            item.querySelector(
                                ".product-image-preview"
                            );

                        if (preview) {

                            const badge =
                                document.createElement(
                                    "span"
                                );

                            badge.className =
                                "image-primary-badge";

                            badge.innerText =
                                "Primary";

                            preview.appendChild(
                                badge
                            );

                        }

                    }

                }
            );

        }


        // =====================================================
        // HTML ESCAPE
        // =====================================================

        function escapeHtml(value) {

            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        // Initial state

        updateImageIndexes();

    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const container =
            document.getElementById("specificationsContainer");

        const addButton =
            document.getElementById("addSpecificationBtn");


        function updateSpecificationIndexes() {

            const rows =
                container.querySelectorAll(".specification-row");

            rows.forEach((row, index) => {

                row.querySelectorAll("input").forEach(input => {

                    if (input.name.includes(".Id")) {
                        input.name =
                            `Specifications[${index}].Id`;
                    }

                    else if (input.name.includes(".Name")) {
                        input.name =
                            `Specifications[${index}].Name`;
                    }

                    else if (input.name.includes(".Value")) {
                        input.name =
                            `Specifications[${index}].Value`;
                    }

                    else if (input.name.includes(".SortOrder")) {
                        input.name =
                            `Specifications[${index}].SortOrder`;

                        input.value = index;
                    }

                });

            });
        }


        addButton.addEventListener("click", function () {

            const index =
                container.querySelectorAll(".specification-row").length;

            const row =
                document.createElement("div");

            row.className =
                "specification-row mb-2";

            row.innerHTML = `

                <input type="hidden"
                       name="Specifications[${index}].Id"
                       value="0" />

                <input type="hidden"
                       name="Specifications[${index}].SortOrder"
                       value="${index}"
                       class="spec-sort-order" />

                <div class="row g-2">

                    <div class="col-md-5">
                        <input type="text"
                               name="Specifications[${index}].Name"
                               class="form-control"
                               placeholder="Specification name" />
                    </div>

                    <div class="col-md-5">
                        <input type="text"
                               name="Specifications[${index}].Value"
                               class="form-control"
                               placeholder="Value" />
                    </div>

                    <div class="col-md-2">
                        <button type="button"
                                class="btn btn-outline-danger remove-specification"
                                title="Remove Specification"
                                style="width: 42px; height: 42px; padding: 0; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>

                </div>
            `;

            container.appendChild(row);

            updateSpecificationIndexes();
        });


        container.addEventListener("click", function (e) {

            if (!e.target.classList.contains(
                "remove-specification")) {
                return;
            }

            const row =
                e.target.closest(".specification-row");

            if (row) {
                row.remove();
                updateSpecificationIndexes();
            }

        });

    });
</script>

