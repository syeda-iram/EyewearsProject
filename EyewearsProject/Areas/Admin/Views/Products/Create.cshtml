@model ProductFormViewModel

@{
    ViewData["Title"] = "Create Product — {Model.Name}";
}

<div class="product-edit-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="product-edit-header">

        <div>
            <h3 class="product-edit-title">
                Create Product — @Model.Name (@Model.Sku)
            </h3>
        </div>

        <div class="product-edit-header-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <button type="button"
                    class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i>
                Preview
            </button>

            <button type="submit"
                    form="editProductForm"
                    class="btn btn-primary">
                <i class="bi bi-save"></i>
                Save Changes
            </button>

        </div>

    </div>


    <!-- =========================================================
         MAIN FORM
         ========================================================= -->

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          id="editProductForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- =====================================================
             TWO COLUMN LAYOUT
             ===================================================== -->

        <div class="product-edit-grid">


            <!-- =================================================
                 LEFT COLUMN
                 ================================================= -->

            <div class="product-edit-left">


                <!-- =============================================
                     BASIC INFORMATION
                     ============================================= -->

                <div class="product-card">

                    <div class="product-card-header">
                        <div class="section-icon">
                            <i class="bi bi-box"></i>
                        </div>

                        <h5>Basic Information</h5>
                    </div>


                    <div class="product-card-body">

                        <!-- Row 1 -->

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label asp-for="Name"
                                       class="form-label">
                                    Product Name
                                    <span class="required">*</span>
                                </label>

                                <input asp-for="Name"
                                       class="form-control" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Sku"
                                       class="form-label">
                                    SKU
                                    <span class="required">*</span>
                                </label>

                                <input asp-for="Sku"
                                       class="form-control" />

                                <span asp-validation-for="Sku"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Category
                                    <span class="required">*</span>
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select"
                                        asp-items="ViewBag.Categories">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Row 2 -->

                        <div class="row g-3 mt-0">

                            <div class="col-md-4">

                                <label asp-for="SubCategoryId"
                                       class="form-label">
                                    Subcategory
                                </label>

                                <select asp-for="SubCategoryId"
                                        class="form-select"
                                        asp-items="ViewBag.SubCategories">

                                    <option value="">
                                        -- Select Subcategory --
                                    </option>

                                </select>

                                <span asp-validation-for="SubCategoryId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="BrandId"
                                       class="form-label">
                                    Brand
                                </label>

                                <select asp-for="BrandId"
                                        class="form-select"
                                        asp-items="ViewBag.Brands">

                                    <option value="">
                                        -- No Brand --
                                    </option>

                                </select>

                                <span asp-validation-for="BrandId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Gender"
                                       class="form-label">
                                    Gender
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">

                                    <option value="">
                                        -- Select Gender --
                                    </option>

                                    <option value="Men">
                                        Men
                                    </option>

                                    <option value="Women">
                                        Women
                                    </option>

                                    <option value="Unisex">
                                        Unisex
                                    </option>

                                    <option value="Kids">
                                        Kids
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Row 3 -->

                        <div class="row g-3 mt-0">

                            <div class="col-md-4">

                                <label asp-for="Material"
                                       class="form-label">
                                    Material
                                </label>

                                <input asp-for="Material"
                                       class="form-control"
                                       placeholder="e.g. Acetate, Titanium, Nylon" />

                                <span asp-validation-for="Material"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Shape"
                                       class="form-label">
                                    Shape
                                </label>

                                <select asp-for="Shape"
                                        class="form-select">

                                    <option value="">
                                        -- Select Shape --
                                    </option>

                                    <option value="Round">
                                        Round
                                    </option>

                                    <option value="Square">
                                        Square
                                    </option>

                                    <option value="Rectangle">
                                        Rectangle
                                    </option>

                                    <option value="Oval">
                                        Oval
                                    </option>

                                    <option value="Cat Eye">
                                        Cat Eye
                                    </option>

                                    <option value="Aviator">
                                        Aviator
                                    </option>

                                    <option value="Wayfarer">
                                        Wayfarer
                                    </option>

                                    <option value="Geometric">
                                        Geometric
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <span asp-validation-for="Shape"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Description -->

                        <div class="description-section">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                                <span class="required">*</span>
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control product-description"
                                      rows="5"
                                      placeholder="Detailed product description">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


<!-- =====================================================
     PRICING
     ===================================================== -->

<div class="card mb-4">
    <div class="card-body">

        <h5 class="mb-3">
            <i class="bi bi-currency-dollar me-2 text-primary"></i>
            Pricing
        </h5>

        <div class="row g-3">

            <!-- Price -->
            <div class="col-md-4">
                <label asp-for="Price" class="form-label">
                    Price <span class="text-danger">*</span>
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="4800.00" />

                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <!-- Discount Price -->
            <div class="col-md-4">
                <label asp-for="DiscountPrice"
                       class="form-label">
                    Discount Price
                </label>

                <input asp-for="DiscountPrice"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="4100.00" />

                <span asp-validation-for="DiscountPrice"
                      class="text-danger"></span>
            </div>

            <!-- Cost Price -->
            <div class="col-md-4">
                <label asp-for="CostPrice"
                       class="form-label">
                    Cost Price
                </label>

                <input asp-for="CostPrice"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="4200.00" />

                <span asp-validation-for="CostPrice"
                      class="text-danger"></span>
            </div>

            <!-- Weight -->
            <div class="col-md-4">
                <label asp-for="Weight"
                       class="form-label">
                    Weight (g)
                </label>

                <input asp-for="Weight"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="e.g. 24.5" />

                <span asp-validation-for="Weight"
                      class="text-danger"></span>
            </div>

        </div>

    </div>
</div>


<!-- =====================================================
     VARIANTS
     ===================================================== -->

<div class="card mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-1">Variants</h5>
                <p class="text-muted small mb-0">
                    Manage product colors, sizes, SKUs and inventory.
                </p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-2" id="variantsTable">

                <thead>
                    <tr>
                        <th style="width: 25%;">Color</th>
                        <th style="width: 23%;">Size</th>
                        <th style="width: 25%;">SKU</th>
                        <th style="width: 17%;">Stock (Inventory)</th>
                        <th style="width: 10%;" class="text-center">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody id="variantsBody">

                    @if (Model.Variants != null && Model.Variants.Any())
                    {
                        for (int i = 0; i < Model.Variants.Count; i++)
                        {
                            <tr class="variant-row">

                                <!-- Variant ID -->
                                <input type="hidden"
                                       name="Variants[@i].Id"
                                       value="@Model.Variants[i].Id" />

                                <!-- COLOR -->
                                <td>
                                    <input type="text"
                                           name="Variants[@i].Color"
                                           value="@Model.Variants[i].Color"
                                           class="form-control variant-edit-field"
                                           disabled />
                                </td>

                                <!-- SIZE -->
                                <td>
                                    <select name="Variants[@i].Size"
                                            class="form-select variant-edit-field"
                                            disabled>

                                        <option value="">-- Select --</option>

                                        <option value="Small"
                                            selected="@(Model.Variants[i].Size == "Small")">
                                            Small
                                        </option>

                                        <option value="Medium"
                                            selected="@(Model.Variants[i].Size == "Medium")">
                                            Medium
                                        </option>

                                        <option value="Large"
                                            selected="@(Model.Variants[i].Size == "Large")">
                                            Large
                                        </option>

                                        <option value="XL"
                                            selected="@(Model.Variants[i].Size == "XL")">
                                            XL
                                        </option>

                                    </select>
                                </td>

                                <!-- SKU -->
                                <td>
                                    <input type="text"
                                           name="Variants[@i].Sku"
                                           value="@Model.Variants[i].Sku"
                                           class="form-control variant-edit-field"
                                           disabled />
                                </td>

                                <!-- STOCK -->
                                <td>
                                    <input type="number"
                                           name="Variants[@i].StockQuantity"
                                           value="@Model.Variants[i].StockQuantity"
                                           class="form-control"
                                           readonly />

                                    <input type="hidden"
                                           name="Variants[@i].ReservedQuantity"
                                           value="@Model.Variants[i].ReservedQuantity" />
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary variant-edit-btn"
                                                title="Edit Variant">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger variant-delete-btn"
                                                title="Delete Variant">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>

        <!-- ADD VARIANT -->

        <div class="d-flex justify-content-between align-items-center mt-3">

            <button type="button"
                    id="addVariantBtn"
                    class="btn btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add Variant
            </button>

        </div>

    </div>
</div>


<!-- =====================================================
     IMAGES
     ===================================================== -->

<div class="card mb-4">
    <div class="card-body">

        <div class="d-flex align-items-center mb-3">
            <h5 class="mb-0">Images</h5>

            <span class="text-muted small ms-3">
                Drag & drop to reorder. The first image will be the primary image (shown on store).
            </span>
        </div>


        <div id="productImagesContainer"
             class="product-images-list">

            @if (Model.ExistingImages != null &&
                 Model.ExistingImages.Any())
            {
                var imageIndex = 0;

                foreach (var image in Model.ExistingImages
                    .OrderBy(i => i.SortOrder))
                {
                    <div class="product-image-item"
                         draggable="true"
                         data-index="@imageIndex">

                        <!-- Hidden fields -->

                        <input type="hidden"
                               name="ExistingImages[@imageIndex].Id"
                               value="@image.Id" />

                        <input type="hidden"
                               name="ExistingImages[@imageIndex].ImageUrl"
                               value="@image.ImageUrl"
                               class="image-url-input" />

                        <input type="hidden"
                               name="ExistingImages[@imageIndex].ProductVariantId"
                               value="@image.ProductVariantId" />

                        <input type="hidden"
                               name="ExistingImages[@imageIndex].SortOrder"
                               value="@imageIndex"
                               class="image-sort-input" />

                        <input type="hidden"
                               name="ExistingImages[@imageIndex].IsPrimary"
                               value="@(imageIndex == 0 ? "true" : "false")"
                               class="image-primary-input" />


                        <!-- Image -->

                        <div class="product-image-box">

                            <img src="@image.ImageUrl"
                                 alt="Product image"
                                 class="product-image-preview" />


                            <!-- Remove -->

                            <button type="button"
                                    class="image-remove-btn"
                                    title="Remove image">
                                ×
                            </button>


                            <!-- Primary -->

                            @if (imageIndex == 0)
                            {
                                <span class="primary-badge">
                                    Primary
                                </span>
                            }

                        </div>

                    </div>

                    imageIndex++;
                }
            }


            <!-- =================================================
                 UPLOAD MORE
                 ================================================= -->

            <label for="productImagesInput"
                   class="upload-more-box">

                <div class="upload-more-content">

                    <div class="upload-icon">
                        ☁
                    </div>

                    <span>
                        Upload More
                    </span>

                </div>

            </label>

            <input type="file"
                   id="productImagesInput"
                   class="d-none"
                   accept="image/png,image/jpeg,image/webp"
                   multiple />

        </div>

    </div>
</div>


<style>

    /* =========================================================
       IMAGES SECTION
       ========================================================= */

    .product-images-list {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 14px;
    }


    /* =========================================================
       IMAGE ITEM
       ========================================================= */

    .product-image-item {
        width: 120px;
        cursor: grab;
        user-select: none;
    }

    .product-image-item:active {
        cursor: grabbing;
    }

    .product-image-item.dragging {
        opacity: 0.45;
    }


    /* =========================================================
       IMAGE BOX
       ========================================================= */

    .product-image-box {
        position: relative;

        width: 120px;
        height: 110px;

        border: 1px solid #dfe5ec;
        border-radius: 6px;

        background: #fff;

        overflow: hidden;

        display: flex;
        align-items: center;
        justify-content: center;
    }


    /* =========================================================
       PRIMARY IMAGE
       ========================================================= */

    .product-image-item:first-child .product-image-box {
        border: 2px solid #0d6efd;
    }


    /* =========================================================
       IMAGE
       ========================================================= */

    .product-image-preview {
        width: 100%;
        height: 100%;

        object-fit: contain;

        padding: 6px;
    }


    /* =========================================================
       REMOVE BUTTON
       ========================================================= */

    .image-remove-btn {
        position: absolute;

        top: 5px;
        left: 5px;

        width: 20px;
        height: 20px;

        padding: 0;

        border: 0;
        border-radius: 50%;

        background: rgba(255, 255, 255, 0.9);

        color: #8b95a1;

        font-size: 15px;
        line-height: 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;

        z-index: 2;
    }

    .image-remove-btn:hover {
        background: #fff;
        color: #dc3545;
    }


    /* =========================================================
       PRIMARY BADGE
       ========================================================= */

    .primary-badge {
        position: absolute;

        right: 5px;
        bottom: 5px;

        background: #0d6efd;
        color: #fff;

        font-size: 9px;
        font-weight: 600;

        padding: 3px 6px;

        border-radius: 3px;

        z-index: 2;
    }


    /* =========================================================
       UPLOAD MORE
       ========================================================= */

    .upload-more-box {
        width: 120px;
        height: 110px;

        border: 1px dashed #cfd7e2;
        border-radius: 6px;

        background: #fff;

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .upload-more-box:hover {
        border-color: #0d6efd;
        background: #f8fbff;
    }


    .upload-more-content {
        text-align: center;
        color: #0d6efd;
    }


    .upload-icon {
        font-size: 28px;
        line-height: 30px;

        color: #7b8794;

        margin-bottom: 5px;
    }


    .upload-more-content span {
        display: block;

        font-size: 11px;
        font-weight: 600;

        color: #0d6efd;
    }

</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const container =
            document.getElementById("productImagesContainer");

        const fileInput =
            document.getElementById("productImagesInput");


        // =====================================================
        // DRAG & DROP
        // =====================================================

        let draggedItem = null;


        container.addEventListener("dragstart", function (e) {

            const item =
                e.target.closest(".product-image-item");

            if (!item)
                return;

            draggedItem = item;

            item.classList.add("dragging");
        });


        container.addEventListener("dragend", function () {

            if (draggedItem) {
                draggedItem.classList.remove("dragging");
            }

            draggedItem = null;

            updateImageOrder();
        });


        container.addEventListener("dragover", function (e) {

            e.preventDefault();

            if (!draggedItem)
                return;

            const target =
                e.target.closest(".product-image-item");

            if (!target ||
                target === draggedItem)
                return;


            const rect =
                target.getBoundingClientRect();

            const before =
                e.clientX <
                rect.left + rect.width / 2;


            if (before) {

                container.insertBefore(
                    draggedItem,
                    target
                );

            } else {

                container.insertBefore(
                    draggedItem,
                    target.nextSibling
                );
            }

        });


        // =====================================================
        // REMOVE IMAGE
        // =====================================================

        container.addEventListener("click", function (e) {

            const button =
                e.target.closest(".image-remove-btn");

            if (!button)
                return;


            const item =
                button.closest(".product-image-item");

            if (!item)
                return;


            item.remove();

            updateImageOrder();

        });


        // =====================================================
        // UPLOAD MORE
        // =====================================================

        fileInput.addEventListener(
            "change",
            async function () {

                const files =
                    Array.from(fileInput.files);

                if (!files.length)
                    return;


                for (const file of files) {

                    try {

                        const imageUrl =
                            await uploadProductImage(file);

                        addImage(imageUrl);

                    }
                    catch (error) {

                        console.error(error);

                        alert(
                            "Failed to upload image: " +
                            file.name
                        );
                    }
                }


                fileInput.value = "";

                updateImageOrder();
            }
        );


        // =====================================================
        // ADD NEW IMAGE
        // =====================================================

        function addImage(imageUrl) {

            const items =
                container.querySelectorAll(
                    ".product-image-item"
                );

            const index =
                items.length;


            const item =
                document.createElement("div");

            item.className =
                "product-image-item";

            item.draggable = true;


            item.innerHTML = `

                <input type="hidden"
                       name="ExistingImages[${index}].Id"
                       value="0" />

                <input type="hidden"
                       name="ExistingImages[${index}].ImageUrl"
                       value="${escapeHtml(imageUrl)}"
                       class="image-url-input" />

                <input type="hidden"
                       name="ExistingImages[${index}].ProductVariantId"
                       value="" />

                <input type="hidden"
                       name="ExistingImages[${index}].SortOrder"
                       value="${index}"
                       class="image-sort-input" />

                <input type="hidden"
                       name="ExistingImages[${index}].IsPrimary"
                       value="false"
                       class="image-primary-input" />


                <div class="product-image-box">

                    <img src="${escapeHtml(imageUrl)}"
                         alt="Product image"
                         class="product-image-preview" />

                    <button type="button"
                            class="image-remove-btn"
                            title="Remove image">
                        ×
                    </button>

                </div>
            `;


            const uploadBox =
                container.querySelector(
                    ".upload-more-box"
                );


            container.insertBefore(
                item,
                uploadBox
            );
        }


        // =====================================================
        // UPDATE ORDER
        // FIRST IMAGE = PRIMARY
        // =====================================================

        function updateImageOrder() {

            const items =
                container.querySelectorAll(
                    ".product-image-item"
                );


            items.forEach(function (item, index) {

                item.dataset.index = index;


                // ---------------------------------------------
                // Update hidden fields
                // ---------------------------------------------

                const sortInput =
                    item.querySelector(
                        ".image-sort-input"
                    );

                const primaryInput =
                    item.querySelector(
                        ".image-primary-input"
                    );


                if (sortInput)
                    sortInput.value = index;


                if (primaryInput)
                    primaryInput.value =
                        index === 0
                            ? "true"
                            : "false";


                // ---------------------------------------------
                // Primary badge
                // ---------------------------------------------

                const imageBox =
                    item.querySelector(
                        ".product-image-box"
                    );

                if (!imageBox)
                    return;


                const oldBadge =
                    imageBox.querySelector(
                        ".primary-badge"
                    );

                if (oldBadge)
                    oldBadge.remove();


                if (index === 0) {

                    const badge =
                        document.createElement("span");

                    badge.className =
                        "primary-badge";

                    badge.textContent =
                        "Primary";

                    imageBox.appendChild(badge);
                }


                // ---------------------------------------------
                // Re-index model fields
                // ---------------------------------------------

                item.querySelectorAll("input")
                    .forEach(function (input) {

                        const match =
                            input.name.match(
                                /^ExistingImages\[\d+\]\.(.+)$/
                            );

                        if (!match)
                            return;

                        input.name =
                            `ExistingImages[${index}].${match[1]}`;
                    });

            });

        }


        // =====================================================
        // UPLOAD IMAGE
        // =====================================================

        async function uploadProductImage(file) {

            const formData =
                new FormData();

            formData.append(
                "file",
                file
            );


            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            const response =
                await fetch(
                    '@Url.Action("Image", "Upload", new { area = "Admin" })',
                    {
                        method: "POST",

                        headers: {
                            "RequestVerificationToken":
                                token
                        },

                        body: formData
                    }
                );


            if (!response.ok)
                throw new Error(
                    "Image upload failed."
                );


            const result =
                await response.json();


            if (!result.url)
                throw new Error(
                    "Upload response did not return an image URL."
                );


            return result.url;
        }


        // =====================================================
        // ESCAPE HTML
        // =====================================================

        function escapeHtml(value) {

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        // Initial state

        updateImageOrder();

    });

</script>

