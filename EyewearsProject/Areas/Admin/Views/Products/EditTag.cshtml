@model ProductTagFormViewModel

<h4>Edit Tag — @ViewBag.ProductName</h4>

<form asp-action="EditTag"
      asp-route-id="@Model.Id"
      method="post"
      style="max-width:520px;">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProductId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-dark">
        Save
    </button>

    <a asp-action="Tags"
       asp-route-id="@Model.ProductId"
       class="btn btn-outline-secondary">
        Cancel
    </a>
</form>