@model List<ProductImage>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Images — @ViewBag.ProductName</h4>

    <a asp-action="CreateImage"
       asp-route-productId="@ViewBag.ProductId"
       class="btn btn-dark">
        + Add Image
    </a>
</div>


<div class="row g-3">

    @foreach (var img in Model)
    {
        <div class="col-md-3">

            <div class="card h-100 p-2">

                <img src="@img.ImageUrl"
                     alt="@ViewBag.ProductName"
                     class="img-fluid rounded mb-2"
                     style="height:150px; width:100%; object-fit:cover;" />


                <!-- IMAGE TYPE / VARIANT -->
                @if (img.ProductVariant != null)
                {
                    <div class="small text-muted mb-2">
                        <strong>Variant:</strong>
                        @img.ProductVariant.Color

                        @if (!string.IsNullOrWhiteSpace(img.ProductVariant.Size))
                        {
                            <span>
                                — @img.ProductVariant.Size
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="small text-muted mb-2">
                        General product image
                    </div>
                }


                <!-- PRIMARY -->
                @if (img.IsPrimary)
                {
                    <span class="badge bg-success mb-2">
                        Primary
                    </span>
                }
                else
                {
                    <form asp-action="SetPrimaryImage"
                          asp-route-id="@img.Id"
                          asp-route-productId="@ViewBag.ProductId"
                          method="post"
                          class="mb-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-outline-secondary w-100">
                            Set as Primary
                        </button>

                    </form>
                }


                <!-- DELETE -->

                <form asp-action="DeleteImage"
                      asp-route-id="@img.Id"
                      asp-route-productId="@ViewBag.ProductId"
                      method="post"
                      onsubmit="return confirm('Delete this image?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger w-100">
                        Delete
                    </button>

                </form>

            </div>

        </div>
    }

</div>


@if (!Model.Any())
{
    <div class="mt-3">
        <p class="text-muted">
            No images yet — the shop will show a placeholder
            until you add one.
        </p>
    </div>
}


<a asp-action="Index"
   class="btn btn-outline-secondary mt-3">
    Back to Products
</a>