    <!-- =========================================================
         TRY-ON SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const tryOnFileInput =
                    document.getElementById(
                        "tryOnFileInput"
                    );

                const tryOnUploadButton =
                    document.getElementById(
                        "tryOnUploadButton"
                    );

                const tryOnUrlInput =
                    document.getElementById(
                        "TryOnOverlayImageUrl"
                    );

                const tryOnPreview =
                    document.getElementById(
                        "tryOnPreview"
                    );


                /*
                 * Open file selector.
                 */

                if (tryOnUploadButton &&
                    tryOnFileInput) {

                    tryOnUploadButton.addEventListener(
                        "click",
                        function() {

                            tryOnFileInput.click();

                        }
                    );

                }


                /*
                 * Upload Try-On image.
                 */

                if (tryOnFileInput) {

                    tryOnFileInput.addEventListener(
                        "change",
                        async function() {

                            if (!this.files ||
                                this.files.length === 0) {

                                return;

                            }


                            const file =
                                this.files[0];


                            try {

                                const formData =
                                    new FormData();

                                formData.append(
                                    "file",
                                    file
                                );


                                const token =
                                    document.querySelector(
                                        '#editProductForm input[name="__RequestVerificationToken"]'
                                    )?.value;


                                const response =
                                    await fetch(
                                        '@Url.Action("Image", "Upload", new { area = "Admin" })',
                                        {
                                            method: "POST",

                                            headers: {
                                                "RequestVerificationToken":
                                                    token
                                            },

                                            body: formData
                                        }
                                    );


                                if (!response.ok) {

                                    throw new Error(
                                        "Image upload failed."
                                    );

                                }


                                const result =
                                    await response.json();


                                if (!result.url) {

                                    throw new Error(
                                        "Upload response did not return an image URL."
                                    );

                                }


                                if (tryOnUrlInput) {

                                    tryOnUrlInput.value =
                                        result.url;

                                }


                                if (tryOnPreview) {

                                    tryOnPreview.src =
                                        result.url;

                                    tryOnPreview.classList.remove(
                                        "d-none"
                                    );

                                }

                            }
                            catch (error) {

                                console.error(error);

                                alert(
                                    "Failed to upload Try-On image."
                                );

                            }


                            this.value = "";

                        }
                    );

                }


                /*
                 * Preview manually entered URL.
                 */

                if (tryOnUrlInput) {

                    tryOnUrlInput.addEventListener(
                        "input",
                        function() {

                            const url =
                                this.value.trim();


                            if (!url) {

                                if (tryOnPreview) {

                                    tryOnPreview.classList.add(
                                        "d-none"
                                    );

                                    tryOnPreview.removeAttribute(
                                        "src"
                                    );

                                }

                                return;

                            }


                            if (tryOnPreview) {

                                tryOnPreview.src = url;

                                tryOnPreview.classList.remove(
                                    "d-none"
                                );

                            }

                        }
                    );

                }

            }
        );

    </script>


    <!-- =========================================================
         VARIANTS SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const variantsBody =
                    document.getElementById(
                        "variantsBody"
                    );

                const addVariantBtn =
                    document.getElementById(
                        "addVariantBtn"
                    );

                const editProductForm =
                    document.getElementById(
                        "editProductForm"
                    );


                if (!variantsBody)
                    return;


                /*
                 * EDIT VARIANT
                 */

                variantsBody.addEventListener(
                    "click",
                    function(event) {

                        const editButton =
                            event.target.closest(
                                ".variant-edit-btn"
                            );


                        if (!editButton)
                            return;


                        const row =
                            editButton.closest(
                                ".variant-row"
                            );


                        if (!row)
                            return;


                        const fields =
                            row.querySelectorAll(
                                ".variant-edit-field"
                            );


                        const stockField =
                            row.querySelector(
                                'input[name$=".StockQuantity"]'
                            );


                        const isEditing =
                            row.classList.contains(
                                "editing"
                            );


                        if (!isEditing) {

                            fields.forEach(
                                function(field) {

                                    field.disabled = false;

                                    field.removeAttribute(
                                        "readonly"
                                    );

                                }
                            );


                            if (stockField) {

                                stockField.readOnly =
                                    false;

                            }


                            row.classList.add(
                                "editing"
                            );


                            editButton.innerHTML =
                                '<i class="bi bi-check-lg"></i>';


                            editButton.title =
                                "Done";

                        }
                        else {

                            fields.forEach(
                                function(field) {

                                    if (field.tagName === "SELECT") {

                                        field.disabled =
                                            true;

                                    }
                                    else {

                                        field.readOnly =
                                            true;

                                    }

                                }
                            );


                            if (stockField) {

                                stockField.readOnly =
                                    true;

                            }


                            row.classList.remove(
                                "editing"
                            );


                            editButton.innerHTML =
                                '<i class="bi bi-pencil"></i>';


                            editButton.title =
                                "Edit Variant";

                        }

                    }
                );


                /*
                 * DELETE VARIANT
                 */

                variantsBody.addEventListener(
                    "click",
                    function(event) {

                        const deleteButton =
                            event.target.closest(
                                ".variant-delete-btn"
                            );


                        if (!deleteButton)
                            return;


                        const row =
                            deleteButton.closest(
                                ".variant-row"
                            );


                        if (!row)
                            return;


                        const variantIdInput =
                            row.querySelector(
                                'input[name$=".Id"]'
                            );


                        const variantId =
                            variantIdInput
                                ? parseInt(
                                    variantIdInput.value || "0"
                                )
                                : 0;


                        if (variantId > 0) {

                            const confirmed =
                                confirm(
                                    "Are you sure you want to remove this variant?"
                                );


                            if (!confirmed)
                                return;

                        }


                        row.remove();

                        reindexVariants();

                    }
                );


                /*
                 * ADD VARIANT
                 */

                if (addVariantBtn) {

                    addVariantBtn.addEventListener(
                        "click",
                        function() {

                            const index =
                                variantsBody.querySelectorAll(
                                    ".variant-row"
                                ).length;


                            const row =
                                document.createElement(
                                    "tr"
                                );


                            row.className =
                                "variant-row editing";


                            row.innerHTML = `

                                        <td style="display:none;">

                                            <input type="hidden"
                                                   name="Variants[${index}].Id"
                                                   value="0" />

                                        </td>


                                        <td>

                                            <input type="text"
                                                   class="form-control variant-edit-field"
                                                   name="Variants[${index}].Color"
                                                   placeholder="e.g. Black" />

                                        </td>


                                        <td>

                                            <select class="form-select variant-edit-field"
                                                    name="Variants[${index}].Size">

                                                <option value="">
                                                    -- Select --
                                                </option>

                                                <option value="Small">
                                                    Small
                                                </option>

                                                <option value="Medium">
                                                    Medium
                                                </option>

                                                <option value="Large">
                                                    Large
                                                </option>

                                                <option value="XL">
                                                    XL
                                                </option>

                                            </select>

                                        </td>


                                        <td>

                                            <input type="text"
                                                   class="form-control variant-edit-field"
                                                   name="Variants[${index}].Sku"
                                                   placeholder="Variant SKU" />

                                        </td>


                                        <td>

                                            <input type="number"
                                                   class="form-control"
                                                   name="Variants[${index}].StockQuantity"
                                                   value="0"
                                                   min="0" />

                                            <input type="hidden"
                                                   name="Variants[${index}].ReservedQuantity"
                                                   value="0" />

                                        </td>


                                        <td>

                                            <div class="d-flex justify-content-center gap-2">

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary variant-edit-btn"
                                                        title="Done">

                                                    <i class="bi bi-check-lg"></i>

                                                </button>


                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger variant-delete-btn"
                                                        title="Delete Variant">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </div>

                                        </td>

                                    `;


                            variantsBody.appendChild(
                                row
                            );


                            reindexVariants();


                            const firstInput =
                                row.querySelector(
                                    'input[name$=".Color"]'
                                );


                            if (firstInput)
                                firstInput.focus();

                        }
                    );

                }


                /*
                 * REINDEX VARIANTS
                 */

                function reindexVariants() {

                    const rows =
                        variantsBody.querySelectorAll(
                            ".variant-row"
                        );


                    rows.forEach(
                        function(row, index) {

                            row.querySelectorAll(
                                "input, select"
                            ).forEach(
                                function(input) {

                                    const name =
                                        input.getAttribute(
                                            "name"
                                        );


                                    if (!name)
                                        return;


                                    input.setAttribute(
                                        "name",
                                        name.replace(
                                            /Variants\[\d+\]/,
                                            `Variants[${index}]`
                                        )
                                    );

                                }
                            );

                        }
                    );

                }


                /*
                 * IMPORTANT:
                 *
                 * Disabled SELECT elements are not submitted.
                 * Before the form posts, enable all variant fields.
                 */

                if (editProductForm) {

                    editProductForm.addEventListener(
                        "submit",
                        function() {

                            variantsBody
                                .querySelectorAll(
                                    ".variant-edit-field"
                                )
                                .forEach(
                                    function(field) {

                                        field.disabled =
                                            false;

                                        field.removeAttribute(
                                            "readonly"
                                        );

                                    }
                                );


                            variantsBody
                                .querySelectorAll(
                                    'input[name$=".StockQuantity"]'
                                )
                                .forEach(
                                    function(field) {

                                        field.readOnly =
                                            false;

                                    }
                                );


                            reindexVariants();

                        }
                    );

                }

            }
        );

    </script>


    <!-- =========================================================
         IMAGES SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const container =
                    document.getElementById(
                        "productImagesContainer"
                    );

                const fileInput =
                    document.getElementById(
                        "productImagesInput"
                    );


                if (!container ||
                    !fileInput) {

                    return;

                }


                let draggedItem = null;


                /*
                 * DRAG START
                 */

                container.addEventListener(
                    "dragstart",
                    function(event) {

                        const item =
                            event.target.closest(
                                ".product-image-item"
                            );


                        if (!item)
                            return;


                        draggedItem = item;


                        item.classList.add(
                            "dragging"
                        );

                    }
                );


                /*
                 * DRAG END
                 */

                container.addEventListener(
                    "dragend",
                    function() {

                        if (draggedItem) {

                            draggedItem.classList.remove(
                                "dragging"
                            );

                        }


                        draggedItem = null;


                        updateImageOrder();

                    }
                );


                /*
                 * DRAG OVER
                 */

                container.addEventListener(
                    "dragover",
                    function(event) {

                        event.preventDefault();


                        if (!draggedItem)
                            return;


                        const target =
                            event.target.closest(
                                ".product-image-item"
                            );


                        if (!target ||
                            target === draggedItem) {

                            return;

                        }


                        const rect =
                            target.getBoundingClientRect();


                        const before =
                            event.clientX <
                            rect.left +
                            rect.width / 2;


                        if (before) {

                            container.insertBefore(
                                draggedItem,
                                target
                            );

                        }
                        else {

                            container.insertBefore(
                                draggedItem,
                                target.nextSibling
                            );

                        }

                    }
                );


                /*
                 * REMOVE IMAGE
                 */

                container.addEventListener(
                    "click",
                    function(event) {

                        const removeButton =
                            event.target.closest(
                                ".image-remove-btn"
                            );


                        if (!removeButton)
                            return;


                        const item =
                            removeButton.closest(
                                ".product-image-item"
                            );


                        if (!item)
                            return;


                        item.remove();


                        updateImageOrder();

                    }
                );


                /*
                 * UPLOAD MORE
                 */

                fileInput.addEventListener(
                    "change",
                    async function() {

                        const files =
                            Array.from(
                                fileInput.files || []
                            );


                        if (!files.length)
                            return;


                        for (const file of files) {

                            try {

                                const imageUrl =
                                    await uploadProductImage(
                                        file
                                    );


                                addImage(
                                    imageUrl
                                );

                            }
                            catch (error) {

                                console.error(error);

                                alert(
                                    "Failed to upload image: " +
                                    file.name
                                );

                            }

                        }


                        fileInput.value = "";


                        updateImageOrder();

                    }
                );


                /*
                 * UPLOAD IMAGE
                 */

                async function uploadProductImage(
                    file
                ) {

                    const formData =
                        new FormData();


                    formData.append(
                        "file",
                        file
                    );


                    const token =
                        document.querySelector(
                            '#editProductForm input[name="__RequestVerificationToken"]'
                        )?.value;


                    const response =
                        await fetch(
                            '@Url.Action("Image", "Upload", new { area = "Admin" })',
                            {
                                method: "POST",

                                headers: {
                                    "RequestVerificationToken":
                                        token
                                },

                                body: formData
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Image upload failed."
                        );

                    }


                    const result =
                        await response.json();


                    if (!result.url) {

                        throw new Error(
                            "Upload response did not return an image URL."
                        );

                    }


                    return result.url;

                }


                /*
                 * ADD IMAGE
                 */

                function addImage(
                    imageUrl
                ) {

                    const item =
                        document.createElement(
                            "div"
                        );


                    item.className =
                        "product-image-item";


                    item.draggable =
                        true;


                    item.innerHTML = `

                                <input type="hidden"
                                       class="image-id-input"
                                       value="0" />


                                <input type="hidden"
                                       class="image-url-input"
                                       value="${escapeHtml(imageUrl)}" />


                                <input type="hidden"
                                       class="image-variant-id-input"
                                       value="" />


                                <input type="hidden"
                                       class="image-sort-input"
                                       value="0" />


                                <input type="hidden"
                                       class="image-primary-input"
                                       value="false" />


                                <div class="product-image-box">

                                    <img src="${escapeHtml(imageUrl)}"
                                         alt="Product image"
                                         class="product-image-preview" />


                                    <button type="button"
                                            class="image-remove-btn"
                                            title="Remove image">

                                        ×

                                    </button>

                                </div>

                            `;


                    const uploadBox =
                        container.querySelector(
                            ".upload-more-box"
                        );


                    container.insertBefore(
                        item,
                        uploadBox
                    );


                    updateImageOrder();

                }


                /*
                 * UPDATE IMAGE ORDER
                 */

                function updateImageOrder() {

                    const items =
                        container.querySelectorAll(
                            ".product-image-item"
                        );


                    items.forEach(
                        function(item, index) {

                            item.dataset.index =
                                index;


                            const idInput =
                                item.querySelector(
                                    ".image-id-input"
                                );


                            const urlInput =
                                item.querySelector(
                                    ".image-url-input"
                                );


                            const variantInput =
                                item.querySelector(
                                    ".image-variant-id-input"
                                );


                            const sortInput =
                                item.querySelector(
                                    ".image-sort-input"
                                );


                            const primaryInput =
                                item.querySelector(
                                    ".image-primary-input"
                                );


                            if (idInput) {

                                idInput.name =
                                    `ExistingImages[${index}].Id`;

                            }


                            if (urlInput) {

                                urlInput.name =
                                    `ExistingImages[${index}].ImageUrl`;

                            }


                            if (variantInput) {

                                variantInput.name =
                                    `ExistingImages[${index}].ProductVariantId`;

                            }


                            if (sortInput) {

                                sortInput.name =
                                    `ExistingImages[${index}].SortOrder`;

                                sortInput.value =
                                    index;

                            }


                            if (primaryInput) {

                                primaryInput.name =
                                    `ExistingImages[${index}].IsPrimary`;

                                primaryInput.value =
                                    index === 0
                                        ? "true"
                                        : "false";

                            }


                            /*
                             * Remove old badge.
                             */

                            const imageBox =
                                item.querySelector(
                                    ".product-image-box"
                                );


                            if (!imageBox)
                                return;


                            const oldBadge =
                                imageBox.querySelector(
                                    ".primary-badge"
                                );


                            if (oldBadge)
                                oldBadge.remove();


                            /*
                             * First image = Primary.
                             */

                            if (index === 0) {

                                const badge =
                                    document.createElement(
                                        "span"
                                    );


                                badge.className =
                                    "primary-badge";


                                badge.textContent =
                                    "Primary";


                                imageBox.appendChild(
                                    badge
                                );

                            }

                        }
                    );

                }


                /*
                 * ESCAPE HTML
                 */

                function escapeHtml(
                    value
                ) {

                    return String(value)
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");

                }


                /*
                 * INITIAL STATE
                 */

                updateImageOrder();

            }
        );

    </script>


