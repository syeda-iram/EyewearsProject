                                                   placeholder="Specification name" />

                                        </div>


                                        <div class="col-md-5">

                                            <input type="text"
                                                   name="Specifications[${index}].Value"
                                                   class="form-control"
                                                   placeholder="Value" />

                                        </div>


                                        <div class="col-md-2">

                                            <button type="button"
                                                    class="btn btn-outline-danger remove-specification"
                                                    title="Remove Specification"
                                                    style="width:42px;height:42px;padding:0;display:flex;align-items:center;justify-content:center;">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </div>

                                    </div>

                                `;


                        container.appendChild(
                            row
                        );


                        updateSpecificationIndexes();


                        const nameInput =
                            row.querySelector(
                                'input[name$=".Name"]'
                            );


                        if (nameInput)
                            nameInput.focus();

                    }
                );


                /*
                 * REMOVE SPECIFICATION
                 */

                container.addEventListener(
                    "click",
                    function(event) {

                        const removeButton =
                            event.target.closest(
                                ".remove-specification"
                            );


                        if (!removeButton)
                            return;


                        const row =
                            removeButton.closest(
                                ".specification-row"
                            );


                        if (!row)
                            return;


                        row.remove();


                        updateSpecificationIndexes();

                    }
                );


                /*
                 * INITIAL INDEXES
                 */

                updateSpecificationIndexes();

            }
        );

    </script>


