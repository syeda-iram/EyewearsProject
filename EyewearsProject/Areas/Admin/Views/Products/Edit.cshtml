@model ProductEditViewModel

@{
    ViewData["Title"] = $"Edit Product — {Model.Name}";
}

<div class="product-edit-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="product-edit-header">

        <div>
            <h3 class="product-edit-title">
                Edit Product — @Model.Name (@Model.Sku)
            </h3>
        </div>

        <div class="product-edit-header-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <a asp-action="Preview"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i>
                Preview
            </a>

            <button type="submit"
                    form="editProductForm"
                    class="btn btn-primary">
                <i class="bi bi-save"></i>
                Save Changes
            </button>

        </div>

    </div>


    <!-- =========================================================
         MAIN FORM
         ========================================================= -->

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          id="editProductForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- =====================================================
             TWO COLUMN LAYOUT
             ===================================================== -->

        <div class="product-edit-grid">


            <!-- =================================================
                 LEFT COLUMN
                 ================================================= -->

            <div class="product-edit-left">


                <!-- =================================================
                     BASIC INFORMATION
                     ================================================= -->

                <div class="product-card">

                    <div class="product-card-header">

                        <div class="section-icon">
                            <i class="bi bi-box"></i>
                        </div>

                        <h5>Basic Information</h5>

                    </div>


                    <div class="product-card-body">

                        <!-- Row 1 -->

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label asp-for="Name"
                                       class="form-label">
                                    Product Name
                                    <span class="required">*</span>
                                </label>

                                <input asp-for="Name"
                                       class="form-control" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Sku"
                                       class="form-label">
                                    SKU
                                    <span class="required">*</span>
                                </label>

                                <input asp-for="Sku"
                                       class="form-control" />

                                <span asp-validation-for="Sku"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Category
                                    <span class="required">*</span>
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select"
                                        asp-items="ViewBag.Categories">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Row 2 -->

                        <div class="row g-3 mt-0">

                            <div class="col-md-4">

                                <label asp-for="SubCategoryId"
                                       class="form-label">
                                    Subcategory
                                </label>

                                <select asp-for="SubCategoryId"
                                        class="form-select"
                                        asp-items="ViewBag.SubCategories">

                                    <option value="">
                                        -- Select Subcategory --
                                    </option>

                                </select>

                                <span asp-validation-for="SubCategoryId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="BrandId"
                                       class="form-label">
                                    Brand
                                </label>

                                <select asp-for="BrandId"
                                        class="form-select"
                                        asp-items="ViewBag.Brands">

                                    <option value="">
                                        -- No Brand --
                                    </option>

                                </select>

                                <span asp-validation-for="BrandId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Gender"
                                       class="form-label">
                                    Gender
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">

                                    <option value="">
                                        -- Select Gender --
                                    </option>

                                    <option value="Men">
                                        Men
                                    </option>

                                    <option value="Women">
                                        Women
                                    </option>

                                    <option value="Unisex">
                                        Unisex
                                    </option>

                                    <option value="Kids">
                                        Kids
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Row 3 -->

                        <div class="row g-3 mt-0">

                            <div class="col-md-4">

                                <label asp-for="Material"
                                       class="form-label">
                                    Material
                                </label>

                                <input asp-for="Material"
                                       class="form-control"
                                       placeholder="e.g. Acetate, Titanium, Nylon" />

                                <span asp-validation-for="Material"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Shape"
                                       class="form-label">
                                    Shape
                                </label>

                                <select asp-for="Shape"
                                        class="form-select">

                                    <option value="">
                                        -- Select Shape --
                                    </option>

                                    <option value="Round">
                                        Round
                                    </option>

                                    <option value="Square">
                                        Square
                                    </option>

                                    <option value="Rectangle">
                                        Rectangle
                                    </option>

                                    <option value="Oval">
                                        Oval
                                    </option>

                                    <option value="Cat Eye">
                                        Cat Eye
                                    </option>

                                    <option value="Aviator">
                                        Aviator
                                    </option>

                                    <option value="Wayfarer">
                                        Wayfarer
                                    </option>

                                    <option value="Geometric">
                                        Geometric
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <span asp-validation-for="Shape"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Description -->

                        <div class="description-section">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                                <span class="required">*</span>
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control product-description"
                                      rows="5"
                                      placeholder="Detailed product description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PRICING
                     ================================================= -->

                <div class="card mb-4">

                    <div class="card-body">

                        <h5 class="mb-3">

                            <i class="bi bi-currency-dollar me-2 text-primary"></i>

                            Pricing

                        </h5>


                        <div class="row g-3">

                            <!-- Price -->

                            <div class="col-md-4">

                                <label asp-for="Price"
                                       class="form-label">

                                    Price
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       placeholder="4800.00" />

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Discount Price -->

                            <div class="col-md-4">

                                <label asp-for="DiscountPrice"
                                       class="form-label">

                                    Discount Price

                                </label>

                                <input asp-for="DiscountPrice"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       placeholder="4100.00" />

                                <span asp-validation-for="DiscountPrice"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Cost Price -->

                            <div class="col-md-4">

                                <label asp-for="CostPrice"
                                       class="form-label">

                                    Cost Price

                                </label>

                                <input asp-for="CostPrice"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       placeholder="4200.00" />

                                <span asp-validation-for="CostPrice"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Weight -->

                            <div class="col-md-4">

                                <label asp-for="Weight"
                                       class="form-label">

                                    Weight (g)

                                </label>

                                <input asp-for="Weight"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       placeholder="e.g. 24.5" />

                                <span asp-validation-for="Weight"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     VARIANTS
                     ================================================= -->

                <div class="card mb-4">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>

                                <h5 class="mb-1">
                                    Variants
                                </h5>

                                <p class="text-muted small mb-0">
                                    Manage product colors, sizes, SKUs and inventory.
                                </p>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table align-middle mb-2"
                                   id="variantsTable">

                                <thead>

                                    <tr>

                                        <th style="width: 25%;">
                                            Color
                                        </th>

                                        <th style="width: 23%;">
                                            Size
                                        </th>

                                        <th style="width: 25%;">
                                            SKU
                                        </th>

                                        <th style="width: 17%;">
                                            Stock (Inventory)
                                        </th>

                                        <th style="width: 10%;"
                                            class="text-center">

                                            Actions

                                        </th>

                                    </tr>

                                </thead>


                                <tbody id="variantsBody">

                                    @if (Model.Variants != null &&
                                         Model.Variants.Any())
                                    {
                                        for (int i = 0;
                                             i < Model.Variants.Count;
                                             i++)
                                        {
                                            <tr class="variant-row">

                                                <!-- Variant ID -->

                                                <td style="display:none;">

                                                    <input type="hidden"
                                                           name="Variants[@i].Id"
                                                           value="@Model.Variants[i].Id" />

                                                </td>


                                                <!-- COLOR -->

                                                <td>

                                                    <input type="text"
                                                           name="Variants[@i].Color"
                                                           value="@Model.Variants[i].Color"
                                                           class="form-control variant-edit-field"
                                                           readonly />

                                                </td>


                                                <!-- SIZE -->

                                                <td>

                                                    <select name="Variants[@i].Size"
                                                            class="form-select variant-edit-field"
                                                            disabled>

                                                        <option value="">
                                                            -- Select --
                                                        </option>

                                                        <option value="Small"
                                                                selected="@(Model.Variants[i].Size == "Small")">
                                                            Small
                                                        </option>

                                                        <option value="Medium"
                                                                selected="@(Model.Variants[i].Size == "Medium")">
                                                            Medium
                                                        </option>

                                                        <option value="Large"
                                                                selected="@(Model.Variants[i].Size == "Large")">
                                                            Large
                                                        </option>

                                                        <option value="XL"
                                                                selected="@(Model.Variants[i].Size == "XL")">
                                                            XL
                                                        </option>

                                                    </select>

                                                </td>


                                                <!-- SKU -->

                                                <td>

                                                    <input type="text"
                                                           name="Variants[@i].Sku"
                                                           value="@Model.Variants[i].Sku"
                                                           class="form-control variant-edit-field"
                                                           readonly />

                                                </td>


                                                <!-- STOCK -->

                                                <td>

                                                    <input type="number"
                                                           name="Variants[@i].StockQuantity"
                                                           value="@Model.Variants[i].StockQuantity"
                                                           class="form-control"
                                                           min="0"
                                                           readonly />

                                                    <input type="hidden"
                                                           name="Variants[@i].ReservedQuantity"
                                                           value="@Model.Variants[i].ReservedQuantity" />

                                                </td>


                                                <!-- ACTIONS -->

                                                <td>

                                                    <div class="d-flex justify-content-center gap-2">

                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary variant-edit-btn"
                                                                title="Edit Variant">

                                                            <i class="bi bi-pencil"></i>

                                                        </button>


                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger variant-delete-btn"
                                                                title="Delete Variant">

                                                            <i class="bi bi-trash"></i>

                                                        </button>

                                                    </div>

                                                </td>

                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>


                        <!-- ADD VARIANT -->

                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <button type="button"
                                    id="addVariantBtn"
                                    class="btn btn-outline-primary">

                                <i class="bi bi-plus-lg me-1"></i>

                                Add Variant

                            </button>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     IMAGES
                     ================================================= -->

                <div class="card mb-4">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">

                            <h5 class="mb-0">
                                Images
                            </h5>

                            <span class="text-muted small ms-3">
                                Drag & drop to reorder. The first image will be the primary image (shown on store).
                            </span>

                        </div>


                        <div id="productImagesContainer"
                             class="product-images-list">

                            @if (Model.ExistingImages != null &&
                                 Model.ExistingImages.Any())
                            {
                                var imageIndex = 0;

                                foreach (var image in Model.ExistingImages
                                    .OrderBy(i => i.SortOrder))
                                {
                                    <div class="product-image-item"
                                         draggable="true"
                                         data-index="@imageIndex">

                                        <input type="hidden"
                                               name="ExistingImages[@imageIndex].Id"
                                               value="@image.Id"
                                               class="image-id-input" />

                                        <input type="hidden"
                                               name="ExistingImages[@imageIndex].ImageUrl"
                                               value="@image.ImageUrl"
                                               class="image-url-input" />

                                        <input type="hidden"
                                               name="ExistingImages[@imageIndex].ProductVariantId"
                                               value="@image.ProductVariantId"
                                               class="image-variant-id-input" />

                                        <input type="hidden"
                                               name="ExistingImages[@imageIndex].SortOrder"
                                               value="@imageIndex"
                                               class="image-sort-input" />

                                        <input type="hidden"
                                               name="ExistingImages[@imageIndex].IsPrimary"
                                               value="@(imageIndex == 0 ? "true" : "false")"
                                               class="image-primary-input" />


                                        <div class="product-image-box">

                                            <img src="@image.ImageUrl"
                                                 alt="Product image"
                                                 class="product-image-preview" />


                                            <button type="button"
                                                    class="image-remove-btn"
                                                    title="Remove image">

                                                ×

                                            </button>


                                            @if (imageIndex == 0)
                                            {
                                                <span class="primary-badge">
                                                    Primary
                                                </span>
                                            }

                                        </div>

                                    </div>

                                    imageIndex++;
                                }
                            }


                            <!-- UPLOAD MORE -->

                            <label for="productImagesInput"
                                   class="upload-more-box">

                                <div class="upload-more-content">

                                    <div class="upload-icon">
                                        ☁
                                    </div>

                                    <span>
                                        Upload More
                                    </span>

                                </div>

                            </label>


                            <input type="file"
                                   id="productImagesInput"
                                   class="d-none"
                                   accept="image/png,image/jpeg,image/webp"
                                   multiple />

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TAGS
                     ================================================= -->

                <div class="card mb-4">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">

                            <h5 class="mb-0">

                                <i class="bi bi-tag me-2 text-primary"></i>

                                Tags

                            </h5>

                            <span class="text-muted small ms-3">
                                Type and press Enter to add tags
                            </span>

                        </div>


                        <div id="tagsContainer"
                             class="d-flex flex-wrap align-items-center gap-2">

                            @if (Model.Tags != null &&
                                 Model.Tags.Any())
                            {
                                for (int i = 0;
                                     i < Model.Tags.Count;
                                     i++)
                                {
                                    <div class="tag-item">

                                        <input type="hidden"
                                               name="Tags"
                                               value="@Model.Tags[i]" />

                                        <span class="badge rounded-pill bg-light text-dark border">

                                            @Model.Tags[i]

                                            <button type="button"
                                                    class="btn-close ms-1 remove-tag"
                                                    aria-label="Remove tag"
                                                    style="font-size: 8px;">
                                            </button>

                                        </span>

                                    </div>
                                }
                            }


                            <input type="text"
                                   id="tagInput"
                                   class="form-control border-0 shadow-none flex-grow-1"
                                   placeholder="Type a tag and press Enter..."
                                   autocomplete="off"
                                   style="min-width:220px;" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 RIGHT COLUMN
                 ================================================= -->

            <div class="product-edit-right">


                <!-- =================================================
                     PRODUCT SETTINGS
                     ================================================= -->

                <div class="product-card">

                    <div class="product-card-header">

                        <div class="section-icon">

                            <i class="bi bi-gear"></i>

                        </div>

                        <h5>
                            Product Settings
                        </h5>

                    </div>


                    <div class="product-card-body">

                        <div class="setting-row">

                            <div>

                                <div class="setting-title">
                                    Status
                                </div>

                                <div class="setting-subtitle">
                                    Product availability
                                </div>

                            </div>


                            <div class="form-check form-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       role="switch" />

                                <label asp-for="IsActive"
                                       class="form-check-label">
                                    Active
                                </label>

                            </div>

                        </div>


                        <div class="setting-divider"></div>


                        <div class="setting-row">

                            <div>

                                <div class="setting-title">
                                    Featured Product
                                </div>

                                <div class="setting-subtitle">
                                    Show in featured products
                                </div>

                            </div>


                            <div class="form-check form-switch">

                                <input asp-for="IsFeatured"
                                       class="form-check-input"
                                       role="switch" />

                                <label asp-for="IsFeatured"
                                       class="form-check-label">
                                    Featured
                                </label>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     VIRTUAL TRY-ON
                     ================================================= -->

                <div class="product-card">

                    <div class="product-card-header">

                        <div class="section-icon">

                            <i class="bi bi-person-bounding-box"></i>

                        </div>

                        <h5>
                            Try-On (Virtual)
                        </h5>

                    </div>


                    <div class="product-card-body">

                        <!-- 2D Overlay -->

                        <div class="mb-3">

                            <label asp-for="TryOnOverlayImageUrl"
                                   class="form-label">

                                2D Overlay Image URL

                            </label>


                            <div class="tryon-url-row">

                                <input asp-for="TryOnOverlayImageUrl"
                                       class="form-control"
                                       id="TryOnOverlayImageUrl"
                                       placeholder="/uploads/tryon/product-overlay.png" />


                                <button type="button"
                                        class="btn btn-outline-secondary tryon-upload-button"
                                        id="tryOnUploadButton">

                                    <i class="bi bi-image"></i>

                                </button>

                            </div>


                            <input type="file"
                                   id="tryOnFileInput"
                                   class="d-none"
                                   accept="image/png" />


                            <span asp-validation-for="TryOnOverlayImageUrl"
                                  class="text-danger">
                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                Model.TryOnOverlayImageUrl))
                            {
                                <img id="tryOnPreview"
                                     src="@Model.TryOnOverlayImageUrl"
                                     class="tryon-preview"
                                     alt="Try-on overlay preview" />
                            }
                            else
                            {
                                <img id="tryOnPreview"
                                     src=""
                                     class="tryon-preview d-none"
                                     alt="Try-on overlay preview" />
                            }

                        </div>


                        <!-- 3D Model -->

                        <div class="mb-3">

                            <label asp-for="TryOn3DModelUrl"
                                   class="form-label">

                                3D Model (GLB) URL

                            </label>

                            <input asp-for="TryOn3DModelUrl"
                                   class="form-control"
                                   placeholder="/uploads/3d/product.glb" />

                            <span asp-validation-for="TryOn3DModelUrl"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Scale + Offset -->

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="TryOnOverlayScale"
                                       class="form-label">

                                    2D Overlay Scale

                                </label>

                                <input asp-for="TryOnOverlayScale"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="TryOnOverlayScale"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="TryOnOverlayVerticalOffset"
                                       class="form-label">

                                    2D Overlay Vertical Offset

                                </label>

                                <input asp-for="TryOnOverlayVerticalOffset"
                                       type="number"
                                       step="0.05"
                                       class="form-control" />

                                <span asp-validation-for="TryOnOverlayVerticalOffset"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SPECIFICATIONS
                     ================================================= -->

                <div class="card mb-4">

                    <div class="card-body">

                        <h5 class="mb-1">
                            Specifications
                        </h5>

                        <p class="text-muted small mb-3">
                            Select and add specifications for this product.
                        </p>


                        <div id="specificationsContainer">

                            @if (Model.Specifications != null &&
                                 Model.Specifications.Any())
                            {
                                for (int i = 0;
                                     i < Model.Specifications.Count;
                                     i++)
                                {
                                    <div class="specification-row mb-2">

                                        <input type="hidden"
                                               name="Specifications[@i].Id"
                                               value="@Model.Specifications[i].Id" />

                                        <input type="hidden"
                                               name="Specifications[@i].SortOrder"
                                               value="@Model.Specifications[i].SortOrder"
                                               class="spec-sort-order" />


                                        <div class="row g-2 align-items-center">

                                            <div class="col-md-5">

                                                <input type="text"
                                                       name="Specifications[@i].Name"
                                                       value="@Model.Specifications[i].Name"
                                                       class="form-control"
                                                       placeholder="Specification name" />

                                            </div>


                                            <div class="col-md-5">

                                                <input type="text"
                                                       name="Specifications[@i].Value"
                                                       value="@Model.Specifications[i].Value"
                                                       class="form-control"
                                                       placeholder="Value" />

                                            </div>


                                            <div class="col-md-2">

                                                <button type="button"
                                                        class="btn btn-outline-danger remove-specification"
                                                        title="Remove Specification"
                                                        style="width:42px;height:42px;padding:0;display:flex;align-items:center;justify-content:center;">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </div>

                                        </div>

                                    </div>
                                }
                            }

                        </div>


                        <button type="button"
                                id="addSpecificationBtn"
                                class="btn btn-outline-primary mt-2">

                            <span>+</span>

                            Add Custom Specification

                        </button>

                    </div>

                </div>


                <!-- =================================================
                     ATTRIBUTES
                     ================================================= -->

                <div class="card mb-4">

