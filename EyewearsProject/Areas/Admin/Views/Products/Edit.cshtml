    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const container =
                    document.getElementById(
                        "specificationsContainer"
                    );

                const addButton =
                    document.getElementById(
                        "addSpecificationBtn"
                    );


                if (!container ||
                    !addButton) {

                    return;

                }


                /*
                 * REINDEX SPECIFICATIONS
                 */

                function updateSpecificationIndexes() {

                    const rows =
                        container.querySelectorAll(
                            ".specification-row"
                        );


                    rows.forEach(
                        function(row, index) {

                            row.querySelectorAll(
                                "input"
                            ).forEach(
                                function(input) {

                                    const name =
                                        input.getAttribute(
                                            "name"
                                        );


                                    if (!name)
                                        return;


                                    if (
                                        name.includes(
                                            ".Id"
                                        )
                                    ) {

                                        input.name =
                                            `Specifications[${index}].Id`;

                                    }
                                    else if (
                                        name.includes(
                                            ".Name"
                                        )
                                    ) {

                                        input.name =
                                            `Specifications[${index}].Name`;

                                    }
                                    else if (
                                        name.includes(
                                            ".Value"
                                        )
                                    ) {

                                        input.name =
                                            `Specifications[${index}].Value`;

                                    }
                                    else if (
                                        name.includes(
                                            ".SortOrder"
                                        )
                                    ) {

                                        input.name =
                                            `Specifications[${index}].SortOrder`;

                                        input.value =
                                            index;

                                    }

                                }
                            );

                        }
                    );

                }


                /*
                 * ADD SPECIFICATION
                 */

                addButton.addEventListener(
                    "click",
                    function() {

                        const index =
                            container.querySelectorAll(
                                ".specification-row"
                            ).length;


                        const row =
                            document.createElement(
                                "div"
                            );


                        row.className =
                            "specification-row mb-2";


                        row.innerHTML = `

