    <!-- =========================================================
         TAGS SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const tagsContainer =
                    document.getElementById(
                        "tagsContainer"
                    );

                const tagInput =
                    document.getElementById(
                        "tagInput"
                    );


                if (!tagsContainer ||
                    !tagInput) {

                    return;

                }


                /*
                 * ADD TAG
                 */

                tagInput.addEventListener(
                    "keydown",
                    function(event) {

                        if (event.key !== "Enter")
                            return;


                        event.preventDefault();


                        const tag =
                            tagInput.value.trim();


                        if (!tag)
                            return;


                        /*
                         * Prevent duplicates.
                         */

                        const existingTags =
                            Array.from(
                                tagsContainer.querySelectorAll(
                                    'input[name="Tags"]'
                                )
                            ).map(
                                function(input) {

                                    return input.value
                                        .trim()
                                        .toLowerCase();

                                }
                            );


                        if (
                            existingTags.includes(
                                tag.toLowerCase()
                            )
                        ) {

                            tagInput.value = "";

                            return;

                        }


                        const tagItem =
                            document.createElement(
                                "div"
                            );


                        tagItem.className =
                            "tag-item";


                        tagItem.innerHTML = `

                                    <input type="hidden"
                                           name="Tags"
                                           value="${escapeHtml(tag)}" />


                                    <span class="badge rounded-pill bg-light text-dark border">

                                        ${escapeHtml(tag)}


                                        <button type="button"
                                                class="btn-close ms-1 remove-tag"
                                                aria-label="Remove tag"
                                                style="font-size:8px;">

                                        </button>

                                    </span>

                                `;


                        tagsContainer.insertBefore(
                            tagItem,
                            tagInput
                        );


                        tagInput.value = "";


                        tagInput.focus();

                    }
                );


                /*
                 * REMOVE TAG
                 */

                tagsContainer.addEventListener(
                    "click",
                    function(event) {

                        const removeButton =
                            event.target.closest(
                                ".remove-tag"
                            );


                        if (!removeButton)
                            return;


                        const tagItem =
                            removeButton.closest(
                                ".tag-item"
                            );


                        if (tagItem)
                            tagItem.remove();

                    }
                );


                /*
                 * ESCAPE HTML
                 */

                function escapeHtml(
                    value
                ) {

                    const div =
                        document.createElement(
                            "div"
                        );


                    div.textContent =
                        value;


                    return div.innerHTML;

                }

            }
        );

    </script>

}