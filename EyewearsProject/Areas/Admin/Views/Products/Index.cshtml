@using EyewearsProject.Extensions
@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Products</h4>
    <a asp-action="Create" class="btn btn-dark">+ New Product</a>
</div>

<div class="table-responsive">
    <table class="table table-bordered bg-white align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Type</th>
                <th>Gender</th>
                <th>Material</th>
                <th>Shape</th>
                <th>Color</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <strong>@p.Name</strong>

                        @if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                        {
                            <div class="small text-muted">
                                @p.ShortDescription
                            </div>
                        }
                    </td>

                    <td>@p.Sku</td>

                    <td>@p.Category?.Name</td>

                    <td>@(p.Brand?.Name ?? "Unbranded")</td>

                    <td>@p.ProductType</td>

                    <td>@p.Gender</td>

                    <td>@p.Material</td>

                    <td>@p.Shape</td>

                    <td>@p.Color</td>

                    <td>
                        @if (p.DiscountPrice.HasValue &&
                             p.DiscountPrice.Value < p.Price)
                        {
                            <div>
                                <span class="text-decoration-line-through text-muted">
                                    @p.Price.ToPkr()
                                </span>
                            </div>

                            <strong class="text-danger">
                                @p.DiscountPrice.Value.ToPkr()
                            </strong>
                        }
                        else
                        {
                            @p.Price.ToPkr()
                        }
                    </td>

                    <td>
                        @if (p.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark mb-1">
                                Featured
                            </span>
                            <br />
                        }

                        @if (p.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }
                    </td>

                    <td>
                        <div class="d-flex flex-wrap gap-1">

                            <a asp-action="Edit"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Variants"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Variants
                            </a>

                            <a asp-action="Images"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Images
                            </a>

                            <a asp-action="Specifications"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Specs
                            </a>

                            <a asp-action="Attributes"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Attributes
                            </a>

                            <a asp-action="Tags"
                               asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Tags
                            </a>

                            <form asp-action="ToggleActive"
                                  asp-route-id="@p.Id"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    @(p.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>

                            <form asp-action="Delete"
                                  asp-route-id="@p.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this product?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>