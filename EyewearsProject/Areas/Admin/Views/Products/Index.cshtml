@using EyewearsProject.Extensions
@model List<EyewearsProject.Models.Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Products</h4>

    <a asp-action="Create"
       class="btn btn-dark">
        + New Product
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered bg-white align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Subcategory</th>
                <th>Brand</th>
                <th>Gender</th>
                <th>Material</th>
                <th>Shape</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <strong>@p.Name</strong>
                        </td>

                        <td>
                            @p.Sku
                        </td>

                        <td>
                            @(p.Category?.Name ?? "-")
                        </td>

                        <td>
                            @(p.SubCategory?.Name ?? "-")
                        </td>

                        <td>
                            @(p.Brand?.Name ?? "Unbranded")
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(p.Gender)
                                ? "-"
                                : p.Gender)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(p.Material)
                                ? "-"
                                : p.Material)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(p.Shape)
                                ? "-"
                                : p.Shape)
                        </td>

                        <td>
                            @if (p.DiscountPrice.HasValue &&
                                 p.DiscountPrice.Value < p.Price)
                            {
                                <div>
                                    <span class="text-decoration-line-through text-muted">
                                        @p.Price.ToPkr()
                                    </span>
                                </div>

                                <strong class="text-danger">
                                    @p.DiscountPrice.Value.ToPkr()
                                </strong>
                            }
                            else
                            {
                                @p.Price.ToPkr()
                            }
                        </td>

                        <td>
                            @if (p.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark mb-1">
                                    Featured
                                </span>

                                <br />
                            }

                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-1">

                                <!-- EDIT -->
                                <a asp-action="Edit"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <!-- VARIANTS -->
                                <a asp-action="Variants"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Variants
                                </a>

                                <!-- IMAGES -->
                                <a asp-action="Images"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Images
                                </a>

                                <!-- SPECIFICATIONS -->
                                <a asp-action="Specifications"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Specs
                                </a>

                                <!-- ATTRIBUTES -->
                                <a asp-action="Attributes"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Attributes
                                </a>

                                <!-- TAGS -->
                                <a asp-action="Tags"
                                   asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Tags
                                </a>

                                <!-- ACTIVATE / DEACTIVATE -->
                                <form asp-action="ToggleActive"
                                      asp-route-id="@p.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-warning">
                                        @(p.IsActive
                                            ? "Deactivate"
                                            : "Activate")
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11"
                        class="text-center text-muted py-4">
                        No products found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>