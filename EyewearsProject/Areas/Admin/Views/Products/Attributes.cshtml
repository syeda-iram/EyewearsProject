@model List<ProductAttribute>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Attributes — @ViewBag.ProductName</h4>

    <a asp-action="CreateAttribute"
       asp-route-productId="@ViewBag.ProductId"
       class="btn btn-dark">
        + Add Attribute
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered bg-white align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Value</th>
                <th>Order</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Value</td>
                    <td>@item.SortOrder</td>

                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="EditAttribute"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <form asp-action="DeleteAttribute"
                                  asp-route-id="@item.Id"
                                  asp-route-productId="@ViewBag.ProductId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this attribute?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">
        No attributes yet — e.g. Frame Width, Bridge Width, Temple Length.
    </p>
}

<a asp-action="Index"
   class="btn btn-outline-secondary mt-2">
    Back to Products
</a>