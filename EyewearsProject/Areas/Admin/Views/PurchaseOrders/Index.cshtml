@using EyewearsProject.Extensions
@model List<PurchaseOrder>

<div class="d-flex justify-content-between mb-3">
    <div>
        <h4>Purchase Orders @(ViewBag.VendorName != null ? $"— {ViewBag.VendorName}" : "")</h4>
    </div>
    <a asp-action="Create" asp-route-vendorId="@ViewBag.VendorId" class="btn btn-dark">+ New Purchase Order</a>
</div>

<table class="table table-bordered bg-white align-middle">
    <thead>
        <tr><th>PO #</th><th>Vendor</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var po in Model)
        {
            <tr>
                <td>@po.PoNumber</td>
                <td>@po.Vendor.CompanyName</td>
                <td>@po.OrderDate.ToString("dd MMM yyyy")</td>
                <td>
                    @{
                        var badge = po.Status switch
                        {
                            PurchaseOrderStatus.Received => "bg-success",
                            PurchaseOrderStatus.Cancelled => "bg-danger",
                            PurchaseOrderStatus.Shipped => "bg-info text-dark",
                            PurchaseOrderStatus.Acknowledged => "bg-warning text-dark",
                            PurchaseOrderStatus.Sent => "bg-primary",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badge">@po.Status</span>
                </td>
                <td>@po.TotalAmount.ToPkr()</td>
                <td><a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No purchase orders yet.</p>
}

<a asp-controller="Vendors" asp-action="Index" class="btn btn-outline-secondary">Back to Vendors</a>