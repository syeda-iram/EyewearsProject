<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | EyewearsProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" style="min-height:100vh;">
        <nav class="bg-dark text-white p-3" style="width:230px; min-width:230px; position:sticky; top:0; height:100vh; overflow-y:auto;">
            <h5 class="mb-4">Eyewear Admin</h5>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Roles" asp-action="Index">Roles</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("ProductManager"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Brands" asp-action="Index">Brands</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Inventory" asp-action="Index">Inventory</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("OrderManager"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Returns" asp-action="Index">Returns</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("MarketingManager"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Promotions" asp-action="Index">Promotions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Cms" asp-action="Index">CMS</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("CustomerSupport"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Reviews" asp-action="Index">Reviews</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("FinanceManager"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="Reports" asp-action="Index">Reports</a>
                    </li>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Audit Logs</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="flex-fill" style="min-width:0; overflow-x:auto;">
            <header class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
                <span>@ViewData["Title"]</span>
                <div class="d-flex align-items-center gap-3">
                    <a href="/" target="_blank" class="btn btn-sm btn-outline-primary">
                        View Live Site
                    </a>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0 d-flex align-items-center gap-2">
                        <span>@User.Identity?.Name</span>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                    </form>
                </div>
            </header>

            <main class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>