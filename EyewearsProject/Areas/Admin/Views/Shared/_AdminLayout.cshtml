@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    bool IsActive(string c) =>
        string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);

    var userName = User.Identity?.Name ?? "Admin User";

    var userInitial =
        !string.IsNullOrWhiteSpace(userName)
            ? userName.Substring(0, 1).ToUpper()
            : "A";

    var userRole =
        User.Claims.FirstOrDefault(c => c.Type.EndsWith("/role"))?.Value
        ?? User.Claims.FirstOrDefault(c => c.Type == "role")?.Value
        ?? "Staff";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] · EyeCraft Admin</title>


    <!-- ========================================================= -->
    <!-- FONTS -->
    <!-- ========================================================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap"
          rel="stylesheet" />


    <!-- ========================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ========================================================= -->
    <!-- BOOTSTRAP ICONS -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- ========================================================= -->
    <!-- ADMIN THEME -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="~/css/admin-theme.css"
          asp-append-version="true" />


    <!-- ========================================================= -->
    <!-- ADMIN LAYOUT FIXES -->
    <!-- ========================================================= -->

    <style>

            /* =========================================================
                       ROOT / BODY
                       ========================================================= */

            html,
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                overflow: hidden;
            }


            /* =========================================================
                       MAIN ADMIN SHELL
                       ========================================================= */

            .admin-shell {
                width: 100%;
                height: 100vh;
                min-height: 100vh;
                display: flex;
                flex-direction: row;
                overflow: hidden;
                position: relative;
            }


            /* =========================================================
                       SIDEBAR
                       ========================================================= */

            .admin-sidebar {
                width: 274px;
                min-width: 274px;
                height: 100vh;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                position: relative;
                z-index: 1000;
                overflow: hidden;
                flex-shrink: 0;
            }


            /* =========================================================
                       SIDEBAR BRAND
                       ========================================================= */

            .admin-brand {
                flex-shrink: 0;
            }


            /* =========================================================
                       SIDEBAR PROFILE
                       ========================================================= */

            .admin-profile-card {
                flex-shrink: 0;
            }


            /* =========================================================
                       SIDEBAR NAVIGATION

                       IMPORTANT:
                       Only this area scrolls.
                       Sidebar itself does NOT scroll.
                       ========================================================= */

            .admin-nav {
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                padding-top: 6px;
                padding-bottom: 10px;
                scrollbar-width: thin;
                scrollbar-color: #D6DAE0 transparent;
            }

                .admin-nav::-webkit-scrollbar {
                    width: 5px;
                }

                .admin-nav::-webkit-scrollbar-track {
                    background: transparent;
                }

                .admin-nav::-webkit-scrollbar-thumb {
                    background: #D6DAE0;
                    border-radius: 10px;
                }

                    .admin-nav::-webkit-scrollbar-thumb:hover {
                        background: #BCC2CA;
                    }


            /* =========================================================
                       NAV LINKS
                       ========================================================= */

            .admin-nav-link {
                flex-shrink: 0;
            }


            /* =========================================================
                       SIDEBAR LOGOUT

                       Always remains at bottom.
                       ========================================================= */

            .admin-sidebar > form {
                flex: 0 0 auto;
                margin-top: 0 !important;
                padding: 10px 16px 16px;
                border-top: 1px solid var(--admin-border, #ECEEF1);
                background: var(--admin-card, #FFFFFF);
            }


            /* =========================================================
                       MAIN AREA
                       ========================================================= */

            .admin-shell > .flex-grow-1 {
                min-width: 0;
                min-height: 0;
                height: 100vh;
                display: flex !important;
                flex-direction: column;
                overflow: hidden;
            }


            /* =========================================================
                       TOPBAR
                       ========================================================= */

            .admin-topbar {
                flex: 0 0 auto;
                position: sticky;
                top: 0;
                z-index: 900;
                min-height: 72px;
            }


            /* =========================================================
                       MAIN CONTENT

                       This is the ONLY page-level scroll area.
                       ========================================================= */

            .admin-content {
                flex: 1 1 auto;
                min-width: 0;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 22px 28px 32px;
                scrollbar-width: thin;
                scrollbar-color: #D6DAE0 transparent;
            }

                .admin-content::-webkit-scrollbar {
                    width: 7px;
                }

                .admin-content::-webkit-scrollbar-track {
                    background: transparent;
                }

                .admin-content::-webkit-scrollbar-thumb {
                    background: #D6DAE0;
                    border-radius: 10px;
                }

                    .admin-content::-webkit-scrollbar-thumb:hover {
                        background: #BCC2CA;
                    }


                /* =========================================================
                       REMOVE UNNECESSARY TOP SPACING FROM FIRST CONTENT
                       ========================================================= */

                .admin-content > :first-child {
                    margin-top: 0 !important;
                }


                /* =========================================================
                       DASHBOARD PAGE HEADER

                       Keeps dashboard content close to topbar.
                       ========================================================= */

                .admin-content .page-header {
                    margin-top: 0 !important;
                }


            /* =========================================================
                       MOBILE MENU BUTTON
                       ========================================================= */

            .admin-menu-btn {
                display: none;
            }


            /* =========================================================
                       MOBILE SIDEBAR BACKDROP
                       ========================================================= */

            .admin-sidebar-backdrop {
                display: none;
            }


            /* =========================================================
                       DESKTOP
                       ========================================================= */

            @@media (min-width: 992px) {

                .admin-sidebar {
                    position: relative;
                }

                .admin-content {
                    padding-left: 28px;
                    padding-right: 28px;
                }
            }


            /* =========================================================
                       TABLET / MOBILE
                       ========================================================= */

            @@media (max-width: 991.98px) {

                body {
                    overflow: hidden;
                }

                .admin-shell {
                    height: 100vh;
                    min-height: 100vh;
                }
                /* -----------------------------------------------------
                           Sidebar becomes overlay
                           ----------------------------------------------------- */

                .admin-sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 274px;
                    min-width: 274px;
                    height: 100vh;
                    min-height: 100vh;
                    transform: translateX(-100%);
                    transition: transform .2s ease;
                    box-shadow: 10px 0 30px rgba(20, 24, 29, .12);
                }

                    .admin-sidebar.open {
                        transform: translateX(0);
                    }
                /* -----------------------------------------------------
                           Backdrop
                           ----------------------------------------------------- */

                .admin-sidebar-backdrop {
                    position: fixed;
                    inset: 0;
                    z-index: 999;
                    background: rgba(20, 24, 29, .28);
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity .2s ease, visibility .2s ease;
                    display: block;
                }

                    .admin-sidebar-backdrop.show {
                        opacity: 1;
                        visibility: visible;
                    }
                /* -----------------------------------------------------
                           Main area
                           ----------------------------------------------------- */

                .admin-shell > .flex-grow-1 {
                    width: 100%;
                    min-width: 0;
                }
                /* -----------------------------------------------------
                           Mobile menu button
                           ----------------------------------------------------- */

                .admin-menu-btn {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 36px;
                    height: 36px;
                    flex-shrink: 0;
                }
                /* -----------------------------------------------------
                           Content
                           ----------------------------------------------------- */

                .admin-content {
                    padding: 18px 18px 28px;
                }
            }


            /* =========================================================
                       SMALL MOBILE
                       ========================================================= */

            @@media (max-width: 575.98px) {

                .admin-topbar {
                    min-height: 64px;
                }

                .admin-content {
                    padding: 16px 14px 24px;
                }

                .admin-sidebar {
                    width: 270px;
                    min-width: 270px;
                }
            }


            /* =========================================================
                       REDUCED MOTION
                       ========================================================= */

            @@media (prefers-reduced-motion: reduce) {

                .admin-sidebar,
                .admin-sidebar-backdrop {
                    transition: none;
                }
            }

    </style>

</head>


<body>


    <!-- ========================================================= -->
    <!-- ADMIN SHELL -->
    <!-- ========================================================= -->

    <div class="admin-shell">


        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="admin-sidebar"
               id="adminSidebar">


            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <div class="admin-brand">

                <div class="admin-brand-icon">
                    <i class="bi bi-eye-fill"></i>
                </div>

                <span class="admin-brand-name">
                    EyeCraft Admin
                </span>

            </div>


            <!-- ================================================= -->
            <!-- PROFILE -->
            <!-- ================================================= -->

            <div class="admin-profile-card">

                <div class="admin-profile-avatar">
                    @userInitial
                </div>

                <div style="min-width:0; overflow:hidden;">

                    <div class="admin-profile-name text-truncate"
                         title="@userName">

                        @userName

                    </div>

                    <div class="admin-profile-role">
                        @userRole
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION

This section scrolls independently.
                 ================================================= -->

            <nav class="admin-nav">


                <!-- Dashboard -->

                <a class="admin-nav-link @(IsActive("Dashboard") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- User Management -->

                <a class="admin-nav-link @(IsActive("Users") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        User Management
                    </span>

                </a>


                <!-- Role Permissions -->

                <a class="admin-nav-link @(IsActive("Roles") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Roles"
                   asp-action="Index">

                    <i class="bi bi-shield-lock-fill"></i>

                    <span>
                        Role Permissions
                    </span>

                </a>


                <!-- Products -->

                <a class="admin-nav-link @(IsActive("Products") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index">

                    <i class="bi bi-box-seam-fill"></i>

                    <span>
                        Products
                    </span>

                </a>


                <!-- Categories -->

                <a class="admin-nav-link @(IsActive("Categories") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index">

                    <i class="bi bi-grid-3x3-gap-fill"></i>

                    <span>
                        Categories
                    </span>

                </a>


                <!-- Brands -->

                <a class="admin-nav-link @(IsActive("Brands") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Brands"
                   asp-action="Index">

                    <i class="bi bi-tags-fill"></i>

                    <span>
                        Brands
                    </span>

                </a>


                <!-- Inventory -->

                <a class="admin-nav-link @(IsActive("Inventory") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Inventory"
                   asp-action="Index">

                    <i class="bi bi-boxes"></i>

                    <span>
                        Inventory
                    </span>

                </a>


                <!-- Orders -->

                <a class="admin-nav-link @(IsActive("Orders") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Index">

                    <i class="bi bi-cart3"></i>

                    <span>
                        Orders
                    </span>

                </a>


                <!-- Returns -->

                <a class="admin-nav-link @(IsActive("Returns") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Returns"
                   asp-action="Index">

                    <i class="bi bi-arrow-return-left"></i>

                    <span>
                        Returns
                    </span>

                </a>


                <!-- Promotions -->

                <a class="admin-nav-link @(IsActive("Promotions") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Promotions"
                   asp-action="Index">

                    <i class="bi bi-percent"></i>

                    <span>
                        Promotions
                    </span>

                </a>


                <!-- Reviews -->

                <a class="admin-nav-link @(IsActive("Reviews") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Reviews"
                   asp-action="Index">

                    <i class="bi bi-star-fill"></i>

                    <span>
                        Reviews
                    </span>

                </a>


                <!-- Vendors -->

                <a class="admin-nav-link @(IsActive("Vendors") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Vendors"
                   asp-action="Index">

                    <i class="bi bi-truck"></i>

                    <span>
                        Vendors
                    </span>

                </a>


                <!-- Purchase Orders -->

                <a class="admin-nav-link @(IsActive("PurchaseOrders") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="PurchaseOrders"
                   asp-action="Index">

                    <i class="bi bi-receipt"></i>

                    <span>
                        Purchase Orders
                    </span>

                </a>


                <!-- CMS -->

                <a class="admin-nav-link @(IsActive("Cms") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Cms"
                   asp-action="Index">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <span>
                        CMS
                    </span>

                </a>


                <!-- Audit Logs -->

                <a class="admin-nav-link @(IsActive("AuditLogs") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="AuditLogs"
                   asp-action="Index">

                    <i class="bi bi-journal-check"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                <!-- Reports -->

                <a class="admin-nav-link @(IsActive("Reports") ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Reports"
                   asp-action="Index">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>

            </nav>


            <!-- ================================================= -->
            <!-- LOGOUT

This stays at the bottom of sidebar.
                 ================================================= -->

            <form asp-area="Admin"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-secondary btn-sm w-100">

                    <i class="bi bi-box-arrow-right me-1"></i>

                    Logout

                </button>

            </form>

        </aside>


        <!-- ===================================================== -->
        <!-- MOBILE SIDEBAR BACKDROP -->
        <!-- ===================================================== -->

        <div class="admin-sidebar-backdrop"
             id="adminSidebarBackdrop">
        </div>


        <!-- ===================================================== -->
        <!-- MAIN AREA -->
        <!-- ===================================================== -->

        <div class="flex-grow-1 d-flex flex-column">


            <!-- ================================================= -->
            <!-- TOPBAR -->
            <!-- ================================================= -->

            <header class="admin-topbar">


                <!-- Mobile Sidebar Button -->

                <button type="button"
                        class="btn btn-sm btn-outline-secondary admin-menu-btn"
                        id="adminMenuButton"
                        aria-label="Toggle navigation"
                        aria-controls="adminSidebar"
                        aria-expanded="false">

                    <i class="bi bi-list"></i>

                </button>


                <!-- Search -->

                <div class="admin-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           placeholder="Search users, roles..."
                           autocomplete="off" />

                </div>


                <!-- Topbar Icons -->

                <div class="admin-topbar-icons">


                    <!-- Notifications -->

                    <button type="button"
                            class="admin-icon-btn"
                            title="Notifications"
                            aria-label="Notifications">

                        <i class="bi bi-bell"></i>

                        <span class="dot"></span>

                    </button>


                    <!-- Help -->

                    <button type="button"
                            class="admin-icon-btn"
                            title="Help"
                            aria-label="Help">

                        <i class="bi bi-question-circle"></i>

                    </button>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- CONTENT

Main page scroll happens here only.
                 ================================================= -->

            <main class="admin-content">

                @RenderBody()

            </main>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SCRIPTS -->
    <!-- ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ========================================================= -->
    <!-- SIDEBAR BEHAVIOR -->
    <!-- ========================================================= -->

    <script>

            (function() {

                const sidebar =
                    document.getElementById('adminSidebar');

                const menuButton =
                    document.getElementById('adminMenuButton');

                const backdrop =
                    document.getElementById('adminSidebarBackdrop');


                if (!sidebar || !menuButton || !backdrop) {
                    return;
                }


                function openSidebar() {

                    sidebar.classList.add('open');

                    backdrop.classList.add('show');

                    menuButton.setAttribute(
                        'aria-expanded',
                        'true'
                    );

                    document.body.style.overflow = 'hidden';
                }


                function closeSidebar() {

                    sidebar.classList.remove('open');

                    backdrop.classList.remove('show');

                    menuButton.setAttribute(
                        'aria-expanded',
                        'false'
                    );

                    document.body.style.overflow = '';
                }


                menuButton.addEventListener(
                    'click',
                    function() {

                        if (sidebar.classList.contains('open')) {
                            closeSidebar();
                        }
                        else {
                            openSidebar();
                        }

                    }
                );


                backdrop.addEventListener(
                    'click',
                    closeSidebar
                );


                sidebar
                    .querySelectorAll('.admin-nav-link')
                    .forEach(function(link) {

                        link.addEventListener(
                            'click',
                            function() {

                                if (
                                    window.innerWidth <= 991.98
                                ) {
                                    closeSidebar();
                                }

                            }
                        );

                    });


                window.addEventListener(
                    'resize',
                    function() {

                        if (window.innerWidth > 991.98) {
                            closeSidebar();
                        }

                    }
                );


                document.addEventListener(
                    'keydown',
                    function(event) {

                        if (event.key === 'Escape') {
                            closeSidebar();
                        }

                    }
                );

            })();

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>