@model List<AuditLog>

<div class="mb-4">
    <h3 class="mb-1">Audit Logs</h3>
    <p class="text-muted mb-0">Recent admin actions (most recent 200).</p>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" class="form-control" placeholder="Search by admin email or details..." value="@ViewBag.CurrentSearch" />
        </div>
        <div class="col-md-4">
            <select name="entityType" class="form-select" onchange="this.form.submit()">
                <option value="">All Entity Types</option>
                @foreach (var t in (List<string>)ViewBag.EntityTypes)
                {
                    <option value="@t" selected="@(t == (string)ViewBag.CurrentEntityType)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary w-100">Go</button>
        </div>
    </form>
</div>

<table class="table table-bordered bg-white align-middle">
    <thead>
        <tr>
            <th>When</th>
            <th>Admin</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                <td>@log.UserEmail</td>
                <td>
                    @{
                        var badgeClass = log.Action switch
                        {
                            "Create" => "bg-success",
                            "Delete" => "bg-danger",
                            "Deactivate" => "bg-warning text-dark",
                            "Activate" => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@log.Action</span>
                </td>
                <td>@log.EntityType @(log.EntityId != null ? $"#{log.EntityId}" : "")</td>
                <td>@log.Details</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No audit log entries yet.</p>
}