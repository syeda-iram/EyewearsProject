@model List<Brand>
<div class="d-flex justify-content-between mb-3">
    <h4>Brands</h4>
    <a asp-action="Create" class="btn btn-dark">+ New Brand</a>
</div>
<table class="table table-bordered bg-white">
    <thead><tr><th>Name</th><th>Logo URL</th><th></th></tr></thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Name</td>
                <td>@b.LogoUrl</td>
                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Delete this brand?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>