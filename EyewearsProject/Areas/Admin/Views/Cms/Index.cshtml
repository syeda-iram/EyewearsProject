@model List<CmsContent>

<div class="d-flex justify-content-between mb-3">
    <div>
        <h4 class="mb-1">CMS</h4>
        <p class="text-muted mb-0">Manage pages and banners.</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">+ New Content</a>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="type" class="form-select" onchange="this.form.submit()">
                <option value="">All Types</option>
                <option value="Page" selected="@("Page" == (string)ViewBag.CurrentType)">Pages</option>
                <option value="Banner" selected="@("Banner" == (string)ViewBag.CurrentType)">Banners</option>
            </select>
        </div>
    </form>
</div>

<table class="table table-bordered bg-white align-middle">
    <thead>
        <tr>
            <th>Type</th>
            <th>Title</th>
            <th>Slug</th>
            <th>Order</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td><span class="badge bg-secondary">@c.Type</span></td>
                <td>@c.Title</td>
                <td>@c.Slug</td>
                <td>@c.SortOrder</td>
                <td>
                    @if (c.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {

                        <span class="badge bg-warning text-dark">Inactive</span>
                    }
                </td>
                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@c.Id" method="post">
                        <button class="btn btn-sm btn-outline-warning">@(c.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this content?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No CMS content yet.</p>
}