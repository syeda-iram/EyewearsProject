<h3 class="mb-1">Welcome, @ViewBag.VendorName</h3>
<p class="text-muted mb-4">Here's a summary of your account.</p>

<div class="row g-3">
    <div class="col-md-4"><div class="card p-3"><small class="text-muted">Total Purchase Orders</small><h3>@ViewBag.TotalPOs</h3></div></div>
    <div class="col-md-4"><div class="card p-3"><small class="text-muted">Open Purchase Orders</small><h3>@ViewBag.PendingPOs</h3></div></div>
    <div class="col-md-4"><div class="card p-3"><small class="text-muted">Unpaid Invoices</small><h3>@ViewBag.UnpaidInvoices</h3></div></div>
</div>