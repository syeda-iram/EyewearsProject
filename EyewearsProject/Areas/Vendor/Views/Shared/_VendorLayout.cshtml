<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vendor Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" style="min-height:100vh;">
        <nav class="bg-dark text-white p-3" style="width:220px; min-width:220px; position:sticky; top:0; height:100vh;">
            <h5 class="mb-4">Vendor Portal</h5>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Vendor" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Vendor" asp-controller="PurchaseOrders" asp-action="Index">Purchase Orders</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Vendor" asp-controller="Invoices" asp-action="Index">Invoices</a>
                </li>
            </ul>
        </nav>

        <div class="flex-fill" style="min-width:0; overflow-x:auto;">
            <header class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
                <span>@ViewData["Title"]</span>
                <form asp-area="Vendor" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <span class="me-2">@User.Identity?.Name</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                </form>
            </header>
            <main class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>