@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    bool IsActive(string controller) =>
        string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase
        );

    var userName =
        User.Identity?.Name ?? "Vendor";

    var userInitial =
        !string.IsNullOrWhiteSpace(userName)
            ? userName.Substring(0, 1).ToUpper()
            : "V";

    var pageTitle =
        ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @pageTitle · EyeCraft Vendor Portal
    </title>


    <!-- ========================================================= -->
    <!-- FONTS -->
    <!-- ========================================================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />


    <!-- ========================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ========================================================= -->
    <!-- BOOTSTRAP ICONS -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- ========================================================= -->
    <!-- SITE CSS -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- ========================================================= -->
    <!-- VENDOR PORTAL THEME -->
    <!-- ========================================================= -->

    <style>

            :root {
                --vendor-navy: #14213D;
                --vendor-navy-hover: #1D2E52;
                --vendor-cream: #F7F2E9;
                --vendor-cream-dark: #F0EAE0;
                --vendor-white: #FFFFFF;
                --vendor-text: #2B2B2B;
                --vendor-muted: #6B6B70;
                --vendor-border: #E5E0D7;
                --vendor-success: #3E7A5E;
                --vendor-shadow: 0 4px 20px rgba(20, 33, 61, .07);
                --vendor-radius: 14px;
            }


            /* =========================================================
                       ROOT
                       ========================================================= */

            html,
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: "Inter", sans-serif;
                color: var(--vendor-text);
                background: #F8F9FA;
                overflow: hidden;
            }


            /* =========================================================
                       MAIN SHELL
                       ========================================================= */

            .vendor-shell {
                width: 100%;
                height: 100vh;
                display: flex;
                overflow: hidden;
            }


            /* =========================================================
                       SIDEBAR
                       ========================================================= */

            .vendor-sidebar {
                width: 250px;
                min-width: 250px;
                height: 100vh;
                display: flex;
                flex-direction: column;
                background: var(--vendor-navy);
                color: white;
                position: relative;
                z-index: 1000;
                overflow: hidden;
                flex-shrink: 0;
            }


            /* =========================================================
                       BRAND
                       ========================================================= */

            .vendor-brand {
                height: 82px;
                display: flex;
                align-items: center;
                padding: 0 22px;
                border-bottom: 1px solid rgba(255,255,255,.08);
                flex-shrink: 0;
            }

            .vendor-brand-icon {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                background: rgba(255,255,255,.1);
                margin-right: 12px;
                font-size: 18px;
            }

            .vendor-brand-text {
                min-width: 0;
            }

            .vendor-brand-name {
                display: block;
                font-size: 17px;
                font-weight: 700;
                line-height: 1.2;
            }

            .vendor-brand-subtitle {
                display: block;
                margin-top: 3px;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: .7px;
                text-transform: uppercase;
                color: rgba(255,255,255,.55);
            }


            /* =========================================================
                       VENDOR PROFILE
                       ========================================================= */

            .vendor-profile {
                margin: 18px 14px 14px;
                padding: 13px;
                display: flex;
                align-items: center;
                border-radius: 12px;
                background: rgba(255,255,255,.07);
                flex-shrink: 0;
            }

            .vendor-avatar {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: var(--vendor-cream);
                color: var(--vendor-navy);
                font-size: 15px;
                font-weight: 700;
                flex-shrink: 0;
                margin-right: 11px;
            }

            .vendor-profile-info {
                min-width: 0;
            }

            .vendor-profile-name {
                color: white;
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .vendor-profile-role {
                margin-top: 3px;
                color: rgba(255,255,255,.55);
                font-size: 11px;
            }


            /* =========================================================
                       NAVIGATION
                       ========================================================= */

            .vendor-nav {
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 4px 12px 15px;
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.2) transparent;
            }

                .vendor-nav::-webkit-scrollbar {
                    width: 5px;
                }

                .vendor-nav::-webkit-scrollbar-track {
                    background: transparent;
                }

                .vendor-nav::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.18);
                    border-radius: 10px;
                }


            /* =========================================================
                       NAV SECTION
                       ========================================================= */

            .vendor-nav-label {
                padding: 13px 11px 7px;
                color: rgba(255,255,255,.4);
                font-size: 9px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
            }


            /* =========================================================
                       NAV LINKS
                       ========================================================= */

            .vendor-nav-link {
                min-height: 46px;
                display: flex;
                align-items: center;
                padding: 0 12px;
                margin: 3px 0;
                border-radius: 10px;
                color: rgba(255,255,255,.7);
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: background .18s ease, color .18s ease, transform .18s ease;
            }

                .vendor-nav-link i {
                    width: 22px;
                    margin-right: 10px;
                    font-size: 16px;
                    text-align: center;
                    opacity: .85;
                }

                .vendor-nav-link:hover {
                    color: white;
                    background: rgba(255,255,255,.08);
                    transform: translateX(2px);
                }

                .vendor-nav-link.active {
                    color: var(--vendor-navy);
                    background: var(--vendor-cream);
                    font-weight: 600;
                    box-shadow: 0 3px 10px rgba(0,0,0,.08);
                }

                    .vendor-nav-link.active i {
                        opacity: 1;
                    }


            /* =========================================================
                       SIDEBAR FOOTER
                       ========================================================= */

            .vendor-sidebar-footer {
                padding: 13px 14px 16px;
                border-top: 1px solid rgba(255,255,255,.08);
                flex-shrink: 0;
            }

            .vendor-logout {
                width: 100%;
                min-height: 42px;
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 9px;
                background: transparent;
                color: rgba(255,255,255,.72);
                font-size: 12px;
                font-weight: 500;
                transition: all .18s ease;
            }

                .vendor-logout:hover {
                    background: rgba(255,255,255,.08);
                    color: white;
                    border-color: rgba(255,255,255,.25);
                }


            /* =========================================================
                       MAIN AREA
                       ========================================================= */

            .vendor-main {
                min-width: 0;
                min-height: 0;
                height: 100vh;
                flex: 1 1 auto;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }


            /* =========================================================
                       TOPBAR
                       ========================================================= */

            .vendor-topbar {
                min-height: 72px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                background: white;
                border-bottom: 1px solid var(--vendor-border);
                flex-shrink: 0;
                z-index: 900;
            }


            /* =========================================================
                       TOPBAR LEFT
                       ========================================================= */

            .vendor-topbar-left {
                display: flex;
                align-items: center;
                min-width: 0;
            }

            .vendor-menu-btn {
                display: none;
                width: 36px;
                height: 36px;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
                border: 1px solid var(--vendor-border);
                border-radius: 8px;
                background: white;
                color: var(--vendor-navy);
            }

            .vendor-page-title {
                font-size: 15px;
                font-weight: 600;
                color: var(--vendor-navy);
            }

            .vendor-page-subtitle {
                margin-left: 12px;
                padding-left: 12px;
                border-left: 1px solid var(--vendor-border);
                color: var(--vendor-muted);
                font-size: 12px;
            }


            /* =========================================================
                       TOPBAR RIGHT
                       ========================================================= */

            .vendor-topbar-right {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .vendor-site-btn {
                display: inline-flex;
                align-items: center;
                min-height: 38px;
                padding: 0 13px;
                border: 1px solid var(--vendor-border);
                border-radius: 8px;
                background: white;
                color: var(--vendor-navy);
                text-decoration: none;
                font-size: 12px;
                font-weight: 600;
                transition: all .18s ease;
            }

                .vendor-site-btn:hover {
                    background: var(--vendor-cream);
                    border-color: var(--vendor-cream-dark);
                    color: var(--vendor-navy);
                }

            .vendor-user-name {
                max-width: 220px;
                color: var(--vendor-text);
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }


            /* =========================================================
                       CONTENT
                       ========================================================= */

            .vendor-content {
                flex: 1 1 auto;
                min-width: 0;
                min-height: 0;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 28px;
                scrollbar-width: thin;
                scrollbar-color: #D6DAE0 transparent;
            }

                .vendor-content::-webkit-scrollbar {
                    width: 7px;
                }

                .vendor-content::-webkit-scrollbar-track {
                    background: transparent;
                }

                .vendor-content::-webkit-scrollbar-thumb {
                    background: #D6DAE0;
                    border-radius: 10px;
                }

                    .vendor-content::-webkit-scrollbar-thumb:hover {
                        background: #BCC2CA;
                    }


            /* =========================================================
                       PAGE HEADER HELPER
                       ========================================================= */

            .vendor-welcome {
                margin-bottom: 25px;
            }

                .vendor-welcome h1 {
                    margin: 0;
                    color: var(--vendor-navy);
                    font-size: 25px;
                    font-weight: 700;
                    letter-spacing: -.4px;
                }

                .vendor-welcome p {
                    margin: 6px 0 0;
                    color: var(--vendor-muted);
                    font-size: 13px;
                }


            /* =========================================================
                       ALERT
                       ========================================================= */

            .vendor-content .alert {
                border-radius: 10px;
                border: 1px solid transparent;
                font-size: 13px;
            }


            /* =========================================================
                       MOBILE BACKDROP
                       ========================================================= */

            .vendor-sidebar-backdrop {
                display: none;
            }


            /* =========================================================
                       TABLET / MOBILE
                       ========================================================= */

            @@media (max-width: 991.98px) {

                .vendor-sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 250px;
                    min-width: 250px;
                    transform: translateX(-100%);
                    transition: transform .2s ease;
                    box-shadow: 10px 0 30px rgba(20,24,29,.18);
                }

                    .vendor-sidebar.open {
                        transform: translateX(0);
                    }

                .vendor-sidebar-backdrop {
                    display: block;
                    position: fixed;
                    inset: 0;
                    z-index: 999;
                    background: rgba(20,24,29,.35);
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity .2s ease, visibility .2s ease;
                }

                    .vendor-sidebar-backdrop.show {
                        opacity: 1;
                        visibility: visible;
                    }

                .vendor-menu-btn {
                    display: inline-flex;
                }

                .vendor-topbar {
                    padding: 0 18px;
                }

                .vendor-page-subtitle {
                    display: none;
                }

                .vendor-site-btn {
                    display: none;
                }

                .vendor-content {
                    padding: 20px 18px 28px;
                }
            }


            /* =========================================================
                       SMALL MOBILE
                       ========================================================= */

            @@media (max-width: 575.98px) {

                .vendor-topbar {
                    min-height: 64px;
                    padding: 0 14px;
                }

                .vendor-content {
                    padding: 18px 14px 24px;
                }

                .vendor-user-name {
                    max-width: 140px;
                }

                .vendor-welcome h1 {
                    font-size: 22px;
                }
            }


            /* =========================================================
                       REDUCED MOTION
                       ========================================================= */

            @@media (prefers-reduced-motion: reduce) {

                .vendor-sidebar,
                .vendor-sidebar-backdrop,
                .vendor-nav-link,
                .vendor-site-btn,
                .vendor-logout {
                    transition: none;
                }
            }

    </style>

</head>


<body>


    <!-- ========================================================= -->
    <!-- VENDOR SHELL -->
    <!-- ========================================================= -->

    <div class="vendor-shell">


        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="vendor-sidebar"
               id="vendorSidebar">


            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <div class="vendor-brand">

                <div class="vendor-brand-icon">
                    <i class="bi bi-eye-fill"></i>
                </div>

                <div class="vendor-brand-text">

                    <span class="vendor-brand-name">
                        EyeCraft
                    </span>

                    <span class="vendor-brand-subtitle">
                        Vendor Portal
                    </span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- PROFILE -->
            <!-- ================================================= -->

            <div class="vendor-profile">

                <div class="vendor-avatar">
                    @userInitial
                </div>

                <div class="vendor-profile-info">

                    <div class="vendor-profile-name"
                         title="@userName">

                        @userName

                    </div>

                    <div class="vendor-profile-role">
                        Vendor Account
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <nav class="vendor-nav">


                <div class="vendor-nav-label">
                    Overview
                </div>


                <!-- Dashboard -->

                <a class="vendor-nav-link @(IsActive("Dashboard") ? "active" : "")"
                   asp-area="Vendor"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <div class="vendor-nav-label">
                    Procurement
                </div>


                <!-- Purchase Orders -->

                <a class="vendor-nav-link @(IsActive("PurchaseOrders") ? "active" : "")"
                   asp-area="Vendor"
                   asp-controller="PurchaseOrders"
                   asp-action="Index">

                    <i class="bi bi-receipt"></i>

                    <span>
                        Purchase Orders
                    </span>

                </a>


                <!-- Invoices -->

                <a class="vendor-nav-link @(IsActive("Invoices") ? "active" : "")"
                   asp-area="Vendor"
                   asp-controller="Invoices"
                   asp-action="Index">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <span>
                        Invoices
                    </span>

                </a>

            </nav>


            <!-- ================================================= -->
            <!-- SIDEBAR FOOTER -->
            <!-- ================================================= -->

            <div class="vendor-sidebar-footer">

                <form asp-area="Vendor"
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    <button type="submit"
                            class="vendor-logout">

                        <i class="bi bi-box-arrow-right me-2"></i>

                        Logout

                    </button>

                </form>

            </div>

        </aside>


        <!-- ===================================================== -->
        <!-- SIDEBAR BACKDROP -->
        <!-- ===================================================== -->

        <div class="vendor-sidebar-backdrop"
             id="vendorSidebarBackdrop">
        </div>


        <!-- ===================================================== -->
        <!-- MAIN AREA -->
        <!-- ===================================================== -->

        <div class="vendor-main">


            <!-- ================================================= -->
            <!-- TOPBAR -->
            <!-- ================================================= -->

            <header class="vendor-topbar">


                <div class="vendor-topbar-left">


                    <!-- Mobile menu -->

                    <button type="button"
                            class="vendor-menu-btn"
                            id="vendorMenuButton"
                            aria-label="Toggle navigation"
                            aria-controls="vendorSidebar"
                            aria-expanded="false">

                        <i class="bi bi-list"></i>

                    </button>


                    <!-- Page title -->

                    <span class="vendor-page-title">

                        @pageTitle

                    </span>


                    <span class="vendor-page-subtitle">
                        EyeCraft Vendor Portal
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- TOPBAR RIGHT -->
                <!-- ================================================= -->

                <div class="vendor-topbar-right">


                    <!-- View website -->

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="vendor-site-btn">

                        <i class="bi bi-globe me-2"></i>

                        View Live Site

                    </a>


                    <!-- Vendor name -->

                    <span class="vendor-user-name"
                          title="@userName">

                        @userName

                    </span>


                    <!-- Small avatar -->

                    <div class="vendor-avatar"
                         style="width:34px;height:34px;font-size:12px;margin:0;">

                        @userInitial

                    </div>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <main class="vendor-content">


                @if (TempData["Success"] != null)
                {

                    <div class="alert alert-success d-flex align-items-center mb-4">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        <span>
                            @TempData["Success"]
                        </span>

                    </div>

                }


                @RenderBody()

            </main>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SCRIPTS -->
    <!-- ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ========================================================= -->
    <!-- MOBILE SIDEBAR -->
    <!-- ========================================================= -->

    <script>

            (function() {

                const sidebar =
                    document.getElementById("vendorSidebar");

                const menuButton =
                    document.getElementById("vendorMenuButton");

                const backdrop =
                    document.getElementById("vendorSidebarBackdrop");


                if (!sidebar || !menuButton || !backdrop) {
                    return;
                }


                function openSidebar() {

                    sidebar.classList.add("open");

                    backdrop.classList.add("show");

                    menuButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    document.body.style.overflow = "hidden";
                }


                function closeSidebar() {

                    sidebar.classList.remove("open");

                    backdrop.classList.remove("show");

                    menuButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    document.body.style.overflow = "";
                }


                menuButton.addEventListener(
                    "click",
                    function() {

                        if (sidebar.classList.contains("open")) {

                            closeSidebar();

                        } else {

                            openSidebar();

                        }

                    }
                );


                backdrop.addEventListener(
                    "click",
                    closeSidebar
                );


                sidebar
                    .querySelectorAll(".vendor-nav-link")
                    .forEach(function(link) {

                        link.addEventListener(
                            "click",
                            function() {

                                if (window.innerWidth <= 991.98) {

                                    closeSidebar();

                                }

                            }
                        );

                    });


                window.addEventListener(
                    "resize",
                    function() {

                        if (window.innerWidth > 991.98) {

                            closeSidebar();

                        }

                    }
                );


                document.addEventListener(
                    "keydown",
                    function(event) {

                        if (event.key === "Escape") {

                            closeSidebar();

                        }

                    }
                );

            })();

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>